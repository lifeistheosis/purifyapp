diff --git a/lib/downloads/__tests__/log.test.ts b/lib/downloads/__tests__/log.test.ts
new file mode 100644
index 00000000..4b15e2f4
--- /dev/null
+++ b/lib/downloads/__tests__/log.test.ts
@@ -0,0 +1,82 @@
+// The downloads kept on the phone for the bell's sheet (1.9, build 95 note 23):
+// newest first, changed where they stand, the last eight and an ended one a
+// week, a download let go not kept, and an end unseen lighting the bell until
+// the sheet is opened.
+
+import { beforeEach, describe, expect, it } from "vitest";
+
+const store = new Map<string, string>();
+Object.assign(globalThis, {
+  window: {
+    localStorage: {
+      getItem: (k: string) => store.get(k) ?? null,
+      setItem: (k: string, v: string) => void store.set(k, v),
+      removeItem: (k: string) => void store.delete(k),
+    },
+    addEventListener: () => {},
+    removeEventListener: () => {},
+  },
+});
+
+const { putDownload, dropDownload, readDownloads, hasUnseenEnd, markDownloadsSeen, keep, KEPT, KEPT_MS, resetDownloadsForTests } = await import("@/lib/downloads/log");
+type Download = import("@/lib/downloads/log").Download;
+
+const at = "2026-11-13T10:00:00.000Z";
+const bible = (over: Partial<Download> = {}): Download => ({ key: "bible:ru-synodal", kind: "bible", name: "Синодальный перевод (1876)", state: "running", share: 0.4, done: 0, total: 0, at, ...over });
+
+beforeEach(() => {
+  store.clear();
+  resetDownloadsForTests();
+});
+
+describe("the downloads kept on the phone", () => {
+  it("keeps a new one at the top and changes one already kept where it stands", () => {
+    putDownload(bible());
+    putDownload({ ...bible(), key: "book:luke", kind: "book", name: "Luke", done: 3, total: 24 });
+    expect(readDownloads().map((d) => d.key)).toEqual(["book:luke", "bible:ru-synodal"]);
+    putDownload(bible({ share: 0.9 }));
+    expect(readDownloads().map((d) => d.key)).toEqual(["book:luke", "bible:ru-synodal"]);
+    expect(readDownloads()[1].share).toBe(0.9);
+    // Written on the phone, read back after a restart.
+    resetDownloadsForTests();
+    expect(readDownloads().map((d) => d.key)).toEqual(["book:luke", "bible:ru-synodal"]);
+  });
+
+  it("puts one that begins again (a Bible tried again) back at the top", () => {
+    putDownload(bible({ state: "failed", failure: { key: "bible.downloads.failedUnavailable" }, ended: at }));
+    putDownload({ ...bible(), key: "book:luke", kind: "book", name: "Luke" });
+    putDownload(bible({ state: "running", share: 0 }));
+    expect(readDownloads().map((d) => [d.key, d.state])).toEqual([
+      ["bible:ru-synodal", "running"],
+      ["book:luke", "running"],
+    ]);
+  });
+
+  it("does not keep a download let go before its end", () => {
+    putDownload(bible());
+    dropDownload("bible:ru-synodal");
+    expect(readDownloads()).toEqual([]);
+  });
+
+  it("keeps the last eight, and an ended one a week", () => {
+    const now = Date.parse("2026-11-20T10:00:00.000Z");
+    const list: Download[] = Array.from({ length: 10 }, (_, i) => bible({ key: `chant:c${i}/en`, kind: "chant", state: "done", ended: new Date(now - i * 60_000).toISOString() }));
+    expect(keep(list, now)).toHaveLength(KEPT);
+    const old = bible({ state: "done", ended: new Date(now - KEPT_MS - 1).toISOString() });
+    const running = bible({ key: "book:luke", kind: "book", at: new Date(now - KEPT_MS - 1).toISOString() });
+    // An old end goes; a download under way stays however long it has run.
+    expect(keep([old, running], now).map((d) => d.key)).toEqual(["book:luke"]);
+    // Anything that is not a download is not kept.
+    expect(keep([{ nonsense: true } as unknown as Download, bible()], now).map((d) => d.key)).toEqual(["bible:ru-synodal"]);
+  });
+
+  it("lights the bell for an end not yet seen, until the sheet is opened", () => {
+    putDownload(bible());
+    expect(hasUnseenEnd()).toBe(false);
+    putDownload(bible({ state: "done", share: 1, ended: at, seen: false }));
+    expect(hasUnseenEnd()).toBe(true);
+    markDownloadsSeen();
+    expect(hasUnseenEnd()).toBe(false);
+    expect(readDownloads()[0].seen).toBe(true);
+  });
+});
diff --git a/lib/downloads/__tests__/notice.test.ts b/lib/downloads/__tests__/notice.test.ts
new file mode 100644
index 00000000..1fef8d4a
--- /dev/null
+++ b/lib/downloads/__tests__/notice.test.ts
@@ -0,0 +1,98 @@
+// A download told to the phone (1.9, build 95 note 23): each change of state
+// at once, its progress a whole percent at a time and not more than once a
+// second, a heartbeat for a slow one, one number for each download, the
+// first download asking once whether Purify may notify, and nothing at all
+// where the app's own plugin is not.
+
+import { beforeEach, describe, expect, it } from "vitest";
+
+const store = new Map<string, string>();
+Object.assign(globalThis, {
+  window: {
+    localStorage: {
+      getItem: (k: string) => store.get(k) ?? null,
+      setItem: (k: string, v: string) => void store.set(k, v),
+      removeItem: (k: string) => void store.delete(k),
+    },
+  },
+});
+
+const { tellPhone, clearPhone, askOnceToNotify, noticeId, resetNoticeForTests, HEARTBEAT_MS, STEP_MS, ASK_AT_FIRST_DOWNLOAD } = await import("@/lib/downloads/notice");
+
+type Posted = { id: number; title: string; text: string; share: number; state: string };
+const posted: Posted[] = [];
+const cleared: number[] = [];
+const phone = {
+  post: async (o: Posted) => void posted.push(o),
+  clear: async (o: { id: number }) => void cleared.push(o.id),
+};
+
+beforeEach(() => {
+  store.clear();
+  posted.length = 0;
+  cleared.length = 0;
+  resetNoticeForTests({ plugin: phone });
+});
+
+const d = (state: "running" | "waiting" | "done" | "failed", share: number) => ({ key: "bible:ru-synodal", state, share });
+
+describe("telling the phone", () => {
+  it("tells each change of state at once, and progress a whole percent at a time, not more than once a second", async () => {
+    const t0 = 1_000_000;
+    expect(await tellPhone(d("running", 0), "Синодальный", "Downloading, 0%", t0)).toBe(true);
+    expect(await tellPhone(d("running", 0.004), "Синодальный", "Downloading, 0%", t0 + 2000)).toBe(false);
+    expect(await tellPhone(d("running", 0.2), "Синодальный", "Downloading, 20%", t0 + 300)).toBe(false);
+    expect(await tellPhone(d("running", 0.2), "Синодальный", "Downloading, 20%", t0 + STEP_MS)).toBe(true);
+    expect(await tellPhone(d("done", 1), "Синодальный", "Downloaded", t0 + STEP_MS + 1)).toBe(true);
+    expect(await tellPhone(d("done", 1), "Синодальный", "Downloaded", t0 + STEP_MS + 5000)).toBe(false);
+    expect(posted.map((p) => [p.state, p.text])).toEqual([
+      ["running", "Downloading, 0%"],
+      ["running", "Downloading, 20%"],
+      ["done", "Downloaded"],
+    ]);
+  });
+
+  it("tells a slow download again within a minute, so the phone never clears it as stale", async () => {
+    const t0 = 5_000_000;
+    await tellPhone(d("running", 0.5), "Luke", "Saving 12 of 24", t0);
+    expect(await tellPhone(d("running", 0.5), "Luke", "Saving 12 of 24", t0 + HEARTBEAT_MS - 1)).toBe(false);
+    expect(await tellPhone(d("running", 0.5), "Luke", "Saving 12 of 24", t0 + HEARTBEAT_MS)).toBe(true);
+    // The phone's side clears an unrefreshed notice after 150 seconds: more than two beats.
+    expect(HEARTBEAT_MS * 2).toBeLessThan(150_000);
+  });
+
+  it("gives each download one number, always the same, and takes its notice away when it is let go", async () => {
+    expect(noticeId("bible:ru-synodal")).toBe(noticeId("bible:ru-synodal"));
+    expect(noticeId("bible:ru-synodal")).not.toBe(noticeId("book:luke"));
+    await clearPhone("bible:ru-synodal");
+    expect(cleared).toEqual([noticeId("bible:ru-synodal")]);
+  });
+
+  it("tells nothing where the app's own plugin is not (the website, a shell built before it)", async () => {
+    resetNoticeForTests({ plugin: null });
+    expect(await tellPhone(d("running", 0.1), "x", "y", 1)).toBe(false);
+    expect(posted).toEqual([]);
+  });
+});
+
+describe("asking whether Purify may notify", () => {
+  it("asks once, at the first download, only when the phone has not been asked", async () => {
+    expect(ASK_AT_FIRST_DOWNLOAD).toBe(true);
+    let asked = 0;
+    let answer = "prompt";
+    resetNoticeForTests({ plugin: phone, permissions: { check: async () => answer, request: async () => ((asked += 1), (answer = "denied")) } });
+    await askOnceToNotify();
+    await askOnceToNotify();
+    expect(asked).toBe(1);
+  });
+
+  it("never asks when the reader already answered, either way", async () => {
+    for (const answer of ["granted", "denied", "prompt-with-rationale"]) {
+      store.clear();
+      let asked = 0;
+      resetNoticeForTests({ plugin: phone, permissions: { check: async () => answer, request: async () => ((asked += 1), "granted") } });
+      await askOnceToNotify();
+      expect(asked, answer).toBe(0);
+    }
+  });
+});
