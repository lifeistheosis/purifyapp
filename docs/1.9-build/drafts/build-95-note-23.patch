@@ -0,0 +1,142 @@
+"use client";
+
+// A download told to the phone (1.9, build 95 note 23): on Android one
+// notification for it in the bar, its progress while it runs and then its
+// end; on an iPhone, which shows no progress there, a notification when it
+// ends. Posted by the app's own plugin, DownloadNotice
+// (android/app/src/main/java/net/purifyapp/purify/downloads/DownloadNoticePlugin.java,
+// ios/App/App/DownloadNoticePlugin.swift), registered as the widgets' bridge
+// is. Nothing on the website.
+//
+// No foreground service and nothing that needs a store's declaration: a
+// download goes on while Purify runs, and the phone may pause it once Purify
+// is left; Android clears a progress notice nobody has refreshed in a while
+// (STALE_MS on the phone's side), so none is left standing at a number.
+//
+// The phone posts nothing the reader has not allowed. The first download asks
+// once whether Purify may (ASK_AT_FIRST_DOWNLOAD, his call): the bar needs it
+// on Android 13 and later and on an iPhone. A no is kept, and the bell's sheet
+// still shows every download.
+
+import { nativePlugin } from "@/lib/platform/nativePlugin";
+
+import type { Download, DownloadState } from "./log";
+
+type DownloadNotice = {
+  post(o: { id: number; title: string; text: string; share: number; state: DownloadState }): Promise<void>;
+  clear(o: { id: number }): Promise<void>;
+};
+
+/** Ask whether Purify may notify, once, at the first download (his call, build 95 note 23). */
+export const ASK_AT_FIRST_DOWNLOAD = true;
+
+/** A running notice is told again at least this often, so a slow download's never goes stale. */
+export const HEARTBEAT_MS = 60_000;
+/** And not more often than this as it moves, a whole percent at a time. */
+export const STEP_MS = 1000;
+
+const ASKED_KEY = "purify:downloads.askedToNotify";
+
+/** A download's number on the phone: always the same for the same download. */
+export function noticeId(key: string): number {
+  let h = 0;
+  for (let i = 0; i < key.length; i++) h = (h * 31 + key.charCodeAt(i)) | 0;
+  return 70_000 + (Math.abs(h) % 10_000);
+}
+
+type Told = { state: DownloadState; percent: number; at: number };
+const told = new Map<string, Told>();
+
+/** Whether this state of a download is worth telling the phone: a change of state always, progress a whole percent at a time and not too often, and a heartbeat. */
+export function worthTelling(d: Pick<Download, "key" | "state" | "share">, now: number): boolean {
+  const before = told.get(d.key);
+  if (!before || before.state !== d.state) return true;
+  if (d.state !== "running") return false;
+  if (now - before.at >= HEARTBEAT_MS) return true;
+  return Math.floor(d.share * 100) !== before.percent && now - before.at >= STEP_MS;
+}
+
+function askedBefore(): boolean {
+  try {
+    return window.localStorage.getItem(ASKED_KEY) === "1";
+  } catch {
+    return true;
+  }
+}
+
+function markAsked(): void {
+  try {
+    window.localStorage.setItem(ASKED_KEY, "1");
+  } catch {
+    /* asked again next time, which the phone itself answers without asking twice */
+  }
+}
+
+type Permissions = {
+  check(): Promise<string>;
+  request(): Promise<string>;
+};
+
+/** The phone's own answer on notifications, as the reminders ask it (lib/push/native.ts). */
+const phonePermissions: Permissions = {
+  async check() {
+    const { PushNotifications } = await import("@capacitor/push-notifications");
+    return (await PushNotifications.checkPermissions()).receive;
+  },
+  async request() {
+    const { PushNotifications } = await import("@capacitor/push-notifications");
+    return (await PushNotifications.requestPermissions()).receive;
+  },
+};
+
+let permissions: Permissions = phonePermissions;
+let plugin: () => Promise<{ api: DownloadNotice } | null> = () => nativePlugin<DownloadNotice>("DownloadNotice");
+
+/**
+ * At a download's start: the first one ever asks the phone, once, whether
+ * Purify may show notifications, when the phone has not been asked; never
+ * again after, whatever the answer.
+ */
+export async function askOnceToNotify(): Promise<void> {
+  if (!ASK_AT_FIRST_DOWNLOAD || askedBefore()) return;
+  try {
+    if ((await permissions.check()) !== "prompt") return;
+    markAsked();
+    await permissions.request();
+  } catch {
+    /* no answer: the bell's sheet still shows the download */
+  }
+}
+
+/** Tell the phone a download's state, in the reader's words; nothing when not worth it, or on the website. */
+export async function tellPhone(d: Pick<Download, "key" | "state" | "share">, title: string, text: string, now: number = Date.now()): Promise<boolean> {
+  if (!worthTelling(d, now)) return false;
+  told.set(d.key, { state: d.state, percent: Math.floor(d.share * 100), at: now });
+  const box = await plugin();
+  if (!box) return false;
+  try {
+    await box.api.post({ id: noticeId(d.key), title, text, share: d.share, state: d.state });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** A download let go: its notice taken off the phone. */
+export async function clearPhone(key: string): Promise<void> {
+  told.delete(key);
+  const box = await plugin();
+  if (!box) return;
+  try {
+    await box.api.clear({ id: noticeId(key) });
+  } catch {
+    /* already gone */
+  }
+}
+
+/** For tests: a stand-in plugin and permissions, and nothing told yet. */
+export function resetNoticeForTests(stand: { plugin?: DownloadNotice | null; permissions?: Permissions } = {}): void {
+  told.clear();
+  permissions = stand.permissions ?? phonePermissions;
+  plugin = "plugin" in stand ? async () => (stand.plugin ? { api: stand.plugin } : null) : () => nativePlugin<DownloadNotice>("DownloadNotice");
+}
diff --git a/lib/downloads/watch.ts b/lib/downloads/watch.ts
new file mode 100644
index 00000000..303b4a48
--- /dev/null
+++ b/lib/downloads/watch.ts
@@ -0,0 +1,119 @@
+// What each store's download is doing, as one kind of thing (1.9, build 95
+// note 23; ./log.ts says why). Pure: the three stores' states in, the
+// downloads under way out, the end of one that has left them, and the words
+// of a download's line, which the bell's sheet and the phone both say.
+
+import type { BiblesState } from "@/lib/bible/downloads/store";
+import { FAILED_WORDS } from "@/lib/bible/downloads/store";
+
+import type { Download, DownloadKind, DownloadWords } from "./log";
+
+/** A book's saving to listen offline, as lib/readAloud/saving.ts keeps it. */
+export type BookSaving = {
+  job: { book: string; done: number; total: number; waiting: "wifi" | "signal" | null } | null;
+  /** The last book whose saving ended with chapters the website would not give. */
+  failed: string | null;
+};
+
+/** A chant's saving, as lib/chants/offline.ts keeps it. */
+export type ChantSaving = { job: { ref: string; share: number } | null; failed: string | null };
+
+export type Stores = { bibles: Pick<BiblesState, "saved" | "downloads">; saving: BookSaving; chants: ChantSaving };
+
+/** What each download is called, by what it is. */
+export type Names = { bible: (id: string) => string; book: (slug: string) => string; chant: (ref: string) => string };
+
+/** A download under way. */
+export type Live = Pick<Download, "key" | "kind" | "name" | "state" | "share" | "done" | "total" | "waiting">;
+
+export const keyOf = (kind: DownloadKind, id: string): string => `${kind}:${id}`;
+export const idOf = (key: string): string => key.slice(key.indexOf(":") + 1);
+
+const share = (done: number, total: number) => (total > 0 ? Math.min(1, Math.max(0, done / total)) : 0);
+
+/** The downloads under way now, in the three stores. */
+export function liveDownloads(s: Stores, names: Names): Live[] {
+  const out: Live[] = [];
+  for (const [id, d] of Object.entries(s.bibles.downloads)) {
+    if (d?.state !== "downloading") continue;
+    out.push({ key: keyOf("bible", id), kind: "bible", name: names.bible(id), state: "running", share: share(d.done, d.total), done: 0, total: 0 });
+  }
+  const job = s.saving.job;
+  if (job) {
+    out.push({
+      key: keyOf("book", job.book),
+      kind: "book",
+      name: names.book(job.book),
+      state: job.waiting ? "waiting" : "running",
+      share: share(job.done, job.total),
+      done: job.done,
+      total: job.total,
+      ...(job.waiting ? { waiting: job.waiting } : {}),
+    });
+  }
+  const chant = s.chants.job;
+  if (chant) out.push({ key: keyOf("chant", chant.ref), kind: "chant", name: names.chant(chant.ref), state: "running", share: Math.min(1, Math.max(0, chant.share)), done: 0, total: 0 });
+  return out;
+}
+
+/** What is on the phone now, asked of the stores' own lists. */
+export type Kept = { bookChapters: (book: string) => number; chant: (ref: string) => boolean };
+
+/** How a download that has left the stores ended: done, failed and why, or let go (null), which is not kept. */
+export type End = { state: "done" } | { state: "failed"; failure: DownloadWords } | null;
+
+export function endOf(was: Live, s: Stores, kept: Kept): End {
+  const id = idOf(was.key);
+  if (was.kind === "bible") {
+    const d = s.bibles.downloads[id as keyof Stores["bibles"]["downloads"]];
+    if (d?.state === "failed") return { state: "failed", failure: { key: FAILED_WORDS[d.reason] } };
+    return s.bibles.saved[id] ? { state: "done" } : null;
+  }
+  if (was.kind === "book") {
+    if (s.saving.failed === id) return { state: "failed", failure: { key: "player.offline.failed" } };
+    return was.total > 0 && kept.bookChapters(id) >= was.total ? { state: "done" } : null;
+  }
+  if (s.chants.failed === id) return { state: "failed", failure: { key: "player.offline.failedOne", vars: { book: was.name } } };
+  return kept.chant(id) ? { state: "done" } : null;
+}
+
+/** A download the app was closed in the middle of, said as it is (build 95 note 23). */
+export const STOPPED: DownloadWords = { key: "downloads.stopped" };
+
+/** The words of a download's line: what it is doing, or how it ended. */
+export function lineOf(d: Pick<Download, "kind" | "state" | "share" | "done" | "total" | "waiting" | "failure">): DownloadWords {
+  if (d.state === "failed") return d.failure ?? STOPPED;
+  if (d.state === "done") return { key: d.kind === "bible" ? "downloads.downloaded" : "downloads.savedToListen" };
+  if (d.state === "waiting") {
+    return { key: d.waiting === "wifi" ? "player.offline.waitingWifi" : "player.offline.waitingSignal", vars: { done: d.done, total: d.total } };
+  }
+  if (d.kind === "book") return { key: "player.offline.saving", vars: { done: d.done, total: d.total } };
+  return { key: d.kind === "bible" ? "bible.downloads.downloading" : "downloads.saving", vars: { percent: Math.floor(d.share * 100) } };
+}
+
+/** Whether two states of one download read the same: then nothing is written or told again. */
+export function readsTheSame(a: Live | Download, b: Live | Download): boolean {
+  return (
+    a.state === b.state &&
+    a.name === b.name &&
+    a.done === b.done &&
+    a.total === b.total &&
+    a.waiting === b.waiting &&
+    Math.floor(a.share * 100) === Math.floor(b.share * 100)
+  );
+}
+
+/** Every message key a download's line can say: each must be in every language. */
+export const LINE_KEYS: readonly string[] = [
+  ...Object.values(FAILED_WORDS),
+  "player.offline.failed",
+  "player.offline.failedOne",
+  STOPPED.key,
+  "downloads.downloaded",
+  "downloads.savedToListen",
+  "player.offline.waitingWifi",
+  "player.offline.waitingSignal",
+  "player.offline.saving",
+  "bible.downloads.downloading",
+  "downloads.saving",
+];
