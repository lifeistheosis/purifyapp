+"use client";
+
+import { useSyncExternalStore } from "react";
+
+/**
+ * The Voice sheet's state (1.9, build 95 note 25): opened from the player's
+ * ••• (over the player), or from a page's Listen when the phone has no voice
+ * for the text's language and the text has no recording (`none`), to say so
+ * and where a voice is added. Mounted once in the root frame, as the ambience
+ * sheet is (components/player/VoiceSheet.tsx).
+ */
+
+export type VoiceSheetState = { open: boolean; overPlayer: boolean; none: { lang: string } | null };
+
+let state: VoiceSheetState = { open: false, overPlayer: false, none: null };
+const listeners = new Set<() => void>();
+
+function set(next: VoiceSheetState): void {
+  state = next;
+  for (const l of listeners) l();
+}
+
+export function openVoiceSheet(o: { overPlayer?: boolean; none?: { lang: string } } = {}): void {
+  set({ open: true, overPlayer: Boolean(o.overPlayer), none: o.none ?? null });
+}
+
+export function closeVoiceSheet(): void {
+  if (state.open) set({ ...state, open: false });
+}
+
+export function useVoiceSheet(): VoiceSheetState {
+  return useSyncExternalStore(
+    (l) => {
+      listeners.add(l);
+      return () => {
+        listeners.delete(l);
+      };
+    },
+    () => state,
+    () => state,
+  );
+}
diff --git a/lib/listen/speech/speak.ts b/lib/listen/speech/speak.ts
new file mode 100644
index 00000000..d023e193
--- /dev/null
+++ b/lib/listen/speech/speak.ts
@@ -0,0 +1,188 @@
+"use client";
+
+import { useSyncExternalStore } from "react";
+
+import { readSpeed } from "@/lib/player/speed";
+import { getAudioSnapshot, play, seek, setLoopMode, setSpokenTrack } from "@/lib/prayers/persistentAudioStore";
+
+import { speechEngine, type PhoneVoice } from "./engine";
+import { createSpeechSession } from "./session";
+import { DEFAULT_PACE, speechTimeline, type SpeechPiece } from "./timeline";
+import { HEART, chosenVoice, goneSaid, markGoneSaid, voiceToUse, type VoiceToUse } from "./voiceChoice";
+import { deviceVoices } from "./voices";
+
+/**
+ * A text read by the phone's voice, through the one player (1.9, build 95
+ * note 25): which voice reads it, as the reader chose; the reading loaded and
+ * begun; each voice's pace kept for next time; and what the player shows
+ * about the voice (its name on the Voice row, the line said once when a
+ * chosen voice has gone).
+ */
+
+const PACE_KEY = "purify:listen.pace";
+
+function paces(): Record<string, number> {
+  try {
+    const kept = JSON.parse(window.localStorage.getItem(PACE_KEY) ?? "{}");
+    return kept && typeof kept === "object" ? (kept as Record<string, number>) : {};
+  } catch {
+    return {};
+  }
+}
+
+/** A voice's pace as learned from its last reading (letters a second at speed 1), or an ordinary one. */
+export function paceOf(voiceId: string): number {
+  const p = paces()[voiceId];
+  return typeof p === "number" && Number.isFinite(p) && p > 0 ? p : DEFAULT_PACE;
+}
+
+/** Keep a voice's pace on the device (the session reports it as it learns it), for the next reading's timeline. */
+export function keepPace(voiceId: string, pace: number): void {
+  if (!(pace > 0)) return;
+  try {
+    const all = paces();
+    // A few dozen voices at most: the newest kept.
+    const ids = Object.keys(all).filter((id) => id !== voiceId).slice(-39);
+    const next: Record<string, number> = {};
+    for (const id of ids) next[id] = all[id];
+    next[voiceId] = Math.round(pace * 100) / 100;
+    window.localStorage.setItem(PACE_KEY, JSON.stringify(next));
+  } catch {
+    /* a full or private store: learned again next time */
+  }
+}
+
+type Shown = {
+  /** The spoken track and the voice reading it. */
+  reading: { src: string; voice: PhoneVoice } | null;
+  /** A chosen voice had gone and another reads: said once, by the player. */
+  gone: { lang: string; instead: "heart" | PhoneVoice } | null;
+};
+
+/** Told when a spoken track has been read to its end and stops there (not a Loop's new round): a chapter rolls on into the next. */
+const endListeners = new Set<(src: string) => void>();
+
+export function onSpokenEnd(listener: (src: string) => void): () => void {
+  endListeners.add(listener);
+  return () => {
+    endListeners.delete(listener);
+  };
+}
+
+let shown: Shown = { reading: null, gone: null };
+const listeners = new Set<() => void>();
+
+function set(patch: Partial<Shown>): void {
+  shown = { ...shown, ...patch };
+  for (const l of listeners) l();
+}
+
+/** What the player shows of the voice: the one reading, and a line said once. */
+export function useVoiceShown(): Shown {
+  return useSyncExternalStore(
+    (l) => {
+      listeners.add(l);
+      return () => {
+        listeners.delete(l);
+      };
+    },
+    () => shown,
+    () => shown,
+  );
+}
+
+/** The line about a gone voice has been shown: it is not shown again. */
+export function goneShown(): void {
+  if (shown.gone) set({ gone: null });
+}
+
+/**
+ * Which voice reads a text in `lang` (a voice's language, lib/listen/speech/
+ * spoken.ts voiceLang): the reader's choice where the phone still has it, else
+ * Heart where the text has its recording, else the phone's own voice for the
+ * language; none where the phone has no voice for it and there is no
+ * recording. A text with its recording, and no other voice chosen for its
+ * language, is Heart without waking the phone's speech at all.
+ */
+export async function voiceFor(lang: string, recorded: boolean): Promise<VoiceToUse> {
+  const choice = chosenVoice(lang);
+  if (recorded && (!choice || choice === HEART)) return { kind: "heart" };
+  const use = voiceToUse(choice, await deviceVoices(), lang, recorded);
+  if (use.kind !== "none" && use.gone && !goneSaid(use.gone)) {
+    markGoneSaid(use.gone);
+    set({ gone: { lang, instead: use.kind === "heart" ? "heart" : use.voice } });
+  }
+  return use;
+}
+
+export type SpeakText = {
+  /** Its address in the player (lib/listen/speech/spoken.ts). */
+  src: string;
+  pieces: SpeechPiece[];
+  /** The voice's language. */
+  lang: string;
+  voice: PhoneVoice;
+  title: string;
+  artist?: string;
+  art?: string;
+  artFallback?: string;
+  artSize?: string;
+  rtl?: boolean;
+  /** The piece to begin at: the verse being read when the voice is changed. */
+  from?: number;
+  /** Begin speaking at once (the default), or load it paused there. */
+  autoplay?: boolean;
+};
+
+/**
+ * Load a text for the phone's voice into the one player and read it. False
+ * where the device has no speech after all.
+ */
+export async function speakText(o: SpeakText): Promise<boolean> {
+  const engine = await speechEngine();
+  if (!engine || !o.pieces.length) return false;
+  const pace = paceOf(o.voice.id);
+  const rate = readSpeed();
+  const t = speechTimeline(o.pieces, pace);
+  setSpokenTrack(
+    o.src,
+    (host) =>
+      createSpeechSession({
+        engine,
+        pieces: o.pieces,
+        lang: o.voice.lang || o.lang,
+        voice: o.voice.id,
+        rate,
+        volume: getAudioSnapshot().volume,
+        pace,
+        onPace: (p) => keepPace(o.voice.id, p),
+        title: o.title,
+        artist: o.artist,
+        host: {
+          ...host,
+          ended: (restart) => {
+            host.ended(restart);
+            // Stopped at its end, not begun again by a Loop or a repeat.
+            if (!getAudioSnapshot().playing && getAudioSnapshot().src === o.src) for (const l of [...endListeners]) l(o.src);
+          },
+        },
+      }),
+    {
+      title: o.title,
+      artist: o.artist,
+      art: o.art,
+      artFallback: o.artFallback,
+      artSize: o.artSize,
+      captions: t.captions,
+      duration: t.duration,
+      rtl: o.rtl,
+      rate,
+    },
+  );
+  set({ reading: { src: o.src, voice: o.voice } });
+  const from = Math.max(0, Math.min(o.from ?? 0, t.starts.length - 1));
+  if (from > 0) seek(t.starts[from]);
+  setLoopMode("off");
+  if (o.autoplay !== false) play();
+  return true;
+}
diff --git a/lib/listen/speech/spoken.ts b/lib/listen/speech/spoken.ts
new file mode 100644
index 00000000..db723c13
--- /dev/null
+++ b/lib/listen/speech/spoken.ts
@@ -0,0 +1,54 @@
+import { parseListenId } from "@/lib/listen/texts";
+
+/**
+ * What the one player is speaking with the phone's voice, by its address
+ * (1.9, build 95 note 25). A recording has an address the player plays; a
+ * text the phone speaks has none, so it is given one, which says what it is,
+ * so the player's Speed, Read, Share and the page's lit verse know it as they
+ * know a recording:
+ *
+ *   speech:bible/<book>/<chapter>              a chapter of the English Bible
+ *   speech:bible/<book>/<chapter>?in=<bible>   a chapter of a downloaded Bible
+ *   speech:<listen id>?lang=<lang>             a life, a council's section, a
+ *                                              study's part, an event, a work's
+ *                                              section (lib/listen/texts.ts)
+ *
+ * Pure: no window here.
+ */
+
+export const SPOKEN = "speech:";
+
+export type Spoken =
+  | { kind: "bible"; book: string; chapter: number; bible: string | null }
+  | { kind: "text"; id: string; lang: string };
+
+export function spokenBibleSrc(book: string, chapter: number, bible: string | null = null): string {
+  return `${SPOKEN}bible/${book}/${chapter}${bible ? `?in=${encodeURIComponent(bible)}` : ""}`;
+}
+
+export function spokenTextSrc(id: string, lang: string): string {
+  return `${SPOKEN}${id}?lang=${encodeURIComponent(lang)}`;
+}
+
+/** What a player address speaks, or null when it is no spoken text's. */
+export function spokenOf(src: string | null | undefined): Spoken | null {
+  if (!src?.startsWith(SPOKEN)) return null;
+  const rest = src.slice(SPOKEN.length);
+  const cut = rest.indexOf("?");
+  const path = cut < 0 ? rest : rest.slice(0, cut);
+  const query = new URLSearchParams(cut < 0 ? "" : rest.slice(cut + 1));
+  const bible = /^bible\/([a-z0-9-]+)\/(\d{1,3})$/.exec(path);
+  if (bible) return { kind: "bible", book: bible[1], chapter: Number(bible[2]), bible: query.get("in") || null };
+  if (parseListenId(path)) return { kind: "text", id: path, lang: query.get("lang") || "en" };
+  return null;
+}
+
+/**
+ * The language a voice is asked for, from the language of the text's words.
+ * Koine Greek ("grc", the downloaded Septuagint and Patriarchal text) is read
+ * in the Greek of today, as the Church reads it aloud; any other is its own.
+ */
+export function voiceLang(textLang: string): string {
+  const base = textLang.toLowerCase().split(/[-_]/)[0] || "en";
+  return base === "grc" ? "el" : base;
+}
diff --git a/lib/listen/speech/voices.ts b/lib/listen/speech/voices.ts
new file mode 100644
index 00000000..0f250634
--- /dev/null
+++ b/lib/listen/speech/voices.ts
@@ -0,0 +1,136 @@
+"use client";
+
+import { useEffect, useSyncExternalStore } from "react";
+
+import { canSpeak, speechEngine, type PhoneVoice } from "./engine";
+import { voicesFor } from "./voiceChoice";
+
+/**
+ * The voices this phone has, asked once and kept for the life of the page
+ * (1.9, build 95 note 25). Asking wakes the phone's speech engine, so it is
+ * asked when the player or a Listen needs it, never as the app opens. Asked
+ * again when the Voice sheet opens and when the reader comes back to the app
+ * (a voice added in the phone's settings meanwhile); the list known stands
+ * until the new one comes.
+ */
+
+let known: PhoneVoice[] | null = null;
+let asking: Promise<PhoneVoice[]> | null = null;
+const listeners = new Set<() => void>();
+
+function tell(): void {
+  for (const l of listeners) l();
+}
+
+/** The phone's voices: those known, or asked for now. Empty where the device has no speech. */
+export function deviceVoices(): Promise<PhoneVoice[]> {
+  if (known) return Promise.resolve(known);
+  return askAgain();
+}
+
+/** Ask the phone again, keeping the list known until it answers. */
+export function askAgain(): Promise<PhoneVoice[]> {
+  asking ??= speechEngine()
+    .then((engine) => (engine ? engine.voices() : []))
+    .catch(() => [] as PhoneVoice[])
+    .then((voices) => {
+      asking = null;
+      known = voices;
+      tell();
+      return voices;
+    });
+  return asking;
+}
+
+/** The phone's voices for a component: null until first known. `ask` wakes the phone's speech to know them. */
+export function useDeviceVoices(ask = true): PhoneVoice[] | null {
+  const voices = useSyncExternalStore(
+    (l) => {
+      listeners.add(l);
+      return () => {
+        listeners.delete(l);
+      };
+    },
+    () => known,
+    () => null,
+  );
+  useEffect(() => {
+    if (ask) void deviceVoices();
+  }, [ask]);
+  return voices;
+}
+
+const never = () => () => {};
+
+/**
+ * Whether Listen can be offered on a text with no recording: the device can
+ * speak. Drawn as true on the server, so a page drawn there does not move when
+ * it wakes; a browser with no speech takes it away.
+ */
+export function useCanSpeak(): boolean {
+  return useSyncExternalStore(never, canSpeak, () => true);
+}
+
+/** For tests. */
+export function forgetDeviceVoices(): void {
+  known = null;
+  asking = null;
+}
+
+/** A phone's own name for a voice that is an id, not a name: Android's "en-gb-x-gba-local". */
+function isAnId(voice: PhoneVoice): boolean {
+  return voice.name === voice.id && !/\s/.test(voice.name) && /[-_#.]/.test(voice.name);
+}
+
+export type VoiceRow = { voice: PhoneVoice; name: string; language: string };
+
+/**
+ * The phone's voices for a language as the Voice sheet lists them, each with
+ * the name a reader sees and its language in the reader's own words: an
+ * iPhone's own names (Daniel, Samantha); a browser's, without the language it
+ * adds after a dash ("Microsoft David - English (United States)"); Android's
+ * ids, by their language and a number ("Voice 2"). A voice listed twice under
+ * one name (an iPhone's compact and enhanced Daniel) is listed once, the
+ * better, or the one the reader chose.
+ */
+export function voiceRows(voices: readonly PhoneVoice[], lang: string, locale: string, numbered: (n: number) => string, chosen: string | null = null): VoiceRow[] {
+  let names: Intl.DisplayNames | null = null;
+  try {
+    names = new Intl.DisplayNames([locale], { type: "language" });
+  } catch {
+    names = null;
+  }
+  const languageOf = (tag: string) => {
+    try {
+      return names?.of(tag.replace("_", "-")) ?? tag;
+    } catch {
+      return tag;
+    }
+  };
+  const counts = new Map<string, number>();
+  const rows: VoiceRow[] = [];
+  const seen = new Map<string, number>();
+  for (const voice of voicesFor(voices, lang)) {
+    const tag = voice.lang.toLowerCase().replace("_", "-");
+    let name: string;
+    if (isAnId(voice)) {
+      const n = (counts.get(tag) ?? 0) + 1;
+      counts.set(tag, n);
+      name = numbered(n);
+    } else {
+      name = voice.name.split(" - ")[0].trim() || voice.name;
+    }
+    const row = { voice, name, language: languageOf(voice.lang) };
+    const twin = `${tag}|${name}`;
+    const at = seen.get(twin);
+    if (at === undefined) {
+      seen.set(twin, rows.length);
+      rows.push(row);
+      continue;
+    }
+    // The twin listed already: keep the reader's choice, else the better.
+    const before = rows[at].voice;
+    if (before.id !== chosen && (voice.id === chosen || (voice.quality ?? 0) > (before.quality ?? 0))) rows[at] = row;
+  }
+  return rows;
+}
