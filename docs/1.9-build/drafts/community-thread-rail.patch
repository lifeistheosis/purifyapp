diff --git a/lib/community/__tests__/noThreadRail.test.ts b/lib/community/__tests__/noThreadRail.test.ts
new file mode 100644
index 00000000..932b3d55
--- /dev/null
+++ b/lib/community/__tests__/noThreadRail.test.ts
@@ -0,0 +1,35 @@
+import fs from "node:fs";
+import path from "node:path";
+
+import { describe, expect, it } from "vitest";
+
+/**
+ * No line beside a thread (held for the owner's yes, Updates 25, 2026-11-13).
+ * Updates 24's strip of Community's "0 replies" showed a thin vertical line at
+ * a post's start as its thread opened. It is the rail a thread hung from: a
+ * 1.5px line running down from the writer's picture, drawn on every post with
+ * replies and on every open thread, at rest. checkMock's stripe measure does
+ * not count it (it stands in a column of its own, not on a box's edge), and
+ * his rule of 2026-11-10 is "the line on the left" (CLAUDE.md, "No side
+ * stripes"): a thread stands on its own type, with no rule beside it.
+ *
+ * What it holds: the post draws no rail line, and the stylesheet keeps no
+ * rule for one.
+ *
+ * What a reader would notice if this broke: a thin line down the start of a
+ * post under the writer's picture, whenever the post has replies.
+ */
+
+const read = (file: string) => fs.readFileSync(path.join(process.cwd(), file), "utf8");
+
+describe("no line beside a thread", () => {
+  it("a post draws no rail line under the writer's picture", () => {
+    const code = read("components/community/CommunityClient.tsx");
+    expect(code).not.toMatch(/community-rail/);
+    expect(code).not.toMatch(/threadHangs/);
+  });
+
+  it("the stylesheet keeps no rule for one", () => {
+    expect(read("app/globals.css")).not.toMatch(/\.community-rail\b/);
+  });
+});
