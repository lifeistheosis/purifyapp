index 00000000..7996a13c
--- /dev/null
+++ b/components/reader/EarnSheet.tsx
@@ -0,0 +1,101 @@
+"use client";
+
+// What is left to read for a palette earned by reading (build 95 note 27):
+// a tap on its card opens this, and each thing still to read is a door to it.
+// Until then the card opened one long line under its row.
+//
+// The house sheet. The councils' names come with the sheet, not with every
+// screen that shows the card: lib/councils/councils.ts is asked for only once
+// the Councils sheet is open.
+
+import Link from "next/link";
+import { useEffect, useState } from "react";
+
+import { useTranslate } from "@/components/i18n/MessagesProvider";
+import { EarnMarks } from "@/components/reader/EarnMarks";
+import { useEarnedPalettes, useEarnedSoFar } from "@/components/reader/useEarnedPalettes";
+import { Check } from "@/components/ui/icons/Check";
+import { ChevronRight } from "@/components/ui/icons/ChevronRight";
+import { Sheet } from "@/components/ui/Sheet";
+import { CAPPADOCIANS, CAPPADOCIAN_FACES, COUNCIL_PAGES, type EarnedPalettes } from "@/lib/reader/earned";
+
+type CouncilName = { slug: string; byname: string; year: number };
+
+const FATHER_NAMES: Record<(typeof CAPPADOCIANS)[number], string> = {
+  "basil-the-great": "earn.basil",
+  "gregory-theologian": "earn.gregoryTheologian",
+  "gregory-of-nyssa": "earn.gregoryOfNyssa",
+};
+
+export function EarnSheet({ goal, locked, onClose }: { goal: keyof EarnedPalettes | null; locked: boolean; onClose: () => void }) {
+  const { t } = useTranslate();
+  const earned = useEarnedPalettes();
+  const sofar = useEarnedSoFar();
+  const [councils, setCouncils] = useState<readonly CouncilName[] | null>(null);
+  const wanted = goal === "councils" && !councils;
+  useEffect(() => {
+    if (!wanted) return;
+    let live = true;
+    void import("@/lib/councils/councils").then(({ COUNCILS }) => {
+      if (!live) return;
+      const by = new Map(COUNCILS.map((c) => [c.slug, c]));
+      setCouncils(COUNCIL_PAGES.flatMap((slug) => (by.get(slug) ? [{ slug, byname: by.get(slug)!.byname, year: by.get(slug)!.year }] : [])));
+    });
+    return () => {
+      live = false;
+    };
+  }, [wanted]);
+
+  if (!goal) return null;
+  const progress = earned[goal];
+  const title = t(goal === "councils" ? "settings.paletteCouncils" : "settings.paletteCappadocian");
+  return (
+    <Sheet open onClose={onClose} title={title} desktop bodyClassName="earn-sheet">
+      <div className="earn-sheet-head">
+        <p className="earn-sheet-line">{t(goal === "councils" ? "earn.councilsLine" : "earn.cappadocianLine")}</p>
+        <div className="earn-sheet-marks" data-goal={goal}>
+          <EarnMarks goal={goal} progress={progress} />
+          <span className="earn-sheet-count">{t("earn.readCount", { count: progress.read, total: progress.of })}</span>
+        </div>
+      </div>
+      <ul className="earn-doors" data-earn-doors={goal}>
+        {goal === "councils"
+          ? (councils ?? []).map((c) => {
+              const read = sofar.councils.includes(c.slug);
+              // "Read", or the year, unless the council's name already says it ("Council of Antioch (268)").
+              const year = String(c.year);
+              const line = read ? t("earn.read") : c.byname.includes(year) ? null : year;
+              return (
+                <li key={c.slug}>
+                  <Link href={`/councils/${c.slug}/`} onClick={onClose} className="earn-door" data-read={read ? "" : undefined}>
+                    <span className="earn-door-words">
+                      <span lang="en" dir="ltr" className="earn-door-name">{c.byname}</span>
+                      {line ? <span className="earn-door-line">{line}</span> : null}
+                    </span>
+                    {read ? <Check size={18} className="earn-door-mark" /> : <ChevronRight size={18} className="earn-door-mark rtl:-scale-x-100" />}
+                  </Link>
+                </li>
+              );
+            })
+          : CAPPADOCIANS.map((saint) => {
+              const read = sofar.fathers.includes(saint);
+              return (
+                <li key={saint}>
+                  <Link href={`/saints/${saint}/`} onClick={onClose} className="earn-door" data-read={read ? "" : undefined}>
+                    {/* eslint-disable-next-line @next/next/no-img-element -- a 44px face the apps carry */}
+                    <img src={CAPPADOCIAN_FACES[saint]} alt="" decoding="async" className="earn-door-face" />
+                    <span className="earn-door-words">
+                      <span className="earn-door-name">{t(FATHER_NAMES[saint])}</span>
+                      <span className="earn-door-line">{read ? t("earn.read") : t("earn.oneWork")}</span>
+                    </span>
+                    {read ? <Check size={18} className="earn-door-mark" /> : <ChevronRight size={18} className="earn-door-mark rtl:-scale-x-100" />}
+                  </Link>
+                </li>
+              );
+            })}
+      </ul>
+      {/* Plus is never promised to every reader: a reader without it is told before they read for it. */}
+      {locked ? <p className="earn-sheet-plus">{t("settings.palettePlusNote")}</p> : null}
+    </Sheet>
+  );
+}
diff --git a/components/reader/EarnedMoment.tsx b/components/reader/EarnedMoment.tsx
new file mode 100644
index 00000000..96ecf457
--- /dev/null
+++ b/components/reader/EarnedMoment.tsx
@@ -0,0 +1,97 @@
+"use client";
+
+// The moment a palette is earned by reading (build 95 note 27, the owner's
+// "make the read to unlock themes cooler"): at the foot of the last page
+// read, the new look is shown in the house's own reveal (the gift's: a soft
+// pool of light it rises into, a few embers, the mandorla it rests in; never
+// rays, a sparkle or confetti), the phone gives its one soft tick, and one
+// tap wears it. Until then nothing marked the moment at all: the card in
+// Settings simply stopped being dim.
+//
+// It stands in the page, under its last words, and not over it: the reader
+// has just finished reading and nothing takes the page from them. It is
+// shown once for each palette on a device (KEY), and only on the page whose
+// end earned it. Under reduced motion it is still and whole at once.
+
+import { useEffect, useState } from "react";
+
+import { useTranslate } from "@/components/i18n/MessagesProvider";
+import { useReaderPrefs } from "@/components/reader/ReaderPrefs";
+import { useEarnedPalettes } from "@/components/reader/useEarnedPalettes";
+import { usePalettePick } from "@/components/reader/usePalettePick";
+import { ModePage } from "@/components/settings/ReadingModePages";
+import { Check } from "@/components/ui/icons/Check";
+import type { EarnedPalettes } from "@/lib/reader/earned";
+import { PREVIEW_CHAPTER } from "@/lib/settings/preview";
+import { softTick } from "@/lib/ui/softTick";
+
+const KEY = "purify.earned.shown";
+/** When the page has settled in its light: the phone's tick lands with it. */
+const LANDS_MS = 700;
+const EMBERS = [-64, -38, -14, 12, 34, 58] as const;
+
+function shown(): string[] {
+  try {
+    const raw = JSON.parse(localStorage.getItem(KEY) ?? "[]");
+    return Array.isArray(raw) ? raw.filter((x) => typeof x === "string") : [];
+  } catch {
+    return [];
+  }
+}
+
+export function EarnedMoment({ palette }: { palette: keyof EarnedPalettes }) {
+  const { t } = useTranslate();
+  const { font } = useReaderPrefs();
+  const earned = useEarnedPalettes()[palette].earned;
+  const { pick, worn, locked } = usePalettePick();
+  const [open, setOpen] = useState(false);
+
+  // Earned while this page is open, and not shown before: this is the page
+  // that earned it. Decided as the page is drawn (nothing is earned in the
+  // first draw, so the export and the device agree), and kept once it shows.
+  if (earned && !open && !shown().includes(palette)) setOpen(true);
+  useEffect(() => {
+    if (!open) return;
+    try {
+      const seen = shown();
+      if (!seen.includes(palette)) localStorage.setItem(KEY, JSON.stringify([...seen, palette]));
+    } catch {
+      // A device that keeps nothing shows it again next time: better twice than never.
+    }
+    const tick = window.setTimeout(softTick, LANDS_MS);
+    return () => window.clearTimeout(tick);
+  }, [open, palette]);
+
+  if (!open) return null;
+  const name = t(palette === "councils" ? "settings.paletteCouncils" : "settings.paletteCappadocian");
+  const wearing = worn === palette;
+  return (
+    <section className="earned-moment" data-earned={palette} aria-live="polite">
+      <div className="earned-stage" aria-hidden>
+        <span className="earned-pool" />
+        <span className="earned-mandorla" />
+        {EMBERS.map((x, i) => (
+          <span key={x} className="earned-ember" style={{ ["--ember-x" as string]: `${x}px`, animationDelay: `${420 + i * 90}ms` }} />
+        ))}
+        <span className="earned-page">
+          <ModePage palette={palette} font={font} book={t("bible.books.john")} chapter={t("bible.chapterN", { n: PREVIEW_CHAPTER })} />
+        </span>
+      </div>
+      <p className="earned-eyebrow">{t("settings.paletteEarnedRow")}</p>
+      <h2 className="earned-title">{t("earn.yours", { name })}</h2>
+      <p className="earned-line">{t(palette === "councils" ? "earn.councilsDone" : "earn.cappadocianDone")}</p>
+      {wearing ? (
+        <p className="earned-wearing">
+          <Check size={16} strokeWidth={2.4} />
+          {t("earn.wearing")}
+        </p>
+      ) : (
+        <button type="button" onClick={() => pick(palette)} className="earned-wear tap-press">
+          {t("earn.wear")}
+        </button>
+      )}
+      {/* Plus is never promised to every reader. */}
+      {locked && !wearing ? <p className="earned-plus">{t("settings.palettePlusNote")}</p> : null}
+    </section>
+  );
+}
