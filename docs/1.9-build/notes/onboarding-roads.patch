@@ -0,0 +1,97 @@
+import { describe, expect, it } from "vitest";
+
+import { trackEventSchema } from "@/lib/security/schemas";
+
+import { AB_SENDING, AB_TESTS, abWord, abWords, registryFaults, runningTest, type AbTest } from "../tests";
+
+// The registry of tests (1.9; docs/1.9-build/notes/onboarding-fable.md, 4).
+
+const test = (o: Partial<AbTest> = {}): AbTest => ({
+  id: "day1-guided",
+  surface: "onboarding",
+  arms: ["a", "b"],
+  share: 1,
+  begins: "2026-12-07",
+  ends: "2026-12-27",
+  outcome: "back on day 7",
+  guard: "back on day 30",
+  needs: 1100,
+  ...o,
+});
+
+describe("the tests Purify runs", () => {
+  it("are none, and nothing leaves a device, until the owner agrees the privacy page's sentence", () => {
+    expect(AB_TESTS).toEqual([]);
+    expect(AB_SENDING).toBe(false);
+  });
+
+  it("are a registry with nothing wrong in it", () => {
+    expect(registryFaults(AB_TESTS)).toEqual([]);
+  });
+
+  it("may only send what the server's closed list takes", () => {
+    // A running test whose words the server refuses would count nothing and
+    // say so nowhere. Adding a test means adding its member to
+    // trackEventSchema in the same change (the head of ../tests.ts).
+    for (const t of AB_TESTS) {
+      for (const arm of t.arms) {
+        const row = { name: "ab_exposed", props: { test: t.id, arm, platform: "ios" } };
+        expect(trackEventSchema.safeParse(row).success, abWord(t, arm)).toBe(true);
+      }
+    }
+    // And while none runs, the server takes no such row at all.
+    if (AB_TESTS.length === 0) {
+      expect(trackEventSchema.safeParse({ name: "ab_exposed", props: { test: "x", arm: "a", platform: "ios" } }).success).toBe(false);
+    }
+  });
+});
+
+describe("what a registry entry must say", () => {
+  it("passes one that names its outcome, its guard, its readers and its last day", () => {
+    expect(registryFaults([test()])).toEqual([]);
+  });
+
+  it("refuses one with no outcome, no guard, no end, too few readers or a share of nobody", () => {
+    expect(registryFaults([test({ outcome: " " })]).join()).toContain("the one outcome");
+    expect(registryFaults([test({ guard: "" })]).join()).toContain("must not fall");
+    expect(registryFaults([test({ ends: "" })]).join()).toContain("a first and a last day");
+    expect(registryFaults([test({ ends: "2026-12-01" })]).join()).toContain("in order");
+    expect(registryFaults([test({ needs: 12 })]).join()).toContain("how many readers");
+    expect(registryFaults([test({ share: 0 })]).join()).toContain("share");
+    expect(registryFaults([test({ share: 1.5 })]).join()).toContain("share");
+  });
+
+  it("refuses an id or an arm that could hold more than a short word", () => {
+    expect(registryFaults([test({ id: "Day One!" })]).join()).toContain("an id is");
+    expect(registryFaults([test({ arms: ["a"] })]).join()).toContain("two to four arms");
+    expect(registryFaults([test({ arms: ["a", "a"] })]).join()).toContain("each arm named once");
+    expect(registryFaults([test({ arms: ["a", "reader-0000-4000-8000"] })]).join()).toContain("is a short word");
+    expect(registryFaults([test(), test()]).join()).toContain("used once");
+  });
+
+  it("refuses two tests on one surface at the same time, and allows them one after the other or on two surfaces", () => {
+    const second = test({ id: "door-led", begins: "2026-12-20", ends: "2027-01-10" });
+    expect(registryFaults([test(), second]).join()).toContain("at the same time");
+    expect(registryFaults([test(), test({ id: "door-led", begins: "2026-12-28", ends: "2027-01-17" })])).toEqual([]);
+    expect(registryFaults([test(), test({ id: "plus-card", surface: "plus" })])).toEqual([]);
+  });
+});
+
+describe("which test is running", () => {
+  const tests = [test(), test({ id: "plus-card", surface: "plus", begins: "2026-12-14", ends: "2027-01-03" })];
+
+  it("is the one whose days hold today, on its own surface", () => {
+    expect(runningTest("onboarding", "2026-12-06", tests)).toBeNull();
+    expect(runningTest("onboarding", "2026-12-07", tests)?.id).toBe("day1-guided");
+    expect(runningTest("onboarding", "2026-12-27", tests)?.id).toBe("day1-guided");
+    expect(runningTest("onboarding", "2026-12-28", tests)).toBeNull();
+    expect(runningTest("plus", "2026-12-20", tests)?.id).toBe("plus-card");
+    expect(runningTest("plus", "2026-12-07", tests)).toBeNull();
+  });
+
+  it("names a test and its arm in one word, and lists every word it can say", () => {
+    expect(abWord(test(), "b")).toBe("day1-guided:b");
+    expect(abWords(tests)).toEqual(["day1-guided:a", "day1-guided:b", "plus-card:a", "plus-card:b"]);
+    expect(abWords()).toEqual([]);
+  });
+});
diff --git a/lib/ab/assign.ts b/lib/ab/assign.ts
new file mode 100644
index 00000000..727af305
--- /dev/null
+++ b/lib/ab/assign.ts
@@ -0,0 +1,66 @@
+// Which version of a test a device shows (1.9): decided on the device, from
+// a number that never leaves it (docs/1.9-build/notes/onboarding-fable.md,
+// 4.1).
+//
+// The device draws a random seed once and keeps it. Its arm in a test is
+// worked out from the seed and the test's id, so the same device always
+// shows the same version of a test, and its arm in one test says nothing of
+// its arm in another. The seed is not sent, not copied to an account, and is
+// no field of any event: the server's closed list has nowhere to put it.
+//
+// Pure but for readSeed, so the rule is tested directly
+// (lib/ab/__tests__/assign.test.ts).
+
+import type { AbTest } from "./tests";
+
+const SEED_KEY = "purify:ab.seed";
+
+/** FNV-1a over the seed and a word, as a number from 0 up to 1. */
+export function fraction(seed: string, word: string): number {
+  let h = 0x811c9dc5;
+  const s = `${seed}/${word}`;
+  for (let i = 0; i < s.length; i++) {
+    h ^= s.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  // A last stir, so words that differ by one letter land far apart.
+  h ^= h >>> 16;
+  h = Math.imul(h, 0x85ebca6b);
+  h ^= h >>> 13;
+  return (h >>> 0) / 0x1_0000_0000;
+}
+
+/**
+ * The device's arm in a test, or null when it is not in the test at all
+ * (outside the test's share). Two draws from the one seed: whether it is in,
+ * and which arm, so widening a test's share never moves a device that was
+ * already in from one arm to another.
+ */
+export function armOf(test: Pick<AbTest, "id" | "arms" | "share">, seed: string): string | null {
+  if (!seed || fraction(seed, `${test.id}#in`) >= test.share) return null;
+  return test.arms[Math.floor(fraction(seed, `${test.id}#arm`) * test.arms.length)] ?? test.arms[0];
+}
+
+function newSeed(): string {
+  try {
+    const n = new Uint32Array(2);
+    globalThis.crypto.getRandomValues(n);
+    return `${n[0].toString(36)}${n[1].toString(36)}`;
+  } catch {
+    return `${Math.random().toString(36).slice(2)}${Math.random().toString(36).slice(2)}`;
+  }
+}
+
+/** The device's seed, drawn the first time it is asked for. Empty where nothing can be kept: such a device is in no test. */
+export function readSeed(): string {
+  if (typeof window === "undefined") return "";
+  try {
+    const kept = window.localStorage.getItem(SEED_KEY);
+    if (kept) return kept;
+    const seed = newSeed();
+    window.localStorage.setItem(SEED_KEY, seed);
+    return seed;
+  } catch {
+    return "";
+  }
+}
diff --git a/lib/ab/device.ts b/lib/ab/device.ts
new file mode 100644
index 00000000..4dd5ba61
--- /dev/null
+++ b/lib/ab/device.ts
@@ -0,0 +1,92 @@
+// A test on this device (1.9): its arm, and saying once that it was shown
+// (docs/1.9-build/notes/onboarding-fable.md, 4.1 and 4.2).
+//
+// Who is never in a test: automation, a device the admin has been opened
+// on, a device in Testers mode (lib/onboarding/count.ts, countingAllowed):
+// the same devices whose visits are never counted. In Testers mode an admin
+// picks the arm to look at instead (pickArm), and it is said to nobody.
+//
+// NOTHING IS SENT while AB_SENDING is off (./tests.ts), and no test is
+// running: this file is the whole of the device's part, ready and silent.
+
+import { apiFetch } from "@/lib/api/client";
+import { countPlatform, countingAllowed } from "@/lib/onboarding/count";
+import { utcDay } from "@/lib/onboarding/counting";
+import { isTesting } from "@/lib/onboarding/testing";
+
+import { armOf, readSeed } from "./assign";
+import { AB_SENDING, AB_TESTS, abWord, runningTest, type AbSurface, type AbTest } from "./tests";
+
+const EXPOSED_KEY = "purify:ab.exposed"; // JSON array of test ids already said
+const PICK_KEY = "purify:ab.pick"; // Testers mode: JSON { [test id]: arm }
+
+function readJson<T>(key: string, fallback: T): T {
+  try {
+    return (JSON.parse(window.localStorage.getItem(key) ?? "null") as T | null) ?? fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+/** Testers mode: the arm an admin chose to look at. Kept on the device, said to nobody. */
+export function pickArm(testId: string, arm: string | null): void {
+  try {
+    const picks = readJson<Record<string, string>>(PICK_KEY, {});
+    if (arm) picks[testId] = arm;
+    else delete picks[testId];
+    window.localStorage.setItem(PICK_KEY, JSON.stringify(picks));
+  } catch {
+    /* nothing kept: the device shows its own arm */
+  }
+}
+
+/**
+ * The version this device shows on a surface today: the running test and
+ * its arm, or null when no test is running there, the device is outside the
+ * test's share, or it is a device that is never in a test.
+ */
+export function armHere(surface: AbSurface, tests: readonly AbTest[] = AB_TESTS): { test: AbTest; arm: string } | null {
+  if (typeof window === "undefined") return null;
+  const test = runningTest(surface, utcDay(new Date()), tests);
+  if (!test) return null;
+  if (isTesting()) {
+    const picked = readJson<Record<string, string>>(PICK_KEY, {})[test.id];
+    return picked && test.arms.includes(picked) ? { test, arm: picked } : null;
+  }
+  if (!countingAllowed()) return null;
+  const arm = armOf(test, readSeed());
+  return arm ? { test, arm } : null;
+}
+
+/** The word an outcome row carries for this device on a surface ("day1-guided:b"), or undefined. */
+export function abWordHere(surface: AbSurface, tests: readonly AbTest[] = AB_TESTS): string | undefined {
+  if (!AB_SENDING || isTesting()) return undefined;
+  const here = armHere(surface, tests);
+  return here ? abWord(here.test, here.arm) : undefined;
+}
+
+/**
+ * Say, once for this device, that the screen that differs was shown: the
+ * test, the arm, the kind of device and nothing else. Call it where the
+ * screen is drawn, never where the arm is worked out, so a device that was
+ * assigned and never reached the screen is not counted as having seen it.
+ */
+export function exposed(surface: AbSurface, tests: readonly AbTest[] = AB_TESTS): void {
+  if (!AB_SENDING || typeof window === "undefined" || isTesting()) return;
+  const here = armHere(surface, tests);
+  if (!here) return;
+  const said = readJson<string[]>(EXPOSED_KEY, []);
+  if (said.includes(here.test.id)) return;
+  // Marked before it is sent: a device that cannot keep the mark says nothing, rather than saying it on every visit.
+  try {
+    window.localStorage.setItem(EXPOSED_KEY, JSON.stringify([...said, here.test.id]));
+  } catch {
+    return;
+  }
+  void apiFetch("/api/track/event", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ name: "ab_exposed", props: { test: here.test.id, arm: here.arm, platform: countPlatform() } }),
+    keepalive: true,
+  }).catch(() => {});
+}
diff --git a/lib/ab/size.ts b/lib/ab/size.ts
new file mode 100644
index 00000000..4d86310e
--- /dev/null
+++ b/lib/ab/size.ts
@@ -0,0 +1,15 @@
+// How many readers a test needs (1.9; docs/1.9-build/notes/onboarding-fable.md,
+// 4.3). A test names this number before it starts (./tests.ts, `needs`), so
+// nobody stops one early because it looks good on a Wednesday.
+
+/**
+ * Readers per arm to tell a rate of `from` from a rate of `to`, at the usual
+ * 5% threshold (two-sided) with 80% power: the normal approximation for two
+ * proportions. With Purify's numbers only a large difference is findable,
+ * which is the point of asking before a test is written.
+ */
+export function readersPerArm(from: number, to: number): number {
+  if (!(from > 0 && from < 1 && to > 0 && to < 1) || from === to) return Infinity;
+  const z = 1.959964 + 0.841621;
+  return Math.ceil((z * z * (from * (1 - from) + to * (1 - to))) / (from - to) ** 2);
+}
diff --git a/lib/ab/summary.ts b/lib/ab/summary.ts
new file mode 100644
index 00000000..2459f087
--- /dev/null
+++ b/lib/ab/summary.ts
@@ -0,0 +1,61 @@
+// A test's counts, summed for the admin (1.9;
+// docs/1.9-build/notes/onboarding-fable.md, 4.2). Pure, so the sums and the
+// small-cell rule are tested directly (lib/ab/__tests__/summary.test.ts).
+//
+// Every number is a total of rows that hold no reader: an exposure
+// (`ab_exposed`, once a device, when the screen that differs was really
+// shown) and the outcome rows that carry the test's word.
+
+import { abWord, type AbTest } from "./tests";
+
+/**
+ * A cell smaller than this is not shown. "Three readers in arm B came back"
+ * is close to a description of three people, and is no finding either.
+ */
+export const SMALLEST_CELL = 20;
+
+export type AbRow = { name: string; props: Record<string, unknown> };
+
+export type ArmSummary = {
+  arm: string;
+  /** Devices shown this version, or null while the cell is too small to show. */
+  exposed: number | null;
+  /** Of them, how many reached the outcome; null while either cell is too small. */
+  reached: number | null;
+  /** reached / exposed, or null. */
+  rate: number | null;
+  /** Whether the arm has the readers the test said it needs. */
+  enough: boolean;
+};
+
+/**
+ * One test, arm by arm. `isOutcome` says which rows are the outcome the
+ * test is judged by (a finish, a return on day 7), since the registry names
+ * it in words for the owner and the caller knows the event.
+ */
+export function summarizeTest(test: AbTest, rows: readonly AbRow[], isOutcome: (row: AbRow) => boolean): ArmSummary[] {
+  return test.arms.map((arm) => {
+    const word = abWord(test, arm);
+    let exposed = 0;
+    let reached = 0;
+    for (const row of rows) {
+      if (row.name === "ab_exposed") {
+        if (row.props.test === test.id && row.props.arm === arm) exposed++;
+      } else if (row.props.ab === word && isOutcome(row)) reached++;
+    }
+    const shown = exposed >= SMALLEST_CELL;
+    const both = shown && reached >= SMALLEST_CELL;
+    return {
+      arm,
+      exposed: shown ? exposed : null,
+      reached: both ? reached : null,
+      rate: both ? reached / exposed : null,
+      enough: exposed >= test.needs,
+    };
+  });
+}
+
+/** Whether a test may be read yet: its last day is past, and every arm has the readers it said it needs. */
+export function readable(test: AbTest, arms: readonly ArmSummary[], today: string): boolean {
+  return today > test.ends && arms.every((a) => a.enough);
+}
diff --git a/lib/ab/tests.ts b/lib/ab/tests.ts
new file mode 100644
index 00000000..f47901bc
--- /dev/null
+++ b/lib/ab/tests.ts
@@ -0,0 +1,104 @@
+// The tests Purify runs: one file, in the repository (1.9). The why and the
+// rules are docs/1.9-build/notes/onboarding-fable.md, section 4.
+//
+// A test is added, changed and ended by a commit here, so each is reviewed
+// like code and there is a record of what ran and when. No dashboard decides
+// what a reader sees.
+//
+// NONE IS RUNNING. The list is empty and the sender is off (AB_SENDING), on
+// the owner's frame of 2026-11-10: the system is built, and no test runs
+// until he has agreed its sentence on the privacy page (his question 112).
+//
+// To run one, in a single change:
+//   1. its entry in AB_TESTS below, with the one outcome it is judged by, the
+//      number that must not fall, how many readers it needs and its last day;
+//   2. its words on the server's closed list (lib/security/schemas.ts): the
+//      `ab_exposed` event and the optional `ab` word on the rows that carry
+//      an outcome. lib/ab/__tests__/tests.test.ts refuses a running test the
+//      server would not take;
+//   3. the sentence on /privacy, and AB_SENDING turned on.
+//
+// What may be tested: two honest versions of the same screen. Never the
+// paywall of a reader who named a need, never a countdown, scarcity or a
+// subscriber count (components/billing/UpgradeModal.tsx), never a
+// notification that puts a clock on the reader (lib/push/doctrine.ts).
+
+/** Where a test lives. A device is in at most one test on each surface at a time. */
+export type AbSurface = "onboarding" | "plus";
+export const AB_SURFACES: readonly AbSurface[] = ["onboarding", "plus"];
+
+export type AbTest = {
+  /** A short name: lower-case letters, digits and dashes. Never reused for another test. */
+  id: string;
+  surface: AbSurface;
+  /** The versions, the first of them Purify as it is. Two to four short words. */
+  arms: readonly string[];
+  /** The share of devices in the test, above 0 and up to 1. The rest see Purify as it is and are not counted in it. */
+  share: number;
+  /** First and last day, YYYY-MM-DD (UTC). Whole weeks: a Sunday's readers are not a Tuesday's. */
+  begins: string;
+  ends: string;
+  /** The one count the test is judged by, decided before it starts. */
+  outcome: string;
+  /** The count that must not fall: a change that sells more and keeps fewer loses. */
+  guard: string;
+  /** Readers each arm needs before the result means anything (./size.ts, readersPerArm). */
+  needs: number;
+};
+
+/** Nothing is running. See the head of this file before adding one. */
+export const AB_TESTS: readonly AbTest[] = [];
+
+/**
+ * Whether an exposure or an arm may leave a device. Off until the owner has
+ * agreed the privacy page's sentence for tests. While it is off a device
+ * still works out its arm (so a build can be walked), and says nothing.
+ */
+export const AB_SENDING = false;
+
+const ID = /^[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?$/;
+const DAY = /^\d{4}-\d{2}-\d{2}$/;
+
+/** What is wrong with a registry, in plain words; empty when nothing is. */
+export function registryFaults(tests: readonly AbTest[]): string[] {
+  const faults: string[] = [];
+  const seen = new Set<string>();
+  for (const t of tests) {
+    const at = `"${t.id}"`;
+    if (!ID.test(t.id)) faults.push(`${at}: an id is lower-case letters, digits and dashes, 24 at most`);
+    if (seen.has(t.id)) faults.push(`${at}: an id is used once`);
+    seen.add(t.id);
+    if (t.arms.length < 2 || t.arms.length > 4) faults.push(`${at}: two to four arms`);
+    if (new Set(t.arms).size !== t.arms.length) faults.push(`${at}: each arm named once`);
+    for (const arm of t.arms) if (!ID.test(arm) || arm.length > 12) faults.push(`${at}: arm "${arm}" is a short word`);
+    if (!(t.share > 0 && t.share <= 1)) faults.push(`${at}: share is above 0 and up to 1`);
+    if (!DAY.test(t.begins) || !DAY.test(t.ends) || t.ends < t.begins) faults.push(`${at}: a first and a last day, in order`);
+    if (!t.outcome.trim()) faults.push(`${at}: the one outcome it is judged by`);
+    if (!t.guard.trim()) faults.push(`${at}: the count that must not fall`);
+    if (!(Number.isInteger(t.needs) && t.needs >= 100)) faults.push(`${at}: how many readers each arm needs, a hundred at least`);
+  }
+  // One test on a surface at a time: a row carries one test's word, never two.
+  for (const a of tests) {
+    for (const b of tests) {
+      if (a.id < b.id && a.surface === b.surface && a.begins <= b.ends && b.begins <= a.ends) {
+        faults.push(`"${a.id}" and "${b.id}" run on ${a.surface} at the same time`);
+      }
+    }
+  }
+  return faults;
+}
+
+/** The test running on a surface on a day (YYYY-MM-DD, UTC), if any. */
+export function runningTest(surface: AbSurface, day: string, tests: readonly AbTest[] = AB_TESTS): AbTest | null {
+  return tests.find((t) => t.surface === surface && t.begins <= day && day <= t.ends) ?? null;
+}
+
+/** A test and an arm as one word, the only form in which either leaves a device: "day1-guided:b". */
+export function abWord(test: Pick<AbTest, "id">, arm: string): string {
+  return `${test.id}:${arm}`;
+}
+
+/** Every word the registry can say: the closed list the server takes. */
+export function abWords(tests: readonly AbTest[] = AB_TESTS): string[] {
+  return tests.flatMap((t) => t.arms.map((arm) => abWord(t, arm)));
+}
