+function Glide({ open, children }: { open: boolean; children: ReactNode }) {
+  return (
+    <div
+      aria-hidden={open ? undefined : true}
+      inert={!open}
+      className={cn(
+        "grid motion-safe:transition-[grid-template-rows,opacity] motion-safe:duration-300 motion-safe:ease-house",
