diff --git a/lib/streak/__tests__/streakPrepaint.test.ts b/lib/streak/__tests__/streakPrepaint.test.ts
new file mode 100644
index 00000000..504ba3f3
--- /dev/null
+++ b/lib/streak/__tests__/streakPrepaint.test.ts
@@ -0,0 +1,49 @@
+import vm from "node:vm";
+import { describe, expect, it } from "vitest";
+
+import { STREAK_PREPAINT } from "../streakPrepaint";
+
+/** Run the pre-paint string the way the browser does, over a stored device, and say whether it set data-kept. */
+function kept(stored: Record<string, string>, throws = false): boolean {
+  let set = false;
+  const keys = Object.keys(stored);
+  const localStorage = {
+    get length() {
+      if (throws) throw new Error("blocked");
+      return keys.length;
+    },
+    key: (i: number) => keys[i] ?? null,
+    getItem: (k: string) => (k in stored ? stored[k] : null),
+  };
+  const sandbox: Record<string, unknown> = {
+    localStorage,
+    document: { documentElement: { setAttribute: (k: string) => k === "data-kept" && (set = true) } },
+  };
+  sandbox.window = sandbox;
+  vm.runInNewContext(STREAK_PREPAINT, sandbox);
+  return set;
+}
+
+describe("the streak pre-paint (1.9, no zero as a first sight)", () => {
+  it("marks a device that holds a kept day, in any rule's ledger", () => {
+    expect(kept({ "purify.prayers.morning.dates": JSON.stringify(["2026-11-12"]) })).toBe(true);
+    expect(kept({ "purify.locale": "en", "purify.prayers.mine-evening.dates": JSON.stringify(["2026-11-01", "2026-11-02"]) })).toBe(true);
+  });
+
+  it("marks the legacy count the ledgers replaced, and the server's last answer with a best", () => {
+    expect(kept({ "purify.prayers.evening.streak": "3", "purify.prayers.evening.last": "20261112" })).toBe(true);
+    expect(kept({ "purify.streak.server": JSON.stringify({ state: "ok", best: 5, current: 0, strip: [] }) })).toBe(true);
+  });
+
+  it("leaves a new reader unmarked: nothing stored, empty ledgers, a zero best", () => {
+    expect(kept({})).toBe(false);
+    expect(kept({ "purify.prayers.morning.dates": "[]", "purify:onboarded": "1" })).toBe(false);
+    expect(kept({ "purify.prayers.morning.streak": "0" })).toBe(false);
+    expect(kept({ "purify.streak.server": JSON.stringify({ state: "ok", best: 0, current: 0, strip: [] }) })).toBe(false);
+    expect(kept({ "purify.prayers.morning.dates": "not json" })).toBe(false);
+  });
+
+  it("says nothing, and throws nothing, where storage is blocked", () => {
+    expect(kept({ "purify.prayers.morning.dates": JSON.stringify(["2026-11-12"]) }, true)).toBe(false);
+  });
+});
diff --git a/lib/streak/streakPrepaint.ts b/lib/streak/streakPrepaint.ts
new file mode 100644
index 00000000..048a3c08
--- /dev/null
+++ b/lib/streak/streakPrepaint.ts
@@ -0,0 +1,28 @@
+// A kept day, known before the first paint (1.9, the fifteen screens).
+//
+// Today's rope is drawn from the first day kept, never as "0 days" (no zero
+// as a first sight). Before the streak is read the row holds the rope's
+// height, so the cards under it do not jump when it lands; for a reader with
+// nothing kept that hold would stand and then close, a jump of its own. So
+// this sets `data-kept` on <html> before anything paints when the device
+// holds a kept day, and the hold (components/today/StreakRow.tsx) stands only
+// under it.
+//
+// What counts is what lib/streak/useStreak.ts reads: a day in any
+// `purify.prayers.<rule>.dates` list, the legacy `.streak` count those lists
+// replaced (lib/prayers/storage.ts, readPrayedDates), or the server's last
+// answer with a best above zero (`purify.streak.server`). No imports, so the
+// string depends on nothing else's bundling order, as
+// lib/platform/storePrepaint.ts; lib/streak/__tests__/streakPrepaint.test.ts
+// runs it against a stored device.
+
+export const STREAK_PREPAINT = [
+  "(function(){try{",
+  "var s=window.localStorage,k=false,i,n,v,a;",
+  "for(i=0;i<s.length&&!k;i++){n=s.key(i)||'';",
+  "if(/^purify\\.prayers\\..+\\.dates$/.test(n)){v=s.getItem(n);try{a=JSON.parse(v);k=Array.isArray(a)&&a.length>0;}catch(e){}}",
+  "else if(/^purify\\.prayers\\..+\\.streak$/.test(n)){k=(parseInt(s.getItem(n)||'0',10)||0)>0;}",
+  "else if(n==='purify.streak.server'){try{a=JSON.parse(s.getItem(n)||'null');k=!!a&&a.state==='ok'&&(a.best||0)>0;}catch(e){}}}",
+  "if(k)document.documentElement.setAttribute('data-kept','');",
+  "}catch(e){}})();",
+].join("");
