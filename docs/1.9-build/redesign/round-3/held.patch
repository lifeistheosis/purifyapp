new file mode 100644
index 000000000..eeb1a2057
--- /dev/null
+++ b/lib/bible/commentaryHint.ts
@@ -0,0 +1,61 @@
+"use client";
+
+import { useEffect, useSyncExternalStore } from "react";
+
+/**
+ * What the red marks on a chapter mean, said once (1.9, the fifteen screens'
+ * round 3). "Read with the Fathers. Verse numbers shown in red with a dot
+ * have patristic commentary..." stood over the first verse of every chapter
+ * that has commentary, in bold and red, for every reader on every visit
+ * (fresh eyes: "a standing instruction"). It is said on the first such
+ * chapter a reader opens, as one quiet line, and then it is gone from the
+ * page: the device remembers. The same words are kept in the reader's •••
+ * sheet (components/bible/ReaderMoreSheet.tsx).
+ *
+ * On the device only, as the reader's other small marks are: nothing to sync
+ * and nothing to lose. A device that will not keep it (storage blocked) is
+ * not shown the line at all, rather than shown it on every chapter.
+ *
+ * The page drawn into the export, and the website's first drawing, have no
+ * line: it comes with the device's answer, so no reader who has seen it ever
+ * has the first verse move under their eyes.
+ */
+export const COMMENTARY_HINT_KEY = "purify:bible:commentary-hint-seen";
+
+/** The chapter the line is being shown on, for as long as that chapter is open. */
+let showingOn: string | null = null;
+
+function seen(): boolean {
+  try {
+    return window.localStorage.getItem(COMMENTARY_HINT_KEY) !== null;
+  } catch {
+    return true;
+  }
+}
+
+const subscribe = () => () => {};
+
+/**
+ * Whether this chapter shows the line: it has commentary to mark (`applies`),
+ * and the reader has not been told, or is being told here.
+ */
+export function useCommentaryHint(chapter: string, applies: boolean): boolean {
+  const show = useSyncExternalStore(
+    subscribe,
+    () => applies && (showingOn === chapter || (showingOn === null && !seen())),
+    () => false,
+  );
+  useEffect(() => {
+    if (!show) return;
+    showingOn = chapter;
+    try {
+      window.localStorage.setItem(COMMENTARY_HINT_KEY, "1");
+    } catch {
+      /* not kept: seen() says so, and the line is not shown */
+    }
+    return () => {
+      if (showingOn === chapter) showingOn = null;
+    };
+  }, [show, chapter]);
+  return show;
+}
