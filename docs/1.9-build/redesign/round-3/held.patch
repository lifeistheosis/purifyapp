+/**
+ * The recorded voices (build 98 note 1; his word of 2026-11-15, "1 (3 for
+ * premium) 4 5 6"): Heart, every reader's and free, then three for Plus,
+ * Emma, Michael and Fenrir, each recorded ahead as Heart is and downloaded by
+ * choice. They read English; the other languages keep the phone's own voice
+ * (lib/listen/speech/voices.ts), which English no longer offers.
+ *
+ * A PROPOSAL, for the Voice sheet's stills (Fable round 3). What stands in:
+ *
+ *  - Only Heart has recordings (the New Testament, lib/readAloud/chapters.ts).
+ *    A Plus voice chosen is kept as the reader's choice and Heart goes on
+ *    reading until that voice's recordings exist (voiceChoice.ts, voiceToUse).
+ *  - Heart's sample is real: the first five verses of John in its own
+ *    recording, the text the seven samples of 2026-11-15 read. The other
+ *    three samples are named where docs/1.9-build/notes/voices-fable.md puts
+ *    them (the public part of the bucket) and are not there yet; the files
+ *    made that day are in docs/1.9-build/notes/build-98/voice-samples/.
+ *  - No size is given for a voice: what a download of one holds (a Testament,
+ *    a book, the whole) is not decided, so the app does not know it. The
+ *    download itself stands in too (voiceKeep.ts).
+ *  - The sheet marks the reader's choice among the four, Heart until they
+ *    choose, as if every English text had its recording in each. Where Heart
+ *    has none yet (the Old Testament, a life) the phone's voice still reads,
+ *    as does a phone's voice chosen in English before this (voiceToUse is
+ *    left as it was but for the line that keeps a Plus voice from reading as
+ *    "gone").
+ *  - Heart's word is "Included", not "in the app": its recordings play from
+ *    the website, and a book of them is kept on the phone by Listen offline.
+ */
+
+/** The recorded voice every reader has. */
+export const HEART = "heart";
+
+/** Where a voice's sample is: a recording, and the stretch of it that is played. */
+export type VoiceSample = { src: string; from: number; to: number };
+
+export type RecordedVoice = {
+  id: string;
+  /** A name the catalogue translates (Heart's), or the name as it is everywhere. */
+  nameKey?: string;
+  name?: string;
+  /** Who the voice is, in the reader's words. */
+  aboutKey: string;
+  /** For Plus: shown to every reader with the Plus mark, chosen and downloaded with Plus. */
+  plus: boolean;
+  sample: VoiceSample;
+};
+
+const SAMPLES = "https://audio.purifyapp.net/voices/samples";
+
+export const RECORDED_VOICES: readonly RecordedVoice[] = [
+  {
+    id: HEART,
+    nameKey: "player.voice.heart",
+    aboutKey: "player.voice.usWoman",
+    plus: false,
+    // John 1:1-5, as public/audio/read/john/1.json times it.
+    sample: { src: "https://audio.purifyapp.net/read/john/1.mp3", from: 0, to: 20.1 },
+  },
+  { id: "emma", name: "Emma", aboutKey: "player.voice.ukWoman", plus: true, sample: { src: `${SAMPLES}/emma.mp3`, from: 0, to: 20 } },
+  { id: "michael", name: "Michael", aboutKey: "player.voice.usMan", plus: true, sample: { src: `${SAMPLES}/michael.mp3`, from: 0, to: 20 } },
+  { id: "fenrir", name: "Fenrir", aboutKey: "player.voice.usMan", plus: true, sample: { src: `${SAMPLES}/fenrir.mp3`, from: 0, to: 20 } },
+];
+
+function base(lang: string): string {
+  return lang.toLowerCase().split(/[-_]/)[0];
+}
+
+/** The recorded voices that read a language: the four in English, none elsewhere. */
+export function recordedVoicesFor(lang: string): readonly RecordedVoice[] {
+  return base(lang) === "en" ? RECORDED_VOICES : [];
+}
+
+export function recordedVoice(id: string | null): RecordedVoice | null {
+  return RECORDED_VOICES.find((v) => v.id === id) ?? null;
+}
