+"use client";
+
+import { useSyncExternalStore } from "react";
+
+/**
+ * Which recorded voices are on this phone, and which are on their way (build
+ * 97 note 5, his word of 2026-11-14: "if it's already downloaded it should be
+ * a distinct design so signify a voice that is downloaded and isn't
+ * downloaded"). Kept on the device (purify:listen.voicesKept), as the saved
+ * chapters (lib/readAloud/offline.ts) and the downloaded Bibles are, so the
+ * Voice sheet draws each voice's state at once, without asking the phone.
+ *
+ * A PROPOSAL (Fable round 3), and what stands in is the download itself. No
+ * recording of a Plus voice exists, and what a download of a voice holds is
+ * not decided (lib/listen/speech/recorded.ts). So `keepVoice` only writes
+ * down that the reader asked: the voice stands as "coming" at the share it
+ * has until the reader stops it, and nothing is fetched. What is real is the
+ * shape the sheet reads: on the phone, coming with a share, or neither. The
+ * work that fills it is lib/readAloud/saving.ts's, per voice: Wi-Fi first,
+ * going on by itself, Plus asked on the server.
+ */
+
+/** A voice on the phone, or on its way with the share that has come (0 to 1). */
+export type VoiceKept = { state: "kept" } | { state: "coming"; share: number };
+
+const KEY = "purify:listen.voicesKept";
+const NONE: Readonly<Record<string, VoiceKept>> = Object.freeze({});
+const listeners = new Set<() => void>();
+let cache: Readonly<Record<string, VoiceKept>> | null = null;
+
+function read(): Readonly<Record<string, VoiceKept>> {
+  if (cache) return cache;
+  const all: Record<string, VoiceKept> = {};
+  try {
+    const kept = JSON.parse(window.localStorage.getItem(KEY) ?? "{}") as unknown;
+    if (kept && typeof kept === "object") {
+      for (const [id, v] of Object.entries(kept as Record<string, { state?: unknown; share?: unknown }>)) {
+        if (v?.state === "kept") all[id] = { state: "kept" };
+        else if (v?.state === "coming") {
+          const share = typeof v.share === "number" && Number.isFinite(v.share) ? Math.min(1, Math.max(0, v.share)) : 0;
+          all[id] = { state: "coming", share };
+        }
+      }
+    }
+  } catch {
+    /* unreadable: nothing kept */
+  }
+  cache = all;
+  return cache;
+}
+
+function write(all: Record<string, VoiceKept>): void {
+  cache = all;
+  try {
+    window.localStorage.setItem(KEY, JSON.stringify(all));
+  } catch {
+    /* a full or private store: known for this session */
+  }
+  for (const l of listeners) l();
+}
+
+/** Every voice on the phone or on its way, by its id. */
+export function keptVoices(): Readonly<Record<string, VoiceKept>> {
+  return typeof window === "undefined" ? NONE : read();
+}
+
+export function useKeptVoices(): Readonly<Record<string, VoiceKept>> {
+  return useSyncExternalStore(
+    (l) => {
+      listeners.add(l);
+      return () => {
+        listeners.delete(l);
+      };
+    },
+    keptVoices,
+    () => NONE,
+  );
+}
+
+/** The reader asks for a voice on the phone (after Plus is asked). Stands in: see the head of this file. */
+export function keepVoice(id: string): void {
+  const all = read();
+  if (all[id]) return;
+  write({ ...all, [id]: { state: "coming", share: 0 } });
+}
+
+/** Stop a voice on its way: it is not on the phone, and can be asked for again. */
+export function stopKeepingVoice(id: string): void {
+  const all = read();
+  if (all[id]?.state !== "coming") return;
+  const next = { ...all };
+  delete next[id];
+  write(next);
+}
+
+/** For tests. */
+export function forgetKeptVoices(): void {
+  cache = null;
+}
