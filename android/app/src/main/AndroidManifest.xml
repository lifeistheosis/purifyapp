<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Purify uses no ads and no advertising ID. Strip the AD_ID permission
         that a transitive SDK might add, so the Play "advertising ID" answer
         can honestly be "No". -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Push: the channel MainActivity creates, and a status-bar icon
             drawn for it, so Firebase uses both when the app is closed. The
             launcher icon it used before shows as a plain disc up there. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="purify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_purify" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The app icon's shortcuts: hold the icon and the launcher
                 offers Morning prayers, Today's reading and Continue reading.
                 The list is res/xml/shortcuts.xml. It has to be declared
                 here, on the activity that carries the LAUNCHER filter. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Where a tapped shortcut lands first. Android starts a shortcut's
             activity in a task it has just emptied, so a shortcut pointed
             straight at MainActivity would close and reload the app every
             time one was used while it was open, and stop whatever was
             playing. This one shows nothing: it hands the address to
             MainActivity and goes. taskAffinity="" is what gives it a task
             of its own to be emptied, so the app's task is left alone.
             Not exported: the launcher starts a shortcut as the app itself,
             so nothing outside the app can reach this. -->
        <activity
            android:name=".ShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Home screen widgets (docs/WIDGETS.md). Each family is one receiver,
             listed in net.purifyapp.purify.widget.WidgetRefresh as well, which
             lib/widget/__tests__/androidContract.test.ts holds together. They
             ship inside this APK, so they read the prebaked day table straight
             from assets; what only the app knows arrives through the
             WidgetBridge plugin. exported=true because the launcher, another
             process, sends them the APPWIDGET_UPDATE broadcast.

             The Today family keeps the first widget's name, DayWidgetProvider,
             so a widget a reader already placed carries on as its first look. -->
        <receiver
            android:name=".DayWidgetProvider"
            android:label="@string/widget_today_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The device's idea of "today" can move without the midnight
                     alarm firing: a flight across a timezone, or the clock set
                     by hand. Without these a reader sees yesterday's saint. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_info" />
        </receiver>

        <!-- The other six families, each declared like the Today family and
             for the same reasons: Verse, Pray now, Streak, Countdown, My saint
             and Mosaic. -->
        <receiver
            android:name=".widget.VerseWidgetProvider"
            android:label="@string/widget_verse_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/verse_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayNowWidgetProvider"
            android:label="@string/widget_pray_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pray_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StreakWidgetProvider"
            android:label="@string/widget_streak_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetProvider"
            android:label="@string/widget_countdown_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MySaintWidgetProvider"
            android:label="@string/widget_mysaint_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mysaint_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MosaicWidgetProvider"
            android:label="@string/widget_mosaic_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mosaic_widget_info" />
        </receiver>

        <!-- The screen that asks which look a widget wears. The launcher
             opens it, so it is exported, and it answers only the configure
             action. -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on Android 13+ (API 33) for the push-notifications plugin to
         request and post notifications; the plugin manifest does not declare
         it, so it must be declared here or prayer reminders silently fail. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
