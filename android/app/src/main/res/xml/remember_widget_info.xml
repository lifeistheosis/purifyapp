<?xml version="1.0" encoding="utf-8"?>
<!--
  Remember the verse (1.9, docs/WIDGETS.md): one of the reader's saved verses
  a day, at its step, as the card on Today asks it. Four cells wide by
  default, as the Verse of the Day; two cells and up.

  updatePeriodMillis is 0 on purpose, as for every Purify widget: the
  provider sets its own alarm for the next change
  (net.purifyapp.purify.widget.WidgetClock).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_remember_description"
    android:previewImage="@drawable/widget_preview_remember"
    android:previewLayout="@layout/widget_remember_preview"
    android:initialLayout="@layout/widget_remember" />
