<?xml version="1.0" encoding="utf-8"?>
<!--
  The Today family's declaration (docs/WIDGETS.md). Two cells and up; four
  cells wide shows the date beside the saint.

  updatePeriodMillis is 0 ON PURPOSE. The system clamps it to 30 minutes at
  best and wakes the app to do it, which is wasteful for content that changes
  once a day at midnight. The provider sets its own alarm for the next local
  midnight instead (net.purifyapp.purify.widget.WidgetClock).

  The look (saint and fast, the week, rotating) is chosen on the configure
  screen. On Android 12 and newer the widget is placed with its first look
  and the screen opens from the widget's own settings
  (configuration_optional, reconfigurable); below that it opens on placing.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:configure="net.purifyapp.purify.widget.WidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:description="@string/widget_today_description"
    android:previewImage="@drawable/widget_preview_today"
    android:previewLayout="@layout/widget_today_day"
    android:initialLayout="@layout/widget_today_day" />
