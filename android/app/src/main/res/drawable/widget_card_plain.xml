<?xml version="1.0" encoding="utf-8"?>
<!-- The card without its edge, for a widget that draws its edge over it
     (the countdown, whose edge warms as the update nears). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_ground_top"
        android:centerColor="@color/widget_ground_mid"
        android:endColor="@color/widget_ground" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
