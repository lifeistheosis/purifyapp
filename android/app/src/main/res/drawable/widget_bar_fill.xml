<?xml version="1.0" encoding="utf-8"?>
<!-- How far the bar has run: the widget sets the picture's level, 0 to
     10000, and the round-ended fill is drawn that share of the width from the
     left, never shorter than its own 6dp, as the mock's bar is. -->
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/widget_bar_fill_shape"
    android:scaleGravity="start|center_vertical"
    android:scaleWidth="100%"
    android:useIntrinsicSizeAsMinimum="true" />
