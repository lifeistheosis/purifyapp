<?xml version="1.0" encoding="utf-8"?>
<!-- The card every widget sits on: the Verse of the Day card's own ground,
     lit from the top, with a hairline edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_ground_top"
        android:centerColor="@color/widget_ground_mid"
        android:endColor="@color/widget_ground" />
    <corners android:radius="@dimen/widget_radius" />
    <stroke android:width="1dp" android:color="@color/widget_line" />
</shape>
