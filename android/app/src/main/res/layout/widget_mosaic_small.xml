<?xml version="1.0" encoding="utf-8"?>
<!-- Mosaic, two cells (the mock's section 12): a Mosaic picture and, for
     the season, its greeting and line over the shaded foot. The cross and the
     lampada carry no words (MosaicWidgetProvider hides them). On Android 12
     and newer the picture is cut to the card's rounded corners. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/mosaic_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_edge_art"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/mosaic_words"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="13dp">
        <TextView
            android:id="@+id/mosaic_title"
            style="@style/WidgetArtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:maxLines="2" />
        <TextView
            android:id="@+id/mosaic_line"
            style="@style/WidgetArtMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
