<?xml version="1.0" encoding="utf-8"?>
<!-- Remember the verse at its last step, said from memory: no words to show,
     so the reference stands large in their place, and the card's line under
     it. Four cells and two. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="15dp"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/remember_eyebrow"
        style="@style/WidgetEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/remember_ref"
            style="@style/WidgetSerif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/remember_line"
            style="@style/WidgetMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/widget_soft"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
