<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of this family on Android 12 and newer:
     the mock's own drawing of it (res/drawable-nodpi/widget_preview_countdown,
     baked by scripts/emit-widget-art.mjs), scaled to the size the picker
     gives it. Older phones show the same picture through previewImage. -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/widget_preview_countdown"
    android:scaleType="fitCenter"
    android:importantForAccessibility="no" />
