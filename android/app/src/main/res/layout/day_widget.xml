<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately plain. A widget is read at a glance from a home screen that
  already has a wallpaper behind it, so this is the commemoration, the fast,
  and nothing else. Colours are literals rather than theme attributes because
  a widget renders in the launcher's process, where the app's theme does not
  apply.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/day_widget_background">

    <TextView
        android:id="@+id/widget_fast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#A3A3AC"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:id="@+id/widget_saint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp"
        android:textColor="#EAEAEC"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
