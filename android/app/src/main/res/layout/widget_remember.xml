<?xml version="1.0" encoding="utf-8"?>
<!-- Remember the verse, four cells (1.9, docs/WIDGETS.md, the `remember`
     entry): REMEMBER THE VERSE, the reference in the serif, the verse at its
     step (its longer words blank, or each word as its first letter), and the
     card's own line under it. At the last step there are no words, and the
     reference stands large in their place (widget_remember_memory). A verse
     answered today shows whole, with a check and when it comes back. The
     verse is set a step smaller before it is cut, as Verse of the Day's is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="15dp"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/remember_eyebrow"
        style="@style/WidgetEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/remember_ref"
        style="@style/WidgetSerif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="18sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/remember_words"
        style="@style/WidgetSerif"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:textStyle="normal"
        android:textSize="13sp"
        android:maxLines="4"
        android:lineSpacingMultiplier="1.08"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        tools:targetApi="o" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/remember_check"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_check"
            android:tint="@color/widget_soft"
            android:visibility="gone"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/remember_line"
            style="@style/WidgetMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_soft"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
