<?xml version="1.0" encoding="utf-8"?>
<!-- Verse of the Day on Mosaic art, four cells wide: the Minimal look's
     words (the cross, the verse, the reference) set low over the Mosaic
     picture of the hour, whose foot the art itself shades, as the mock sets
     words over its art (VerseWidgetProvider picks the picture). The words
     keep to the first seven tenths of the width, clear of the light in the
     picture's top right, and their size steps down with a long verse (the
     provider sets it). On Android 12 and newer the picture is cut to the
     card's rounded corners. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/verse_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_edge_art"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:orientation="vertical">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_cross_mark_light"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/verse_text"
                style="@style/WidgetArtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textStyle="normal"
                android:textSize="17sp"
                android:maxLines="3"
                android:lineSpacingMultiplier="1.05" />

            <LinearLayout
                android:id="@+id/verse_ref_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="1dp"
                    android:src="@color/widget_on_art_rule"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/verse_ref"
                    style="@style/WidgetRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/widget_on_art_soft"
                    android:shadowColor="@color/widget_art_shadow"
                    android:shadowDy="2"
                    android:shadowRadius="14" />
            </LinearLayout>

            <!-- TEMPORARY (lib/today/machineVerse.ts): the label a
                 machine-translated verse carries, shown only with one. -->
            <TextView
                android:id="@+id/verse_note"
                style="@style/WidgetMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="10sp"
                android:textColor="@color/widget_on_art_soft"
                android:shadowColor="@color/widget_art_shadow"
                android:shadowDy="2"
                android:shadowRadius="14"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="3" />
    </LinearLayout>
</FrameLayout>
