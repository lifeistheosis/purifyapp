# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fetcher tmp
.tmp/

# ingestion source cache (large public-domain raw texts; not shipped)
/scripts/.cache/

# Held-back ambience asset: 64MB MP3, over GitHubs recommended max.
# Will move to external hosting before launch; keep the file locally if
# desired but never commit it.
public/audio/ambience/valley.mp3

# Claude handoff brief (contains internal team commitments, Discord knowledge, roadmap).
# Local-only; never publish.
PURIFY_CLAUDE_HANDOFF.md

# Suggestions audit (contains Discord handles + message content; not for redistribution).
# Local-only living tracker.
SUGGESTIONS_AUDIT.md

# Homerun roadmap (contains strategic timing, v9.7-v10.0 plans, unannounced features).
# Local-only; never publish.
Homerun (v9.7-v10).md

# Discord review cursor + daily review log (contain handles + message content).
# Local-only; not for redistribution.
scripts/.discord-review-state.json
DISCORD_REVIEW_LOG.md

# Fable 5 operating brief (internal design + brand direction). Local-only.
FABLE5_BRIEF.md

# Fable 5 suggestions (internal audit findings + agent prompts). Local-only.
FABLE5_SUGGESTIONS.md

# v10 master scope (forum promises, unannounced features, monetization plan).
# Local-only; never publish.
V10-SCOPE.md

# Dogma & Exegesis raw thread pulls (Discord handles + long message bodies).
# Working material for the /theology section; not redistributed.
.dogma-audit/
dogma-scan.json

# Native signing material. The Android upload keystore and any Apple
# certificates/profiles must NEVER enter git; back them up outside the repo.
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
# The intermediate files from generating the Apple distribution certificate
# without a Mac (docs/IOS_BUILD_SETUP.md). The .key is the private half of the
# signing identity, and the .b64 is the whole .p12 in a form that does not look
# like a certificate to anyone skim-reading a diff, which is exactly why it
# needs naming here rather than relying on *.p12 above.
*.key
*.csr
*.p12.b64
distribution.pem
# Apple .p8 keys. Downloadable once each, and there is more than one kind:
# AuthKey_*.p8 is the App Store Connect API key that grants release automation,
# SubscriptionKey_*.p8 is the In-App Purchase key RevenueCat signs with, and
# APNs auth keys use no fixed prefix at all. Ignoring the whole extension rather
# than one prefix, because the prefix rule silently covered only the first kind.
*.p8

# Generated local-first content package (built at native build time)
.content-build/

# Generated content registries (emitted from TS at build time)
data/_generated/
.native-export-stash/
test-results/
.cache/
*.log

# Saint icons staged by scripts/fetch-saint-icons.mjs and not yet looked at.
# Deliberately outside public/, so an image cannot reach a reader by being
# downloaded: it reaches them by someone opening it and promoting it.
.icon-review/

# Generated Sign in with Apple client secret (a bearer credential, 6-month life).
# Regenerate with scripts/apple-client-secret.mjs
.apple-client-secret.jwt

# Impeccable design hook. config.json is shared and committed: it records which
# detector findings the owner has confirmed are intentional. The cache is
# per-machine scan state, and config.local.json holds per-developer overrides
# including the hook consent decision. Neither belongs in the repository.
.impeccable/hook.cache.json
.impeccable/config.local.json
.i18n-work/
