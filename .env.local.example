# Supabase
# Project URL, derived from your project ref (Settings → API in Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://avbqyvjgcrucjwevwixt.supabase.co

# Anon (public) key, safe to expose in the browser. Used by lib/supabase/client.ts and server.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key, SERVER ONLY. Bypasses RLS. Never import from a client component.
# Used by lib/supabase/admin.ts. If you commit this anywhere or paste it in chat, rotate it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Live View (/admin). Comma-separated emails allowed to view site
# analytics. Only signed-in users whose email is listed can open /admin.
ADMIN_EMAILS=you@example.com

# Licensed Bible translations via API.Bible (American Bible Society). SERVER
# ONLY. Without these the licensed translations stay off and the public-domain
# texts (KJV, Brenton LXX) are unaffected. Get the key + per-translation
# bibleId from your API.Bible account (scripture.api.bible).
BIBLE_API_KEY=your-api-bible-key
BIBLE_ID_NIV=api-bible-id-for-niv
BIBLE_ID_NKJV=api-bible-id-for-nkjv
BIBLE_ID_NLT=api-bible-id-for-nlt

# RevenueCat (Purify Plus subscriptions). Set these in the Render env, not here.
# Public SDK key for the Android app — used by lib/billing/revenuecat.ts to
# configure Purchases. Without it billingAvailable() is false and the paywall
# shows "not available to purchase". Use your Google Play app's PUBLIC key from
# RevenueCat → Project → API keys (normally prefixed `goog_`). A `test_…` key is
# the sandbox key — fine for beta testing, but real Play purchases need `goog_`.
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-android-sdk-key

# Public SDK key for RevenueCat Web Billing (optional; only if you sell on the
# website). Leave unset for the Android-only beta. Used by lib/billing/revenuecatWeb.ts.
NEXT_PUBLIC_REVENUECAT_WEB_KEY=

# SERVER ONLY shared secret guarding the webhook at /api/billing/revenuecat.
# Pick any long random string and set the SAME value as the Authorization header
# in RevenueCat → Integrations → Webhooks. This is NOT your RevenueCat secret
# (`sk_…`) API key — that key is not used anywhere in this app.
REVENUECAT_WEBHOOK_SECRET=a-long-random-string-you-choose

# ── Shop (EIKON marketplace, Phase 1) ────────────────────────────────────
# Master flag. Unset or 0 = every /shop route returns 404 and no shop UI
# entry points render, so the marketplace can sit merged-but-dark until
# suppliers and payments are connected. See docs/shop/PHASE1.md.
NEXT_PUBLIC_SHOP_ENABLED=

# Community: the Conversations feed on /community. Set to 1 once
# supabase/migrations/20260722_community.sql is applied (it IS, in production,
# verified 2026-07-27). Unset makes every /api/community/* route answer 404 and
# the Conversations panel render "The conversation is being prepared", which
# reads to a user as the whole Community tab being broken.
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time, so changing this on Render
# requires a redeploy, not a restart.
NEXT_PUBLIC_COMMUNITY_ENABLED=

# Prayer campaigns: the /campaigns board and its API. Same build-time caveat.
NEXT_PUBLIC_CAMPAIGNS_ENABLED=

# Checkout switch, independent of SHOP_ENABLED. Off = product pages show
# "Checkout opens soon" with a Notify Me action instead of a buy button.
# Turning it on requires the Stripe keys below.
SHOP_CHECKOUT_ENABLED=

# Stripe (SERVER ONLY, never NEXT_PUBLIC). Use test-mode keys (sk_test_…)
# until launch. Absent keys = checkout stays safely disabled regardless of
# SHOP_CHECKOUT_ENABLED.
STRIPE_SECRET_KEY=
# Signing secret for the webhook at /api/shop/stripe-webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=

# ── Prayer reminders (push) ──────────────────────────────────────────────
# Full walkthrough: docs/NATIVE_PUSH_SETUP.md
#
# Shared secret for the cron routes (/api/cron/push-deliver, bmc-snapshot).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set the SAME value in the Render env AND as a GitHub Actions repository
# secret, or .github/workflows/cron.yml cannot authenticate. In production the
# push route refuses to run when this is unset (it would otherwise be
# world-callable).
CRON_SECRET=

# Web Push / VAPID (website + PWA only; the native shell uses FCM/APNs).
# Generate the pair ONCE with:  npx web-push generate-vapid-keys
# Rotating it invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
# SERVER ONLY. If this ever lands in git history, rotate the pair.
VAPID_PRIVATE_KEY=
# Contact URI for push services, so they can reach you about a bad sender.
VAPID_SUBJECT=mailto:support@purifyapp.net
# The SAME string as VAPID_PUBLIC_KEY. The browser needs it at subscribe time,
# and NEXT_PUBLIC_ is the only prefix Next inlines into the client bundle.
# Until this is set, the onboarding reminders step silently does nothing.
NEXT_PUBLIC_VAPID_KEY=

# Android FCM service account, base64 of the Firebase JSON (SERVER ONLY):
#   base64 -w0 service-account.json
# The matching android/app/google-services.json goes in the repo, not here.
FCM_SERVICE_ACCOUNT_JSON=

# iOS APNs (only needed once the iOS app ships). See docs/NATIVE_PUSH_SETUP.md.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=net.purifyapp.purify
APNS_PRODUCTION=
