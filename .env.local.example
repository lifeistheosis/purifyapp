# Supabase
# Project URL — derived from your project ref (Settings → API in Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://avbqyvjgcrucjwevwixt.supabase.co

# Anon (public) key — safe to expose in the browser. Used by lib/supabase/client.ts and server.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Bypasses RLS. Never import from a client component.
# Used by lib/supabase/admin.ts. If you commit this anywhere or paste it in chat, rotate it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Live View (/admin). Comma-separated emails allowed to view site
# analytics. Only signed-in users whose email is listed can open /admin.
ADMIN_EMAILS=you@example.com

# Licensed Bible translations via API.Bible (American Bible Society). SERVER
# ONLY. Without these the licensed translations stay off and the public-domain
# texts (KJV, Brenton LXX) are unaffected. Get the key + per-translation
# bibleId from your API.Bible account (scripture.api.bible).
BIBLE_API_KEY=your-api-bible-key
BIBLE_ID_NIV=api-bible-id-for-niv
BIBLE_ID_NKJV=api-bible-id-for-nkjv
BIBLE_ID_NLT=api-bible-id-for-nlt
