{
  "v": 1,
  "durationSec": 121.44,
  "lines": [
    {
      "at": 2.79,
      "end": 8.06,
      "text": "قد أمسكت المسبحة كي يرفع عني دعائي"
    },
    {
      "at": 8.06,
      "end": 13.06,
      "text": "بقوة الصلاة أرتقي بين السماء،"
    },
    {
      "at": 13.06,
      "end": 18.82,
      "text": "بتكرارها الكثير سوف أغلب الشرير."
    },
    {
      "at": 18.82,
      "end": 24.13,
      "text": "هذه أولى الصلاة تسمعونها في الحين"
    },
    {
      "at": 24.13,
      "end": 29.79,
      "text": "أيها الثالوث القدوس خلّصنا أجمعين،"
    },
    {
      "at": 29.79,
      "end": 35.24,
      "text": "بتكرارها الكثير سوف أغلب الشرير."
    },
    {
      "at": 35.24,
      "end": 40.39,
      "text": "الصلاة الثانية سأتلوها صادحًا:"
    },
    {
      "at": 40.39,
      "end": 45.72,
      "text": "ربي يسوع المسيح يا ابن الله ارحمني،"
    },
    {
      "at": 45.72,
      "end": 51.3,
      "text": "بتكرارها الكثير سوف أغلب الشرير."
    },
    {
      "at": 51.3,
      "end": 56.56,
      "text": "الصلاة الثالثة لوالدة الإله،"
    },
    {
      "at": 56.56,
      "end": 61.81,
      "text": "أيتها الفائقة القداسة خلّصينا،"
    },
    {
      "at": 61.81,
      "end": 67.34,
      "text": "بتكرارها الكثير سوف أغلب الشرير."
    },
    {
      "at": 67.34,
      "end": 72.6,
      "text": "الصلاة الرابعة ليوحنا المعمدان،"
    },
    {
      "at": 72.6,
      "end": 77.55,
      "text": "أيها صابغ المسيح تشفّع لعبيدك،"
    },
    {
      "at": 77.55,
      "end": 83.13,
      "text": "بتكرارها الكثير سوف أغلب الشرير."
    },
    {
      "at": 83.13,
      "end": 88.33,
      "text": "الصلاة الخامسة لجميع القديسين،"
    },
    {
      "at": 88.33,
      "end": 92.96,
      "text": "يا قديسي الله تشفّعوا بنا،"
    },
    {
      "at": 92.96,
      "end": 98.57,
      "text": "بتكرارها الكثير سوف أغلب الشرير."
    },
    {
      "at": 98.57,
      "end": 103.87,
      "text": "وختامًا صلاة للملائكة،"
    },
    {
      "at": 103.87,
      "end": 109.14,
      "text": "يا رؤساء الأجناد تشفّعوا بنا،"
    },
    {
      "at": 109.14,
      "end": 116.9,
      "text": "بتكرارها الكثير سوف أغلب الشرير."
    }
  ]
}
