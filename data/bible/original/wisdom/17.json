{"book":"wisdom","name":"Wisdom","chapter":17,"verses":[{"n":1,"text":"ΜΕΓΑΛΑΙ γάρ σου αἱ κρίσεις καὶ δυσδιήγητοι· διὰ τοῦτο ἀπαίδευτοι ψυχαὶ ἐπλανήθησαν.","tokens":[{"w":"ΜΕΓΑΛΑΙ","s":"3173"},{"w":"γάρ","s":"1063"},{"w":"σου","s":"4771"},{"w":"αἱ","s":"3588"},{"w":"κρίσεις","s":"2920"},{"w":"καὶ","s":"2532"},{"w":"δυσδιήγητοι·"},{"w":"διὰ","s":"1223"},{"w":"τοῦτο","s":"3778"},{"w":"ἀπαίδευτοι"},{"w":"ψυχαὶ","s":"5590"},{"w":"ἐπλανήθησαν","s":"4105"},{"w":"."}]},{"n":2,"text":"ὑπειληφότες γὰρ καταδυναστεύειν ἔθνος ἅγιον ἄνομοι, δέσμιοι σκότους καὶ μακρᾶς πεδῆται νυκτὸς κατακλεισθέντες ὀρόφοις, φυγάδες τῆς αἰωνίου προνοίας ἔκειντο.","tokens":[{"w":"ὑπειληφότες"},{"w":"γὰρ","s":"1063"},{"w":"καταδυναστεύειν"},{"w":"ἔθνος","s":"1484"},{"w":"ἅγιον","s":"40"},{"w":"ἄνομοι"},{"w":","},{"w":"δέσμιοι","s":"1198"},{"w":"σκότους","s":"4655"},{"w":"καὶ","s":"2532"},{"w":"μακρᾶς"},{"w":"πεδῆται"},{"w":"νυκτὸς","s":"3571"},{"w":"κατακλεισθέντες"},{"w":"ὀρόφοις"},{"w":","},{"w":"φυγάδες"},{"w":"τῆς","s":"3588"},{"w":"αἰωνίου","s":"166"},{"w":"προνοίας","s":"4307"},{"w":"ἔκειντο"},{"w":"."}]},{"n":3,"text":"λανθάνειν γὰρ νομίζοντες ἐπὶ κρυφαίοις ἁμαρτήμασιν, ἀφεγγεῖ λήθης παρακαλύμματι ἐσκορπίσθησαν, θαμβούμενοι δεινῶς καὶ ἰνδάλμασιν ἐκταρασσόμενοι·","tokens":[{"w":"λανθάνειν","s":"2990"},{"w":"γὰρ","s":"1063"},{"w":"νομίζοντες"},{"w":"ἐπὶ","s":"1909"},{"w":"κρυφαίοις"},{"w":"ἁμαρτήμασιν"},{"w":","},{"w":"ἀφεγγεῖ"},{"w":"λήθης"},{"w":"παρακαλύμματι"},{"w":"ἐσκορπίσθησαν"},{"w":","},{"w":"θαμβούμενοι"},{"w":"δεινῶς","s":"1171"},{"w":"καὶ","s":"2532"},{"w":"ἰνδάλμασιν"},{"w":"ἐκταρασσόμενοι·"}]},{"n":4,"text":"οὐδὲ γὰρ ὁ κατέχων αὐτοὺς μυχὸς ἀφόβως διεφύλασσεν, ἦχοι δὲ καταράσσοντες αὐτοὺς περιεκόμπουν, καὶ φάσματα ἀμειδήτοις κατηφῆ προσώποις ἐνεφανίζετο.","tokens":[{"w":"οὐδὲ","s":"3761"},{"w":"γὰρ","s":"1063"},{"w":"ὁ","s":"3588"},{"w":"κατέχων","s":"2722"},{"w":"αὐτοὺς","s":"846"},{"w":"μυχὸς"},{"w":"ἀφόβως","s":"870"},{"w":"διεφύλασσεν"},{"w":","},{"w":"ἦχοι"},{"w":"δὲ","s":"1161"},{"w":"καταράσσοντες"},{"w":"αὐτοὺς","s":"846"},{"w":"περιεκόμπουν"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"φάσματα"},{"w":"ἀμειδήτοις"},{"w":"κατηφῆ"},{"w":"προσώποις"},{"w":"ἐνεφανίζετο"},{"w":"."}]},{"n":5,"text":"καὶ πυρὸς μὲν οὐδεμία βία κατίσχυε φωτίζειν, οὔτε ἄστρων ἔκλαμπροι φλόγες καταυγάζειν ὑπέμενον τὴν στυγνὴν ἐκείνην νύκτα.","tokens":[{"w":"καὶ","s":"2532"},{"w":"πυρὸς","s":"4442"},{"w":"μὲν","s":"3303"},{"w":"οὐδεμία","s":"3762"},{"w":"βία"},{"w":"κατίσχυε"},{"w":"φωτίζειν"},{"w":","},{"w":"οὔτε","s":"3777"},{"w":"ἄστρων","s":"798"},{"w":"ἔκλαμπροι"},{"w":"φλόγες"},{"w":"καταυγάζειν"},{"w":"ὑπέμενον","s":"5278"},{"w":"τὴν","s":"3588"},{"w":"στυγνὴν"},{"w":"ἐκείνην","s":"1565"},{"w":"νύκτα","s":"3571"},{"w":"."}]},{"n":6,"text":"διεφαίνετο δ᾿ αὐτοῖς μόνον αὐτομάτη πυρὰ φόβου πλήρης, ἐκδειματούμενοι δὲ τῆς μὴ θεωρουμένης ἐκείνης ὄψεως ἡγοῦντο χείρω τὰ βλεπόμενα.","tokens":[{"w":"διεφαίνετο"},{"w":"δ᾿"},{"w":"αὐτοῖς","s":"846"},{"w":"μόνον","s":"3440"},{"w":"αὐτομάτη","s":"844"},{"w":"πυρὰ"},{"w":"φόβου","s":"5399"},{"w":"πλήρης","s":"4134"},{"w":","},{"w":"ἐκδειματούμενοι"},{"w":"δὲ","s":"1161"},{"w":"τῆς","s":"3588"},{"w":"μὴ","s":"3361"},{"w":"θεωρουμένης"},{"w":"ἐκείνης","s":"1565"},{"w":"ὄψεως"},{"w":"ἡγοῦντο"},{"w":"χείρω"},{"w":"τὰ","s":"3588"},{"w":"βλεπόμενα","s":"991"},{"w":"."}]},{"n":7,"text":"μαγικῆς δὲ ἐμπαίγματα κατέκειτο τέχνης, καὶ τῆς ἐπί φρονήσει ἀλαζονείας ἔλεγχος ἐφύβριστος·","tokens":[{"w":"μαγικῆς"},{"w":"δὲ","s":"1161"},{"w":"ἐμπαίγματα"},{"w":"κατέκειτο","s":"2621"},{"w":"τέχνης","s":"5078"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"τῆς","s":"3588"},{"w":"ἐπί","s":"1909"},{"w":"φρονήσει","s":"5428"},{"w":"ἀλαζονείας"},{"w":"ἔλεγχος","s":"1650"},{"w":"ἐφύβριστος·"}]},{"n":8,"text":"οἱ γὰρ ὑπισχνούμενοι δείματα καὶ ταραχὰς ἀπελαύνειν ψυχῆς νοσούσης, οὗτοι καταγέλαστον εὐλάβειαν ἐνόσουν.","tokens":[{"w":"οἱ","s":"3588"},{"w":"γὰρ","s":"1063"},{"w":"ὑπισχνούμενοι"},{"w":"δείματα"},{"w":"καὶ","s":"2532"},{"w":"ταραχὰς"},{"w":"ἀπελαύνει