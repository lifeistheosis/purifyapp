{"book":"proverbs","name":"Proverbs","chapter":16,"verses":[{"n":1,"text":"ΠΑΝΤΑ τὰ ἔργα τοῦ ταπεινοῦ φανερὰ παρὰ τῷ Θεῷ, οἱ δὲ ἀσεβεῖς ἐν ἡμέρᾳ κακῇ ὀλοῦνται.","tokens":[{"w":"ΠΑΝΤΑ","s":"3956"},{"w":"τὰ","s":"3588"},{"w":"ἔργα","s":"2041"},{"w":"τοῦ","s":"3588"},{"w":"ταπεινοῦ"},{"w":"φανερὰ","s":"5318"},{"w":"παρὰ","s":"3844"},{"w":"τῷ","s":"3588"},{"w":"Θεῷ","s":"2316"},{"w":","},{"w":"οἱ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"ἀσεβεῖς","s":"765"},{"w":"ἐν","s":"1722"},{"w":"ἡμέρᾳ","s":"2250"},{"w":"κακῇ"},{"w":"ὀλοῦνται"},{"w":"."}]},{"n":5,"text":"ἀκάθαρτος παρὰ Θεῷ πᾶς ὑψηλοκάρδιος, χειρὶ δὲ χεῖρας ἐμβαλὼν ἀδίκως οὐκ ἀθῳωθήσεται.","tokens":[{"w":"ἀκάθαρτος","s":"169"},{"w":"παρὰ","s":"3844"},{"w":"Θεῷ","s":"2316"},{"w":"πᾶς","s":"3956"},{"w":"ὑψηλοκάρδιος"},{"w":","},{"w":"χειρὶ","s":"5495"},{"w":"δὲ","s":"1161"},{"w":"χεῖρας","s":"5495"},{"w":"ἐμβαλὼν"},{"w":"ἀδίκως","s":"95"},{"w":"οὐκ","s":"3756"},{"w":"ἀθῳωθήσεται"},{"w":"."}]},{"n":7,"text":"ἀρχὴ ὁδοῦ ἀγαθῆς τὸ ποιεῖν τὰ δίκαια, δεκτὰ δὲ παρὰ Θεῷ μᾶλλον ἢ θύειν θυσίας.","tokens":[{"w":"ἀρχὴ","s":"746"},{"w":"ὁδοῦ","s":"3598"},{"w":"ἀγαθῆς","s":"18"},{"w":"τὸ","s":"3588"},{"w":"ποιεῖν","s":"4160"},{"w":"τὰ","s":"3588"},{"w":"δίκαια","s":"1342"},{"w":","},{"w":"δεκτὰ"},{"w":"δὲ","s":"1161"},{"w":"παρὰ","s":"3844"},{"w":"Θεῷ","s":"2316"},{"w":"μᾶλλον","s":"3123"},{"w":"ἢ","s":"3588"},{"w":"θύειν","s":"2380"},{"w":"θυσίας","s":"2378"},{"w":"."}]},{"n":8,"text":"ὁ ζητῶν τὸν Κύριον εὑρήσει γνῶσιν μετὰ δικαιοσύνης, οἱ δὲ ὀρθῶς ζητοῦντες αὐτὸν εὑρήσουσιν εἰρήνην. (Μασ. 4)","tokens":[{"w":"ὁ","s":"3588"},{"w":"ζητῶν","s":"2212"},{"w":"τὸν","s":"3588"},{"w":"Κύριον","s":"2962"},{"w":"εὑρήσει","s":"2147"},{"w":"γνῶσιν","s":"1108"},{"w":"μετὰ","s":"3326"},{"w":"δικαιοσύνης","s":"1343"},{"w":","},{"w":"οἱ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"ὀρθῶς","s":"3723"},{"w":"ζητοῦντες","s":"2212"},{"w":"αὐτὸν","s":"846"},{"w":"εὑρήσουσιν","s":"2147"},{"w":"εἰρήνην","s":"1515"},{"w":"."},{"w":"(Μασ"},{"w":"."},{"w":"4)"}]