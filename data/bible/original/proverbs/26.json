{"book":"proverbs","name":"Proverbs","chapter":26,"verses":[{"n":1,"text":"ΩΣΠΕΡ δρόσος ἐν ἀμήτῳ καὶ ὥσπερ ὑετὸς ἐν θέρει, οὕτως οὐκ ἔστιν ἄφρονι τιμή.","tokens":[{"w":"ΩΣΠΕΡ","s":"5618"},{"w":"δρόσος"},{"w":"ἐν","s":"1722"},{"w":"ἀμήτῳ"},{"w":"καὶ","s":"2532"},{"w":"ὥσπερ","s":"5618"},{"w":"ὑετὸς","s":"5205"},{"w":"ἐν","s":"1722"},{"w":"θέρει"},{"w":","},{"w":"οὕτως","s":"3779"},{"w":"οὐκ","s":"3756"},{"w":"ἔστιν","s":"1510"},{"w":"ἄφρονι"},{"w":"τιμή","s":"5092"},{"w":"."}]},{"n":2,"text":"ὥσπερ ὄρνεα πέταται καὶ στρουθοί, οὕτως ἀρὰ ματαία οὐκ ἐπελεύσεται οὐδενί.","tokens":[{"w":"ὥσπερ","s":"5618"},{"w":"ὄρνεα","s":"3732"},{"w":"πέταται"},{"w":"καὶ","s":"2532"},{"w":"στρουθοί"},{"w":","},{"w":"οὕτως","s":"3779"},{"w":"ἀρὰ","s":"686"},{"w":"ματαία","s":"3152"},{"w":"οὐκ","s":"3756"},{"w":"ἐπελεύσεται","s":"1904"},{"w":"οὐδενί","s":"3762"},{"w":"."}]},{"n":3,"text":"ὥσπερ μάστιξ ἵππῳ καὶ κέντρον ὄνῳ, οὕτως ράβδος ἔθνει παρανόμῳ.","tokens":[{"w":"ὥσπερ","s":"5618"},{"w":"μάστιξ"},{"w":"ἵππῳ"},{"w":"καὶ","s":"2532"},{"w":"κέντρον","s":"2759"},{"w":"ὄνῳ"},{"w":","},{"w":"οὕτως","s":"3779"},{"w":"ράβδος","s":"4464"},{"w":"ἔθνει","s":"1484"},{"w":"παρανόμῳ"},{"w":"."}]},{"n":4,"text":"μὴ ἀποκρίνου ἄφρονι πρὸς τὴν ἐκείνου ἀφροσύνην, ἵνα μὴ ὅμοιος γένῃ αὐτῷ·","tokens":[{"w":"μὴ","s":"3361"},{"w":"ἀποκρίνου"},{"w":"ἄφρονι"},{"w":"πρὸς","s":"4314"},{"w":"τὴν","s":"3588"},{"w":"ἐκείνου","s":"1565"},{"w":"ἀφροσύνην"},{"w":","},{"w":"ἵνα","s":"2443"},{"w":"μὴ","s":"3361"},{"w":"ὅμοιος","s":"3664"},{"w":"γένῃ","s":"1085"},{"w":"αὐτῷ·","s":"846"}]},{"n":5,"text":"ἀλλὰ ἀποκρίνου ἄφρονι κατὰ τὴν ἀφροσύνην αὐτοῦ, ἵνα μὴ φαίνηται σοφός παρ᾿ ἑαυτῷ.","tokens":[{"w":"ἀλλὰ","s":"235"},{"w":"ἀποκρίνου"},{"w":"ἄφρονι"},{"w":"κατὰ","s":"2596"},{"w":"τὴν","s":"3588"},{"w":"ἀφροσύνην"},{"w":"αὐτοῦ","s":"846"},{"w":","},{"w":"ἵνα","s":"2443"},{"w":"μὴ","s":"3361"},{"w":"φαίνηται"},{"w":"σοφός","s":"4680"},{"w":"παρ᾿"},{"w":"ἑαυτῷ","s":"1438"},{"w":"."}]},{"n":6,"text":"ἐκ τῶν ὁδῶν ἑαυτοῦ ὄνειδ