{"book":"proverbs","name":"Proverbs","chapter":18,"verses":[{"n":1,"text":"Προφάσεις ζητεῖ ἀνὴρ βουλόμενος χωρίζεσθαι ἀπὸ φίλων, ἐν παντὶ δὲ καιρῷ ἐπονείδιστος ἔσται.","tokens":[{"w":"Προφάσεις"},{"w":"ζητεῖ","s":"2212"},{"w":"ἀνὴρ","s":"435"},{"w":"βουλόμενος","s":"1014"},{"w":"χωρίζεσθαι","s":"5563"},{"w":"ἀπὸ","s":"575"},{"w":"φίλων","s":"5368"},{"w":","},{"w":"ἐν","s":"1722"},{"w":"παντὶ","s":"3956"},{"w":"δὲ","s":"1161"},{"w":"καιρῷ","s":"2540"},{"w":"ἐπονείδιστος"},{"w":"ἔσται","s":"1510"},{"w":"."}]},{"n":2,"text":"οὐ χρείαν ἔχει σοφίας ἐνδεὴς φρενῶν, μᾶλλον γὰρ ἄγεται ἀφροσύνῃ.","tokens":[{"w":"οὐ","s":"3756"},{"w":"χρείαν","s":"5532"},{"w":"ἔχει","s":"2192"},{"w":"σοφίας","s":"4678"},{"w":"ἐνδεὴς","s":"1729"},{"w":"φρενῶν"},{"w":","},{"w":"μᾶλλον","s":"3123"},{"w":"γὰρ","s":"1063"},{"w":"ἄγεται"},{"w":"ἀφροσύνῃ","s":"877"},{"w":"."}]},{"n":3,"text":"ὅταν ἔλθῃ ἀσεβὴς εἰς βάθος κακῶν, καταφρονεῖ, επέρχεται δὲ αὐτῷ ἀτιμία καὶ ὄνειδος.","tokens":[{"w":"ὅταν","s":"3752"},{"w":"ἔλθῃ","s":"2064"},{"w":"ἀσεβὴς","s":"765"},{"w":"εἰς","s":"1519"},{"w":"βάθος","s":"899"},{"w":"κακῶν","s":"2556"},{"w":","},{"w":"καταφρονεῖ"},{"w":","},{"w":"επέρχεται"},{"w":"δὲ","s":"1161"},{"w":"αὐτῷ","s":"846"},{"w":"ἀτιμία","s":"819"},{"w":"καὶ","s":"2532"},{"w":"ὄνειδος","s":"3681"},{"w":"."}]},{"n":4,"text":"ὕδωρ βαθὺ λόγος ἐν καρδίᾳ ἀνδρός, ποταμὸς δὲ ἀναπηδύει καὶ πηγὴ ζωῆς.","tokens":[{"w":"ὕδωρ","s":"5204"},{"w":"βαθὺ","s":"901"},{"w":"λόγος","s":"3056"},{"w":"ἐν","s":"1722"},{"w":"καρδίᾳ","s":"2588"},{"w":"ἀνδρός","s":"435"},{"w":","},{"w":"ποταμὸς","s":"4215"},{"w":"δὲ","s":"1161"},{"w":"ἀναπηδύει"},{"w":"καὶ","s":"2532"},{"w":"πηγὴ","s":"4077"},{"w":"ζωῆς","s":"2222"},{"w":"."}]},{"n":5,"text":"θαυμάσαι πρόσωπον ἀσεβοῦς οὐ καλόν, οὐδὲ ὅσιον ἐκκλίνειν τὸ δίκαιον ἐν κρίσει.","tokens":[{"w":"θαυμάσαι","s":"2296"},{"w":"πρόσωπον","s":"4383"},{"w":"ἀσεβοῦς"},{"w":"οὐ","s":"3756"},{"w":"καλόν","s":"2570"},{"w":","},{"w":"οὐδὲ","s":"3761"},{"w":"ὅσιον","s":"3741"},{"w":"ἐκκλίνειν"},{"w":"τὸ","s":"3588"},{"w":"δίκαιον","s":"1342"},{"w":"ἐν","s":"1722"},{"w":"κρίσει","s":"2920"},{"w":"."}]},{"n":6,"text":"χείλη ἄφρονος ἄγουσιν αὐτὸν εἰς κακά, τὸ δὲ στόμα αὐτοῦ τὸ θρασὺ θάνατον ἐπικαλεῖται.","tokens":[{"w":"χείλη","s":"5491"},{"w":"ἄφρονος"},{"w":"ἄγουσιν","s":"71"},{"w":"αὐτὸν","s":"846"},{"w":"εἰς","s":"1519"},{"w":"κακά","s":"2556"},{"w":","},{"w":"τὸ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"στόμα","s":"4750"},{"w":"αὐτοῦ","s":"846"},{"w":"τὸ","s":"3588"},{"w":"θρασὺ"},{"w":"θάνατον","s":"2288"},{"w":"ἐπικαλεῖται","s":"1941"},{"w":"."}]},{"n":7,"text":"στόμα ἄφρονος συντριβὴ αὐτῷ, τὰ δὲ χείλη αὐτοῦ παγὶς τῇ ψυχῇ αὐτοῦ.","tokens":[{"w":"στόμα","s":"4750"},{"w":"ἄφρονος"},{"w":"συντριβὴ"},{"w":"αὐτῷ","s":"846"},{"w":","},{"w":"τὰ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"χείλη","s":"5491"},{"w":"αὐτοῦ","s":"846"},{"w":"παγὶς","s":"3803"},{"w":"τῇ","s":"3588"},{"w":"ψυχῇ","s":"5590"},{"w":"αὐτοῦ","s":"846"},{"w":"."}]},{"n":8,"text":"ὀκνηροὺς καταβάλλει φόβος, ψυχαὶ δὲ ἀνδρογύνων πεινάσουσιν.","tokens":[{"w":"ὀκνηροὺς"},{"w":"καταβάλλει"},{"w":"φόβος","s":"5401"},{"w":","},{"w":"ψυχαὶ","s":"5590"},{"w":"δὲ","s":"1161"},{"w":"ἀνδρογύνων"},{"w":"πεινάσουσιν","s":"3983"},{"w":"."}]},{"n":9,"text":"ὁ μὴ ἰώμενος ἑαυτὸν ἐν τοῖς ἔργοις αὑτοῦ ἀδελφός ἐστι τοῦ λυμαινομένου ἑαυτόν.","tokens":[{"w":"ὁ","s":"3588"},{"w":"μὴ","s":"3361"},{"w":"ἰώμενος","s":"2390"},{"w":"ἑαυτὸν","s":"1438"},{"w":"ἐν","s":"1722"},{"w":"τοῖς","s":"3588"},{"w":"ἔργοις","s":"2041"},{"w":"αὑτοῦ","s":"846"},{"w":"ἀδελφός","s":"80"},{"w":"ἐστι"},{"w":"τοῦ","s":"3588"},{"w":"λυμαινομένου"},{"w":"ἑαυτόν","s":"1438"},{"w":"."}]},{"n":10,"text":"ἐκ μεγαλωσύνης ἰσχύος ὄνομα Κυρίου, αὐτῷ δὲ προσδραμόντες δίκαιοι ὑψοῦνται.","tokens":[{"w":"ἐκ","s":"1537"},{"w":"μεγαλωσύνης","s":"3172"},{"w":"ἰσχύος","s":"2479"},{"w":"ὄνομα","s":"3686"},{"w":"Κυρίου","s":"2962"},{"w":","},{"w":"αὐτῷ","s":"846"},{"w":"δὲ","s":"1161"},{"w":"προσδραμόντες"},{"w":"δίκαιοι","s":"1342"},{"w":"ὑψοῦνται"},{"w":"."}]},{"n":11,"text":"ὕπαρξις πλουσίου ἀνδρὸς πόλις ὀχυρά, ἡ δὲ δόξα αὐτῆς μέγα ἐπισκιάζει.","tokens":[{"w":"ὕπαρξις"},{"w":"πλουσίου","s":"4145"},{"w":"ἀνδρὸς","s":"435"},{"w":"πόλις","s":"4172"},{"w":"ὀχυρά"},{"w":","},{"w":"ἡ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"δόξα","s":"1391"},{"w":"αὐτῆς","s":"846"},{"w":"μέγα","s":"3173"},{"w":"ἐπισκιάζει"},{"w":"."}]},{"n":12,"text":"πρὸ συντριβῆς ὑψοῦται καρδία ἀνδρός, καὶ πρὸ δόξης ταπεινοῦται.","tokens":[{"w":"πρὸ","s":"4253"},{"w":"συντριβῆς"},{"w":"ὑψοῦται"},{"w":"καρδία","s":"2588"},{"w":"ἀνδρός","s":"435"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"πρὸ","s":"4253"},{"w":"δόξης","s":"1391"},{"w":"ταπεινοῦται"},{"w":"."}]},{"n":13,"text":"ὃς ἀποκρίνεται λόγον πρὶν ἀκοῦσαι, ἀφροσύνη αὐτῷ ἐστι καὶ ὄνειδος.","tokens":[{"w":"ὃς","s":"3739"},{"w":"ἀποκρίνεται","s":"611"},{"w":"λόγον","s":"3056"},{"w":"πρὶν","s":"4250"},{"w":"ἀκοῦσαι","s":"191"},{"w":","},{"w":"ἀφροσύνη","s":"877"},{"w":"αὐτῷ","s":"846"},{"w":"ἐστι"},{"w":"καὶ","s":"2532"},{"w":"ὄνειδος","s":"3681"},{"w":"."}]},{"n":14,"text":"θυμὸν ἀνδρὸς πραὐνει θεράπων φρόνιμος, ὀλιγόψυχον δὲ ἄνδρα τίς ὑποίσει;","tokens":[{"w":"θυμὸν","s":"2372"},{"w":"ἀνδρὸς","s":"435"},{"w":"πραὐνει"},{"w":"θεράπων","s":"2324"},{"w":"φρόνιμος","s":"5429"},{"w":","},{"w":"ὀλιγόψυχον"},{"w":"δὲ","s":"1161"},{"w":"ἄνδρα","s":"435"},{"w":"τίς","s":"5100"},{"w":"ὑποίσει"},{"w":";"}]},{"n":15,"text":"καρδία φρονίμου κτᾶται αἴσθησιν, ὦτα δὲ σοφῶν ζητεῖ ἔννοιαν.","tokens":[{"w":"καρδία","s":"2588"},{"w":"φρονίμου"},{"w":"κτᾶται"},{"w":"αἴσθησιν"},{"w":","},{"w":"ὦτα","s":"3775"},{"w":"δὲ","s":"1161"},{"w":"σοφῶν","s":"4680"},{"w":"ζητεῖ","s":"2212"},{"w":"ἔννοιαν","s":"1771"},{"w":"."}]},{"n":16,"text":"δόμα ἀνθρώπου ἐμπλατύνει αὐτὸν καὶ παρὰ δυνάσταις καθιζάνει αὐτόν.","tokens":[{"w":"δόμα","s":"1390"},{"w":"ἀνθρώπου","s":"444"},{"w":"ἐμπλατύνει"},{"w":"αὐτὸν","s":"846"},{"w":"καὶ","s":"2532"},{"w":"παρὰ","s":"3844"},{"w":"δυνάσταις"},{"w":"καθιζάνει"},{"w":"αὐτόν","s":"846"},{"w":"."}]},{"n":17,