{"book":"proverbs","name":"Proverbs","chapter":20,"verses":[{"n":1,"text":"ΑΚΟΛΑΣΤΟΝ οἶνος καὶ ὑβριστικὸν μέθη, πᾶς δὲ ἄφρων τοιούτοις συμπλέκεται.","tokens":[{"w":"ΑΚΟΛΑΣΤΟΝ"},{"w":"οἶνος","s":"3631"},{"w":"καὶ","s":"2532"},{"w":"ὑβριστικὸν"},{"w":"μέθη","s":"3178"},{"w":","},{"w":"πᾶς","s":"3956"},{"w":"δὲ","s":"1161"},{"w":"ἄφρων","s":"878"},{"w":"τοιούτοις","s":"5108"},{"w":"συμπλέκεται"},{"w":"."}]},{"n":2,"text":"οὐ διαφέρει ἀπειλὴ βασιλέως θυμοῦ λέοντος, ὁ δὲ παροξύνων αὐτὸν ἁμαρτάνει εἰς τὴν ἑαυτοῦ ψυχήν.","tokens":[{"w":"οὐ","s":"3756"},{"w":"διαφέρει","s":"1308"},{"w":"ἀπειλὴ","s":"547"},{"w":"βασιλέως","s":"935"},{"w":"θυμοῦ","s":"2372"},{"w":"λέοντος","s":"3023"},{"w":","},{"w":"ὁ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"παροξύνων"},{"w":"αὐτὸν","s":"846"},{"w":"ἁμαρτάνει","s":"264"},{"w":"εἰς","s":"1519"},{"w":"τὴν","s":"3588"},{"w":"ἑαυτοῦ","s":"1438"},{"w":"ψυχήν","s":"5590"},{"w":"."}]},{"n":3,"text":"δόξα ἀνδρὶ ἀποστρέφεσθαι λοιδορίας, πᾶς δὲ ἄφρων τοιούτοις συμπλέκεται.","tokens":[{"w":"δόξα","s":"1391"},{"w":"ἀνδρὶ","s":"435"},{"w":"ἀποστρέφεσθαι"},{"w":"λοιδορίας","s":"3059"},{"w":","},{"w":"πᾶς","s":"3956"},{"w":"δὲ","s":"1161"},{"w":"ἄφρων","s":"878"},{"w":"τοιούτοις","s":"5108"},{"w":"συμπλέκεται"},{"w":"."}]},{"n":4,"text":"ὀνειδιζόμενος ὀκνηρὸς οὐκ αἰσχύνεται, ὡσαύτως καὶ ὁ δανειζόμενος σῖτον ἐν ἀμήτῳ.","tokens":[{"w":"ὀνειδιζόμενος"},{"w":"ὀκνηρὸς"},{"w":"οὐκ","s":"3756"},{"w":"αἰσχύνεται"},{"w":","},{"w":"ὡσαύτως","s":"5615"},{"w":"καὶ","s":"2532"},{"w":"ὁ","s":"3588"},{"w":"δανειζόμενος"},{"w":"σῖτον","s":"4621"},{"w":"ἐν","s":"1722"},{"w":"ἀμήτῳ"},{"w":"."}]},{"n":5,"text":"ὕδωρ βαθὺ βουλὴ ἐν καρδίᾳ ἀνδρός, ἀνὴρ δὲ φρόνιμος ἐξαντλήσει αὐτήν.","tokens":[{"w":"ὕδωρ","s":"5204"},{"w":"βαθὺ","s":"901"},{"w":"βουλὴ","s":"1012"},{"w":"ἐν","s":"1722"},{"w":"καρδίᾳ","s":"2588"},{"w":"ἀνδρός","s":"435"},{"w":","},{"w":"ἀνὴρ","s":"435"},{"w":"δὲ","s":"1161"},{"w":"φρόνιμος","s":"5429"},{"w":"ἐξαντλήσει"},{"w":"αὐτήν","s":"846"},{"w":"."}]},{"n":6,"text":"μέγα ἄνθρωπος καὶ τίμιον ἀνὴρ ἐλεήμων, ἄνδρα δὲ πιστὸν ἔργον εὑρεῖν.","tokens":[{"w":"μέγα","s":"3173"},{"w":"ἄνθρωπος","s":"444"},{"w":"καὶ","s":"2532"},{"w":"τίμιον","s":"5093"},{"w":"ἀνὴρ","s":"435"},{"w":"ἐλεήμων","s":"1655"},{"w":","},{"w":"ἄνδρα","s":"435"},{"w":"δὲ","s":"1161"},{"w":"πιστὸν","s":"4103"},{"w":"ἔργον","s":"2041"},{"w":"εὑρεῖν","s":"2147"},{"w":"."}]},{"n":7,"text":"ὃς ἀναστρέφεται ἄμωμος ἐν δικαιοσύνῃ, μακαρίους τοὺς παῖδας αὐτοῦ καταλείψει.","tokens":[{"w":"ὃς","s":"3739"},{"w":"ἀναστρέφεται"},{"w":"ἄμωμος","s":"299"},{"w":"ἐν","s":"1722"},{"w":"δικαιοσύνῃ","s":"1343"},{"w":","},{"w":"μακαρίους"},{"w":"τοὺς","s":"3588"},{"w":"παῖδας","s":"3816"},{"w":"αὐτοῦ","s":"846"},{"w":"καταλείψει","s":"2641"},{"w":"."}]},{"n":8,"text":"ὅταν βασιλεὺς δίκαιος καθίσῃ ἐπὶ θρόνου, οὐκ ἐναντιοῦται ἐν ὀφθαλμοῖς αὐτοῦ πᾶν πονηρόν.","tokens":[{"w":"ὅταν","s":"3752"},{"w":"βασιλεὺς","s":"935"},{"w":"δίκαιος","s":"1342"},{"w":"καθίσῃ","s":"2523"},{"w":"ἐπὶ","s":"1909"},{"w":"θρόνου","s":"2362"},{"w":","},{"w":"οὐκ","s":"3756"},{"w":"ἐναντιοῦται"},{"w":"ἐν","s":"1722"},{"w":"ὀφθαλμοῖς","s":"3788"},{"w":"αὐτοῦ","s":"846"},{"w":"πᾶν","s":"3956"},{"w":"πονηρόν","s":"4190"},{"w":"."}]},{"n":9,"text":"τίς καυχήσεται ἁγνὴν ἔχειν τὴν καρδίαν; ἢ τίς παρρησιάσεται καθαρὸς εἶναι ἀπὸ ἁμαρτιῶν;","tokens":[{"w":"τίς","s":"5100"},{"w":"καυχήσεται"},{"w":"ἁγνὴν","s":"53"},{"w":"ἔχειν","s":"2192"},{"w":"τὴν","s":"3588"},{"w":"καρδίαν","s":"2588"},{"w":";"},{"w":"ἢ","s":"3588"},{"w":"τίς","s":"5100"},{"w":"παρρησιάσεται"},{"w":"καθαρὸς","s":"2513"},{"w":"εἶναι","s":"1510"},{"w":"ἀπὸ","s":"575"},{"w":"ἁμαρτιῶν","s":"266"},{"w":";"}]},{"n":20,"text":"κακολογοῦντος πατέρα ἢ μητέρα σβεσθήσεται λαμπτήρ, αἱ δὲ κόραι τῶν ὀφθαλμῶν αὐτοῦ ὄψονται σκότος.","tokens":[{"w":"κακολογοῦντος"},{"w":"πατέρα","s":"3962"},{"w":"ἢ","s":"3588"},{"w":"μητέρα","s":"3384"},{"w":"σβεσθήσεται"},{"w":"λαμπτήρ"},{"w":","},{"w":"αἱ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"κόραι"},{"w":"τῶν","s":"3588"},{"w":"ὀφθαλμῶν","s":"3788"},{"w":"αὐτοῦ","s":"846"},{"w":"ὄψονται","s":"3708"},{"w":"σκότος","s":"4655"},{"w":"."}]},{"n":21,"text":"μερὶς ἐπισπουδαζομένη ἐν πρώτοις, ἐν τοῖς τελευταίοις οὐκ εὐλογηθήσεται.","tokens":[{"w":"μερὶς","s":"3310"},{"w":"ἐπισπουδαζομένη"},{"w":"ἐν","s":"1722"},{"w":"πρώτοις","s":"4413"},{"w":","},{"w":"ἐν","s":"1722"},{"w":"τοῖς","s":"3588"},{"w":"τελευταίοις"},{"w":"οὐκ","s":"3756"},{"w":"εὐλογηθήσεται"},{"w":"."}]},{"n":22,"text":"μὴ εἴπῃς· τίσομαι τὸν ἐχθρόν, ἀλλ᾿ ὑπόμεινον τὸν Κύριον, ἵνα σοι βοηθήσῃ.","tokens":[{"w":"μὴ","s":"3361"},{"w":"εἴπῃς·","s":"3004"},{"w":"τίσομαι"},{"w":"τὸν","s":"3588"},{"w":"ἐχθρόν","s":"2190"},{"w":","},{"w":"ἀλλ᾿"},{"w":"ὑπόμεινον"},{"w":"τὸν","s":"3588"},{"w":"Κύριον","s":"2962"},{"w":","},{"w":"ἵνα","s":"2443"},{"w":"σοι","s":"4771"},{"w":"βοηθήσῃ"},{"w":"."}]},{"n":10,"text":"στάθμιον μέγα καὶ μικρὸν καὶ μέτρα δισσά, ἀκάθαρτα ἐνώπιον Κυρίου καὶ ἀμφότερα καὶ ὁ ποιῶν αὐτά.","tokens":[{"w":"στάθμιον"},{"w":"μέγα","s":"3173"},{"w":"καὶ","s":"2532"},{"w":"μικρὸν","s":"3398"},{"w":"καὶ","s":"2532"},{"w":"μέτρα"},{"w":"δισσά"},{"w":","},{"w":"ἀκάθαρτα","s":"169"},{"w":"ἐνώπιον","s":"1799"},{"w":"Κυρίου","s":"2962"},{"w":"καὶ","s":"2532"},{"w":"ἀμφότερα","s":"297"},{"w":"καὶ","s":"2532"},{"w":"ὁ","s":"3588"},{"w":"ποιῶν","s":"4160"},{"w":"αὐτά","s":"846"},{"w":"."}]},{"n":11,"text":"ἐν τοῖς ἐπιτηδεύμασιν αὐτοῦ συμποδισθήσεται νεανίσκος μετὰ ὁσίου, καὶ εὐθεῖα ἡ ὁδὸς αὐτοῦ.","tokens":[{"w":"ἐν","s":"1722"},{"w":"τοῖς","s":"3588"},{"w":"ἐπιτηδεύμασιν"},{"w":"αὐτοῦ","s":"846"},{"w":"συμποδισθήσεται"},{"w":"νεανίσκος","s":"3495"},{"w":"μετὰ","s":"3326"},{"w":"ὁσίου"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"εὐθεῖα","s":"2117"},{"w":"ἡ","s":"3588"},{"w":"ὁδὸς","s":"3598"},{"w":"αὐτοῦ","s":"846"},{"w":"."}]},{"n":12,"text":"οὖς ἀκούει καὶ ὀφθαλμὸς ὁρᾷ· Κυρίου ἔργα καὶ ἀμφότερα.","tokens":[{"w":"οὖς","s":"3739"},{"w":"ἀκούει","s":"191"},{"w":"καὶ","s":"2532"},{"w":"ὀφθαλμὸς","s":"3788"},{"w":"ὁρᾷ·","s":"3708"},{"w":"Κυρί