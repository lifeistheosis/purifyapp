{"book":"hosea","name":"Hosea","chapter":10,"verses":[{"n":1,"text":"ΑΜΠΕΛΟΣ εὐκληματοῦσα Ἰσραήλ, ὁ καρπὸς εὐθηνῶν αὐτῆς· κατὰ τὸ πλῆθος τῶν καρπῶν αὐτῆς ἐπλήθυνε τὰ θυσιαστήρια, κατὰ τὰ ἀγαθὰ τῆς γῆς αὐτοῦ ᾠκοδόμησε στήλας.","tokens":[{"w":"ΑΜΠΕΛΟΣ","s":"288"},{"w":"εὐκληματοῦσα"},{"w":"Ἰσραήλ","s":"2474"},{"w":","},{"w":"ὁ","s":"3588"},{"w":"καρπὸς","s":"2590"},{"w":"εὐθηνῶν"},{"w":"αὐτῆς·","s":"846"},{"w":"κατὰ","s":"2596"},{"w":"τὸ","s":"3588"},{"w":"πλῆθος","s":"4128"},{"w":"τῶν","s":"3588"},{"w":"καρπῶν","s":"2590"},{"w":"αὐτῆς","s":"846"},{"w":"ἐπλήθυνε"},{"w":"τὰ","s":"3588"},{"w":"θυσιαστήρια","s":"2379"},{"w":","},{"w":"κατὰ","s":"2596"},{"w":"τὰ","s":"3588"},{"w":"ἀγαθὰ","s":"18"},{"w":"τῆς","s":"3588"},{"w":"γῆς","s":"1093"},{"w":"αὐτοῦ","s":"846"},{"w":"ᾠκοδόμησε"},{"w":"στήλας"},{"w":"."}]},{"n":2,"text":"ἐμέρισαν καρδίας αὐτῶν, νῦν ἀφανισθήσονται· αὐτὸς κατασκάψει τὰ θυσιαστήρια αὐτῶν, ταλαιπωρήσουσιν αἱ στῆλαι αὐτῶν.","tokens":[{"w":"ἐμέρισαν"},{"w":"καρδίας","s":"2588"},{"w":"αὐτῶν","s":"846"},{"w":","},{"w":"νῦν","s":"3568"},{"w":"ἀφανισθήσονται·"},{"w":"αὐτὸς","s":"846"},{"w":"κατασκάψει"},{"w":"τὰ","s":"3588"},{"w":"θυσιαστήρια","s":"2379"},{"w":"αὐτῶν","s":"846"},{"w":","},{"w":"ταλαιπωρήσουσιν"},{"w":"αἱ","s":"3588"},{"w":"στῆλαι"},{"w":"αὐτῶν","s":"846"},{"w":"."}]},{"n":3,"text":"διότι νῦν ἐροῦσιν· οὐκ ἔστι βασιλεὺς ἡμῖν, ὅτι οὐκ ἐφοβήθημεν τὸν Κύριον, ὁ δὲ βασιλεὺς τί ποιήσει ἡμῖν;","tokens":[{"w":"διότι","s":"1360"},{"w":"νῦν","s":"3568"},{"w":"ἐροῦσιν·","s":"2046"},{"w":"οὐκ","s":"3756"},{"w":"ἔστι"},{"w":"βασιλεὺς","s":"935"},{"w":"ἡμῖν","s":"1473"},{"w":","},{"w":"ὅτι","s":"3754"},{"w":"οὐκ","s":"3756"},{"w":"ἐφοβήθημεν"},{"w":"τὸν","s":"3588"},{"w":"Κύριον","s":"2962"},{"w":","},{"w":"ὁ","s":"3588"},{"w":"δὲ","s":"1161"},{"w":"βασιλεὺς","s":"935"},{"w":"τί","s":"5101"},{"w":"ποιήσει","s":"4160"},{"w":"ἡμῖν","s":"1473"},{"w":";"}]},{"n":4,"text":"λαλῶν ρήματα προφάσεις ψευδεῖς διαθήσεται διαθήκην· ἀνατελεῖ ὡς ἄγρωστις κρίμα ἐπὶ χέρσον ἀγροῦ.","tokens":[{"w":"λαλῶν","s":"2980"},{"w":"ρήματα","s":"4487"},{"w":"προφάσεις"},{"w":"ψευδεῖς","s":"5571"},{"w":"διαθήσεται"},{"w":"διαθήκην·","s":"1242"},{"w":"ἀνατελεῖ"},{"w":"ὡς","s":"5613"},{"w":"ἄγρωστις"},{"w":"κρίμα","s":"2917"},{"w":"ἐπὶ","s":"1909"},{"w":"χέρσον"},{"w":"ἀγροῦ","s":"68"},{"w":"."}]},{"n":5,"text":"τῷ μόσχῳ τοῦ οἴκου Ὦν παροικήσουσιν οἱ κατοικοῦντες Σαμάρειαν, ὅτι ἐπένθησε λαὸς αὐτοῦ ἐπ᾿ αὐτόν· καὶ καθὼς παρεπίκραναν αὐτόν, ἐπιχαροῦνται ἐπὶ τὴν δόξαν αὐτοῦ, ὅτι μετῳκίσθη ἀπ᾿ αὐτοῦ.","tokens":[{"w":"τῷ","s":"3588"},{"w":"μόσχῳ","s":"3448"},{"w":"τοῦ","s":"3588"},{"w":"οἴκου","s":"3624"},{"w":"Ὦν","s":"3739"},{"w":"παροικήσουσιν"},{"w":"οἱ","s":"3588"},{"w":"κατοικοῦντες","s":"2730"},{"w":"Σαμάρειαν","s":"4540"},{"w":","},{"w":"ὅτι","s":"3754"},{"w":"ἐπένθησε"},{"w":"λαὸς","s":"2992"},{"w":"αὐτοῦ","s":"846"},{"w":"ἐπ᾿"},{"w":"αὐτόν·","s":"846"},{"w":"καὶ","s":"2532"},{"w":"καθὼς","s":"2531"},{"w":"παρεπίκραναν","s":"3893"},{"w":"αὐτόν","s":"846"},{"w":","},{"w":"ἐπιχαροῦνται"},{"w":"ἐπὶ","s":"1909"},{"w":"τὴν","s":"3588"},{"w":"δόξαν","s":"1391"},{"w":"αὐτοῦ","s":"846"},{"w":","},{"w":"ὅτι","s":"3754"},{"w":"μετῳκίσθη"},{"w":"ἀπ᾿"},{"w":"αὐτοῦ","s":"846"},{"w":"."}]},{"n":6,"text":"καὶ αὐτὸν εἰς Ἀσσυρίους δήσαντες ἀπήνεγκαν ξένια τῷ βασιλεῖ Ἰαρείμ· ἐν δόματι Ἐφραὶμ δέξεται, καὶ αἰσχυνθήσεται Ἰσραὴλ ἐν τῇ βουλῇ αὐτοῦ.","tokens":[{"w":"καὶ","s":"2532"},{"w":"αὐτὸν","s":"846"},{"w":"εἰς","s":"1519"},{"w":"Ἀσσυρίους"},{"w":"δήσαντες","s":"1210"},{"w":"ἀπήνεγκαν","s":"667"},{"w":"ξένια"},{"w":"τῷ","s":"3588"},{"w":"βασιλεῖ","s":"935"},{"w":"Ἰαρείμ·"},{"w":"ἐν","s":"1722"},{"w":"δόματι"},{"w":"Ἐφραὶμ","s":"2187"},{"w":"δέξεται"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"αἰσχυνθήσεται"},{"w":"Ἰσραὴλ","s":"2474"},{"w":"ἐν","s":"1722"},{"w":"τῇ","s":"3588"},{"w":"βουλῇ","s":"1012"},{"w":"αὐτοῦ","s":"846"},{"w":"."}]},{"n":7,"text":"ἀπέρριψε Σαμάρεια βασιλέα αὐτῆς ὡς φρύγανον ἐπὶ προσώπου ὕδατος.","tokens":[{"w":"ἀπέρριψε"},{"w":"Σαμάρεια","s":"4540"},