{"book":"hosea","name":"Hosea","chapter":4,"verses":[{"n":1,"text":"ΑΚΟΥΣΑΤΕ λόγον Κυρίου, υἱοὶ Ἰσραήλ, ὅτι κρίσις τῷ Κυρίῳ πρὸς τοὺς κατοικοῦντας τὴν γῆν, διότι οὐκ ἔστιν ἀλήθεια οὐδὲ ἔλεος οὐδὲ ἐπίγνωσις Θεοῦ ἐπὶ τῆς γῆς.","tokens":[{"w":"ΑΚΟΥΣΑΤΕ","s":"191"},{"w":"λόγον","s":"3056"},{"w":"Κυρίου","s":"2962"},{"w":","},{"w":"υἱοὶ","s":"5207"},{"w":"Ἰσραήλ","s":"2474"},{"w":","},{"w":"ὅτι","s":"3754"},{"w":"κρίσις","s":"2920"},{"w":"τῷ","s":"3588"},{"w":"Κυρίῳ","s":"2962"},{"w":"πρὸς","s":"4314"},{"w":"τοὺς","s":"3588"},{"w":"κατοικοῦντας","s":"2730"},{"w":"τὴν","s":"3588"},{"w":"γῆν","s":"1093"},{"w":","},{"w":"διότι","s":"1360"},{"w":"οὐκ","s":"3756"},{"w":"ἔστιν","s":"1510"},{"w":"ἀλήθεια","s":"225"},{"w":"οὐδὲ","s":"3761"},{"w":"ἔλεος","s":"1656"},{"w":"οὐδὲ","s":"3761"},{"w":"ἐπίγνωσις","s":"1922"},{"w":"Θεοῦ","s":"2316"},{"w":"ἐπὶ","s":"1909"},{"w":"τῆς","s":"3588"},{"w":"γῆς","s":"1093"},{"w":"."}]},{"n":2,"text":"ἀρὰ καὶ ψεῦδος καὶ φόνος καὶ κλοπὴ καὶ μοιχεία κέχυται ἐπὶ τῆς γῆς, καὶ αἵματα ἀφ᾿ αἵμασι μίσγουσι.","tokens":[{"w":"ἀρὰ","s":"686"},{"w":"καὶ","s":"2532"},{"w":"ψεῦδος","s":"5579"},{"w":"καὶ","s":"2532"},{"w":"φόνος"},{"w":"καὶ","s":"2532"},{"w":"κλοπὴ"},{"w":"καὶ","s":"2532"},{"w":"μοιχεία","s":"3430"},{"w":"κέχυται"},{"w":"ἐπὶ","s":"1909"},{"w":"τῆς","s":"3588"},{"w":"γῆς","s":"1093"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"αἵματα","s":"129"},{"w":"ἀφ᾿"},{"w":"αἵμασι"},{"w":"μίσγουσι"},{"w":"."}]},{"n":3,"text":"διὰ τοῦτο πενθήσει ἡ γῆ καὶ σμικρυνθήσεται σὺν πᾶσι τοῖς κατοικοῦσιν αὐτήν, σὺν τοῖς θηρίοις τοῦ ἀγροῦ καὶ σὺν τοῖς ἑρπετοῖς τῆς γῆς καὶ σὺν τοῖς πετεινοῖς τοῦ οὐρανοῦ, καὶ οἱ ἰχθύες τῆς θαλάσσης ἐκλείψουσιν,","tokens":[{"w":"διὰ","s":"1223"},{"w":"τοῦτο","s":"3778"},{"w":"πενθήσει"},{"w":"ἡ","s":"3588"},{"w":"γῆ","s":"1093"},{"w":"καὶ","s":"2532"},{"w":"σμικρυνθήσεται"},{"w":"σὺν","s":"4862"},{"w":"πᾶσι"},{"w":"τοῖς","s":"3588"},{"w":"κατοικοῦσιν","s":"2730"},{"w":"αὐτήν","s":"846"},{"w":","},{"w":"σὺν","s":"4862"},{"w":"τοῖς","s":"3588"