{"book":"ruth","name":"Ruth","chapter":1,"verses":[{"n":1,"text":"ΚΑΙ ἐγένετο ἐν τῷ κρίνειν τοὺς κριτὰς καὶ ἐγένετο λιμὸς ἐν τῇ γῇ, καὶ ἐπορεύθη ἀνὴρ ἀπὸ Βηθλεὲμ τῆς Ἰούδα τοῦ παροικῆσαι ἐν ἀγρῷ Μωάβ, αὐτὸς καὶ ἡ γυνὴ αὐτοῦ καὶ οἱ δύο υἱοὶ αὐτοῦ.","tokens":[{"w":"ΚΑΙ","s":"2532"},{"w":"ἐγένετο","s":"1096"},{"w":"ἐν","s":"1722"},{"w":"τῷ","s":"3588"},{"w":"κρίνειν","s":"2919"},{"w":"τοὺς","s":"3588"},{"w":"κριτὰς","s":"2923"},{"w":"καὶ","s":"2532"},{"w":"ἐγένετο","s":"1096"},{"w":"λιμὸς","s":"3042"},{"w":"ἐν","s":"1722"},{"w":"τῇ","s":"3588"},{"w":"γῇ","s":"1093"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ἐπορεύθη","s":"4198"},{"w":"ἀνὴρ","s":"435"},{"w":"ἀπὸ","s":"575"},{"w":"Βηθλεὲμ","s":"965"},{"w":"τῆς","s":"3588"},{"w":"Ἰούδα","s":"2455"},{"w":"τοῦ","s":"3588"},{"w":"παροικῆσαι"},{"w":"ἐν","s":"1722"},{"w":"ἀγρῷ","s":"68"},{"w":"Μωάβ"},{"w":","},{"w":"αὐτὸς","s":"846"},{"w":"καὶ","s":"2532"},{"w":"ἡ","s":"3588"},{"w":"γυνὴ","s":"1135"},{"w":"αὐτοῦ","s":"846"},{"w":"καὶ","s":"2532"},{"w":"οἱ","s":"3588"},{"w":"δύο","s":"1417"},{"w":"υἱοὶ","s":"5207"},{"w":"αὐτοῦ","s":"846"},{"w":"."}]},{"n":2,"text":"καὶ ὄνομα τῷ ἀνδρὶ Ἐλιμέλεχ, καὶ ὄνομα τῇ γυναικὶ αὐτοῦ Νεωμίν, καὶ ὄνομα τοῖς δυσὶν υἱοῖς αὐτοῦ Μααλὼν καὶ Χελαιών, Ἐφραθαῖοι ἐκ Βηθλεὲμ τῆς Ἰούδα· καὶ ἤλθοσαν εἰς ἀγρὸν Μωὰβ καὶ ἦσαν ἐκεῖ.","tokens":[{"w":"καὶ","s":"2532"},{"w":"ὄνομα","s":"3686"},{"w":"τῷ","s":"3588"},{"w":"ἀνδρὶ","s":"435"},{"w":"Ἐλιμέλεχ"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ὄνομα","s":"3686"},{"w":"τῇ","s":"3588"},{"w":"γυναικὶ","s":"1135"},{"w":"αὐτοῦ","s":"846"},{"w":"Νεωμίν"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ὄνομα","s":"3686"},{"w":"τοῖς","s":"3588"},{"w":"δυσὶν","s":"1417"},{"w":"υἱοῖς","s":"5207"},{"w":"αὐτοῦ","s":"846"},{"w":"Μααλὼν"},{"w":"καὶ","s":"2532"},{"w":"Χελαιών"},{"w":","},{"w":"Ἐφραθαῖοι"},{"w":"ἐκ","s":"1537"},{"w":"Βηθλεὲμ","s":"965"},{"w":"τῆς","s":"3588"},{"w":"Ἰούδα·","s":"2455"},{"w":"καὶ","s":"2532"},{"w":"ἤλθοσαν"},{"w":"εἰς","s":"1519"},{"w":"ἀγρὸν","s":"68"},{"w