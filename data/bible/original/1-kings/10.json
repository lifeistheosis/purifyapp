λωμὼν τέσσαρες χιλιάδες θήλειαι ἵπποι εἰς ἅρματα καὶ δώδεκα χιλιάδες ἱππέων, καὶ ἔθετο αὐτὰς ἐν ταῖς πόλεσι τῶν ἁρμάτων καὶ μετὰ τοῦ βασιλέως ἐν Ἱερουσαλήμ. 26α καὶ ἦν ἡγούμενος πάντων τῶν βασιλέων ἀπὸ τοῦ ποταμοῦ καὶ ἕως γῆς ἀλλοφύλων καὶ ἕως ὁρίων Αἰγύπτου. 27καὶ ἔδωκεν ὁ βασιλεὺς τὸ χρυσίον καὶ τὸ ἀργύριον ἐν Ἱερουσαλὴμ ὡς λίθους, καὶ τὰς κέδρους ἔδωκεν ὡς συκαμίνους τὰς ἐν τῇ πεδινῇ εἰς πλῆθος,","tokens":[{"w":"καὶ","s":"2532"},{"w":"ἦσαν","s":"1510"},{"w":"τῷ","s":"3588"},{"w":"Σαλωμὼν"},{"w":"τέσσαρες","s":"5064"},{"w":"χιλιάδες","s":"5505"},{"w":"θήλειαι","s":"2338"},{"w":"ἵπποι"},{"w":"εἰς","s":"1519"},{"w":"ἅρματα"},{"w":"καὶ","s":"2532"},{"w":"δώδεκα","s":"1427"},{"w":"χιλιάδες","s":"5505"},{"w":"ἱππέων"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ἔθετο","s":"5087"},{"w":"αὐτὰς","s":"846"},{"w":"ἐν","s":"1722"},{"w":"ταῖς","s":"3588"},{"w":"πόλεσι"},{"w":"τῶν","s":"3588"},{"w":"ἁρμάτων","s":"716"},{"w":"καὶ","s":"2532"},{"w":"μετὰ","s":"3326"},{"w":"τοῦ","s":"3588"},{"w":"βασιλέως","s":"935"},{"w":"ἐν","s":"1722"},{"w":"Ἱερουσαλήμ","s":"2419"},{"w":"."},{"w":"26α"},{"w":"καὶ","s":"2532"},{"w":"ἦν","s":"1510"},{"w":"ἡγούμενος","s":"2233"},{"w":"πάντων","s":"3956"},{"w":"τῶν","s":"3588"},{"w":"βασιλέων","s":"935"},{"w":"ἀπὸ","s":"575"},{"w":"τοῦ","s":"3588"},{"w":"ποταμοῦ","s":"4215"},{"w":"καὶ","s":"2532"},{"w":"ἕως","s":"2193"},{"w":"γῆς","s":"1093"},{"w":"ἀλλοφύλων"},{"w":"καὶ","s":"2532"},{"w":"ἕως","s":"2193"},{"w":"ὁρίων","s":"3725"},{"w":"Αἰγύπτου","s":"125"},{"w":"."},{"w":"27καὶ"},{"w":"ἔδωκεν","s":"1325"},{"w":"ὁ","s":"3588"},{"w":"βασιλεὺς","s":"935"},{"w":"τὸ","s":"3588"},{"w":"χρυσίον","s":"5553"},{"w":"καὶ","s":"2532"},{"w":"τὸ","s":"3588"},{"w":"ἀργύριον","s":"694"},{"w":"ἐν","s":"1722"},{"w":"Ἱερουσαλὴμ","s":"2419"},{"w":"ὡς","s":"5613"},{"w":"λίθους","s":"3037"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"τὰς","s":"3588"},{"w":"κέδρους"},{"w":"ἔδωκεν","s":"1325"},{"w":"ὡς","s":"5613"},{"w":"συκαμίνους"},{"w":"τὰς","s":"3588"},{"w":"ἐν","s":"1722"},{"