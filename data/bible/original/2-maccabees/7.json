{"book":"2-maccabees","name":"2 Maccabees","chapter":7,"verses":[{"n":1,"text":"Ωσπερ γὰρ ἄριστος κυβερνήτης ὁ τοῦ πατρὸς ἡμῶν Ἐλεαζάρου λογισμὸς πηδαλιουχῶν τὴν τῆς εὐσεβείας ναῦν ἐν τῷ τῶν παθῶν πελάγει","tokens":[{"w":"Ωσπερ","s":"5618"},{"w":"γὰρ","s":"1063"},{"w":"ἄριστος"},{"w":"κυβερνήτης","s":"2942"},{"w":"ὁ","s":"3588"},{"w":"τοῦ","s":"3588"},{"w":"πατρὸς","s":"3962"},{"w":"ἡμῶν","s":"1473"},{"w":"Ἐλεαζάρου"},{"w":"λογισμὸς"},{"w":"πηδαλιουχῶν"},{"w":"τὴν","s":"3588"},{"w":"τῆς","s":"3588"},{"w":"εὐσεβείας","s":"2150"},{"w":"ναῦν","s":"3491"},{"w":"ἐν","s":"1722"},{"w":"τῷ","s":"3588"},{"w":"τῶν","s":"3588"},{"w":"παθῶν","s":"3958"},{"w":"πελάγει","s":"3989"}]},{"n":2,"text":"καὶ καταικιζόμενος ταῖς τοῦ τυράννου ἀπειλαῖς καὶ καταντλούμενος ταῖς τῶν βασάνων τρικυμίαις,","tokens":[{"w":"καὶ","s":"2532"},{"w":"καταικιζόμενος"},{"w":"ταῖς","s":"3588"},{"w":"τοῦ","s":"3588"},{"w":"τυράννου","s":"5181"},{"w":"ἀπειλαῖς"},{"w":"καὶ","s":"2532"},{"w":"καταντλούμενος"},{"w":"ταῖς","s":"3588"},{"w":"τῶν","s":"3588"},{"w":"βασάνων"},{"w":"τρικυμίαις"},{"w":","}]},{"n":3,"text":"κατ' οὐδένα τρόπον μετέτρεψε τοὺς τῆς εὐσεβείας οἴακας, ἕως οὗ ἔπλευσεν ἐπὶ τὸν τῆς ἀθανάτου νίκης λιμένα.","tokens":[{"w":"κατ'"},{"w":"οὐδένα","s":"3762"},{"w":"τρόπον","s":"5158"},{"w":"μετέτρεψε"},{"w":"τοὺς","s":"3588"},{"w":"τῆς","s":"3588"},{"w":"εὐσεβείας","s":"2150"},{"w":"οἴακας"},{"w":","},{"w":"ἕως","s":"2193"},{"w":"οὗ","s":"3756"},{"w":"ἔπλευσεν"},{"w":"ἐπὶ","s":"1909"},{"w":"τὸν","s":"3588"},{"w":"τῆς","s":"3588"},{"w":"ἀθανάτου"},{"w":"νίκης"},{"w":"λιμένα","s":"3040"},{"w":"."}]},{"n":4,"text":"οὐχ οὕτως πόλις πολλοῖς καὶ ποικίλοις μηχανήμασιν ἀντέσχε ποτὲ πολιορκουμένη, ὡς ὁ πανάγιος Ἐλεάζαρος· τὴν ἱερὰν ψυχὴν αἰκισμοῖς τε καὶ στρέβλαις πυρπολούμενος ἐνίκησε τοὺς πολιορκοῦντας διὰ τὸν ὑπερασπίζοντα τῆς εὐσεβείας λογισμόν.","tokens":[{"w":"οὐχ","s":"3756"},{"w":"οὕτως","s":"3779"},{"w":"πόλις","s":"4172"},{"w":"πολλοῖς","s":"4183"},{"w":"καὶ","s":"2532"},{"w":"ποικίλοις","s":"41