{"book":"psalms","name":"Psalms","chapter":122,"verses":[{"n":1,"text":"ᾨδὴ τῶν ἀναβαθμῶν. ΠΡΟΣ σὲ ἦρα τοὺς ὀφθαλμούς μου τὸν κατοικοῦντα ἐν τῷ οὐρανῷ.","tokens":[{"w":"ᾨδὴ"},{"w":"τῶν","s":"3588"},{"w":"ἀναβαθμῶν","s":"304"},{"w":"."},{"w":"ΠΡΟΣ","s":"4314"},{"w":"σὲ","s":"4771"},{"w":"ἦρα"},{"w":"τοὺς","s":"3588"},{"w":"ὀφθαλμούς","s":"3788"},{"w":"μου","s":"1473"},{"w":"τὸν","s":"3588"},{"w":"κατοικοῦντα"},{"w":"ἐν","s":"1722"},{"w":"τῷ","s":"3588"},{"w":"οὐρανῷ","s":"3772"},{"w":"."}]},{"n":2,"text":"ἰδοὺ ὡς ὀφθαλμοὶ δούλων εἰς χεῖρας τῶν κυρίων αὐτῶν, ὡς ὀφθαλμοὶ παιδίσκης εἰς χεῖρας τῆς κυρίας αὐτῆς, οὕτως οἱ ὀφθαλμοὶ ἡμῶν πρὸς Κύριον τὸν Θεὸν ἡμῶν, ἕως οὗ οἰκτειρῆσαι ἡμᾶς.","tokens":[{"w":"ἰδοὺ","s":"3708"},{"w":"ὡς","s":"5613"},{"w":"ὀφθαλμοὶ","s":"3788"},{"w":"δούλων","s":"1401"},{"w":"εἰς","s":"1519"},{"w":"χεῖρας","s":"5495"},{"w":"τῶν","s":"3588"},{"w":"κυρίων","s":"2962"},{"w":"αὐτῶν","s":"846"},{"w":","},{"w":"ὡς","s":"5613"},{"w":"ὀφθαλμοὶ","s":"3788"},{"w":"παιδίσκης","s":"3814"},{"w":"εἰς","s":"1519"},{"w":"χεῖρας","s":"5495"},{"w":"τῆς","s":"3588"},{"w":"κυρίας"},{"w":"αὐτῆς","s":"846"},{"w":","},{"w":"οὕτως","s":"3779"},{"w":"οἱ","s":"3588"},{"w":"ὀφθαλμοὶ","s":"3788"},{"w":"ἡμῶν","s":"1473"},{"w":"πρὸς","s":"4314"},{"w":"Κύριον","s":"2962"},{"w":"τὸν","s":"3588"},{"w":"Θεὸν","s":"2316"},{"w":"ἡμῶν","s":"1473"},{"w":","},{"w":"ἕως","s":"2193"},{"w":"οὗ","s":"3756"},{"w":"οἰκτειρῆσαι"},{"w":"ἡμᾶς","s":"1473"},{"w":"."}]},{"n":3,"text":"ἐλέησον ἡμᾶς, Κύριε, ἐλέησον ἡμᾶς, ὅτι ἐπὶ πολὺ ἐπλήσθημεν ἐξουδενώσεως,","tokens":[{"w":"ἐλέησον","s":"1653"},{"w":"ἡμᾶς","s":"1473"},{"w":","},{"w":"Κύριε","s":"2962"},{"w":","},{"w":"ἐλέησον","s":"1653"},{"w":"ἡμᾶς","s":"1473"},{"w":","},{"w":"ὅτι","s":"3754"},{"w":"ἐπὶ","s":"1909"},{"w":"πολὺ","s":"4183"},{"w":"ἐπλήσθημεν"},{"w":"ἐξουδενώσεως"},{"w":","}]},{"n":4,"text":"ἐπὶ πλεῖον ἐπλήσθη ἡ ψυχὴ ἡμῶν. Τὸ ὄνειδος τοῖς εὐθηνοῦσι, καὶ ἡ ἐξουδένωσις τοῖς ὑπερηφάνοις.","tokens":[{"w":"ἐπὶ","s":"1909"},{"w":"πλεῖον","