{"book":"psalms","name":"Psalms","chapter":99,"verses":[{"n":1,"text":"Ψαλμὸς εἰς ἐξομολόγησιν. ΑΛΑΛΑΞΑΤΕ τῷ Κυρίῳ, πᾶσα ἡ γῆ,","tokens":[{"w":"Ψαλμὸς"},{"w":"εἰς","s":"1519"},{"w":"ἐξομολόγησιν"},{"w":"."},{"w":"ΑΛΑΛΑΞΑΤΕ"},{"w":"τῷ","s":"3588"},{"w":"Κυρίῳ","s":"2962"},{"w":","},{"w":"πᾶσα","s":"3956"},{"w":"ἡ","s":"3588"},{"w":"γῆ","s":"1093"},{"w":","}]},{"n":2,"text":"δουλεύσατε τῷ Κυρίῳ ἐν εὐφροσύνῃ, εἰσέλθετε ἐνώπιον αὐτοῦ ἐν ἀγαλλιάσει.","tokens":[{"w":"δουλεύσατε"},{"w":"τῷ","s":"3588"},{"w":"Κυρίῳ","s":"2962"},{"w":"ἐν","s":"1722"},{"w":"εὐφροσύνῃ"},{"w":","},{"w":"εἰσέλθετε","s":"1525"},{"w":"ἐνώπιον","s":"1799"},{"w":"αὐτοῦ","s":"846"},{"w":"ἐν","s":"1722"},{"w":"ἀγαλλιάσει","s":"20"},{"w":"."}]},{"n":3,"text":"γνῶτε ὅτι Κύριος, αὐτός ἐστιν ὁ Θεὸς ἡμῶν, αὐτὸς ἐποίησεν ἡμᾶς καὶ οὐχ ἡμεῖς· ἡμεῖς δὲ λαὸς αὐτοῦ καὶ πρόβατα τῆς νομῆς αὐτοῦ.","tokens":[{"w":"γνῶτε","s":"1097"},{"w":"ὅτι","s":"3754"},{"w":"Κύριος","s":"2962"},{"w":","},{"w":"αὐτός","s":"846"},{"w":"ἐστιν","s":"1510"},{"w":"ὁ","s":"3588"},{"w":"Θεὸς","s":"2316"},{"w":"ἡμῶν","s":"1473"},{"w":","},{"w":"αὐτὸς","s":"846"},{"w":"ἐποίησεν","s":"4160"},{"w":"ἡμᾶς","s":"1473"},{"w":"καὶ","s":"2532"},{"w":"οὐχ","s":"3756"},{"w":"ἡμεῖς·","s":"1473"},{"w":"ἡμεῖς","s":"1473"},{"w":"δὲ","s":"1161"},{"w":"λαὸς","s":"2992"},{"w":"αὐτοῦ","s":"846"},{"w":"καὶ","s":"2532"},{"w":"πρόβατα","s":"4263"},{"w":"τῆς","s":"3588"},{"w":"νομῆς"},{"w":"αὐτοῦ","s":"846"},{"w":"."}]},{"n":4,"text":"εἰσέλθετε εἰς τὰς πύλας αὐτοῦ ἐν ἐξομολογήσει, εἰς τὰς αὐλὰς αὐτοῦ ἐν ὕμνοις. ἐξομολογεῖσθε αὐτῷ, αἰνεῖτε τὸ ὄνομα αὐτοῦ,","tokens":[{"w":"εἰσέλθετε","s":"1525"},{"w":"εἰς","s":"1519"},{"w":"τὰς","s":"3588"},{"w":"πύλας","s":"4439"},{"w":"αὐτοῦ","s":"846"},{"w":"ἐν","s":"1722"},{"w":"ἐξομολογήσει"},{"w":","},{"w":"εἰς","s":"1519"},{"w":"τὰς","s":"3588"},{"w":"αὐλὰς"},{"w":"αὐτοῦ","s":"846"},{"w":"ἐν","s":"1722"},{"w":"ὕμνοις","s":"5215"},{"w":"."},{"w":"ἐξομολογεῖσθε","s":"1843"},{"w":"αὐτῷ","s":"846"},{"w":","},{"w":"αἰνεῖτε","s"