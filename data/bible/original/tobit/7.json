{"book":"tobit","name":"Tobit","chapter":7,"verses":[{"n":1,"text":"ΚΑΙ ἦλθον εἰς Ἐκβάτανα καὶ παρεγένοντο εἰς τὴν οἰκίαν Ραγουήλ, Σάρρα δὲ ὑπήντησεν αὐτοῖς καὶ ἐχαιρέτισεν αὐτοὺς καὶ αὐτοὶ αὐτήν, καὶ εἰσήγαγεν αὐτοὺς εἰς τὴν οἰκίαν.","tokens":[{"w":"ΚΑΙ","s":"2532"},{"w":"ἦλθον","s":"2064"},{"w":"εἰς","s":"1519"},{"w":"Ἐκβάτανα"},{"w":"καὶ","s":"2532"},{"w":"παρεγένοντο","s":"3854"},{"w":"εἰς","s":"1519"},{"w":"τὴν","s":"3588"},{"w":"οἰκίαν","s":"3614"},{"w":"Ραγουήλ"},{"w":","},{"w":"Σάρρα","s":"4564"},{"w":"δὲ","s":"1161"},{"w":"ὑπήντησεν","s":"5221"},{"w":"αὐτοῖς","s":"846"},{"w":"καὶ","s":"2532"},{"w":"ἐχαιρέτισεν"},{"w":"αὐτοὺς","s":"846"},{"w":"καὶ","s":"2532"},{"w":"αὐτοὶ","s":"846"},{"w":"αὐτήν","s":"846"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"εἰσήγαγεν","s":"1521"},{"w":"αὐτοὺς","s":"846"},{"w":"εἰς","s":"1519"},{"w":"τὴν","s":"3588"},{"w":"οἰκίαν","s":"3614"},{"w":"."}]},{"n":2,"text":"καὶ εἶπε Ραγουὴλ Ἔδνᾳ τῇ γυναικὶ αὐτοῦ· ὡς ὅμοιος ὁ νεανίσκος Τωβὶτ τῷ ἀνεψιῷ μου;","tokens":[{"w":"καὶ","s":"2532"},{"w":"εἶπε","s":"3004"},{"w":"Ραγουὴλ"},{"w":"Ἔδνᾳ"},{"w":"τῇ","s":"3588"},{"w":"γυναικὶ","s":"1135"},{"w":"αὐτοῦ·","s":"846"},{"w":"ὡς","s":"5613"},{"w":"ὅμοιος","s":"3664"},{"w":"ὁ","s":"3588"},{"w":"νεανίσκος","s":"3495"},{"w":"Τωβὶτ"},{"w":"τῷ","s":"3588"},{"w":"ἀνεψιῷ"},{"w":"μου","s":"1473"},{"w":";"}]},{"n":3,"text":"καὶ ἠρώτησεν αὐτούς Ραγουήλ· πόθεν ἐστέ, ἀδελφοί; καὶ εἶπαν αὐτῷ· ἐκ τῶν υἱῶν Νεφθαλὶμ τῶν αἰχμαλώτων ἐκ Νινευῆ.","tokens":[{"w":"καὶ","s":"2532"},{"w":"ἠρώτησεν","s":"2065"},{"w":"αὐτούς","s":"846"},{"w":"Ραγουήλ·"},{"w":"πόθεν","s":"4159"},{"w":"ἐστέ","s":"1510"},{"w":","},{"w":"ἀδελφοί","s":"80"},{"w":";"},{"w":"καὶ","s":"2532"},{"w":"εἶπαν"},{"w":"αὐτῷ·","s":"846"},{"w":"ἐκ","s":"1537"},{"w":"τῶν","s":"3588"},{"w":"υἱῶν","s":"5207"},{"w":"Νεφθαλὶμ"},{"w":"τῶν","s":"3588"},{"w":"αἰχμαλώτων"},{"w":"ἐκ","s":"1537"},{"w":"Νινευῆ"},{"w":"."}]},{"n":4,"text":"καὶ εἶπεν αὐτοῖς· γινώσκετε Τωβὶτ τὸν ἀδελφὸν ἡμῶν; οἱ δὲ εἶπον· γινώσκομεν. καὶ ε