λησεν Ἰωνᾶς ὁ προφήτης περὶ Νινευῆ, ὅτι καταστραφήσεται, ἐν δὲ τῇ Μηδίᾳ ἔσται εἰρήνη μᾶλλον ἕως καιροῦ, καὶ ὅτι οἱ ἀδελφοὶ ἡμῶν ἐν τῇ γῇ σκορπισθήσονται ἀπὸ τῆς ἀγαθῆς γῆς, καὶ Ἱεροσόλυμα ἔσται ἔρημος, καὶ ὁ οἶκος τοῦ Θεοῦ ἐν αὐτῇ κατακαήσεται καὶ ἔρημος ἔσται μέχρι χρόνου.","tokens":[{"w":"ἄπελθε"},{"w":"εἰς","s":"1519"},{"w":"τὴν","s":"3588"},{"w":"Μηδίαν"},{"w":","},{"w":"τέκνον","s":"5043"},{"w":","},{"w":"ὅτι","s":"3754"},{"w":"πέπεισμαι","s":"3982"},{"w":"ὅσα","s":"3745"},{"w":"ἐλάλησεν","s":"2980"},{"w":"Ἰωνᾶς","s":"2495"},{"w":"ὁ","s":"3588"},{"w":"προφήτης","s":"4396"},{"w":"περὶ","s":"4012"},{"w":"Νινευῆ"},{"w":","},{"w":"ὅτι","s":"3754"},{"w":"καταστραφήσεται"},{"w":","},{"w":"ἐν","s":"1722"},{"w":"δὲ","s":"1161"},{"w":"τῇ","s":"3588"},{"w":"Μηδίᾳ"},{"w":"ἔσται","s":"1510"},{"w":"εἰρήνη","s":"1515"},{"w":"μᾶλλον","s":"3123"},{"w":"ἕως","s":"2193"},{"w":"καιροῦ","s":"2540"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ὅτι","s":"3754"},{"w":"οἱ","s":"3588"},{"w":"ἀδελφοὶ","s":"80"},{"w":"ἡμῶν","s":"1473"},{"w":"ἐν","s":"1722"},{"w":"τῇ","s":"3588"},{"w":"γῇ","s":"1093"},{"w":"σκορπισθήσονται"},{"w":"ἀπὸ","s":"575"},{"w":"τῆς","s":"3588"},{"w":"ἀγαθῆς","s":"18"},{"w":"γῆς","s":"1093"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"Ἱεροσόλυμα","s":"2414"},{"w":"ἔσται","s":"1510"},{"w":"ἔρημος","s":"2048"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ὁ","s":"3588"},{"w":"οἶκος","s":"3624"},{"w":"τοῦ","s":"3588"},{"w":"Θεοῦ","s":"2316"},{"w":"ἐν","s":"1722"},{"w":"αὐτῇ","s":"846"},{"w":"κατακαήσεται","s":"2618"},{"w":"καὶ","s":"2532"},{"w":"ἔρημος","s":"2048"},{"w":"ἔσται","s":"1510"},{"w":"μέχρι","s":"3360"},{"w":"χρόνου","s":"5550"},{"w":"."}]},{"n":5,"text":"καὶ πάλιν ἐλεήσει αὐτοὺς ὁ Θεὸς καὶ ἐπιστρέψει αὐτοὺς εἰς τὴν γῆν, καὶ οἰκοδομήσουσι τὸν οἶκον, οὐχ οἷος ὁ πρότερος, ἕως πληρωθῶσι καιροὶ τοῦ αἰῶνος. καὶ μετὰ ταῦτα ἐπιστρέψουσιν ἐκ τῶν αἰχμαλωσιῶν καί οἰκοδομήσουσιν Ἱερουσαλὴμ ἐντίμως, καὶ ὁ οἶκος τοῦ Θεοῦ ἐν αὐτῇ οἰκοδομηθήσεται εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος οἰκοδομῇ ἐν