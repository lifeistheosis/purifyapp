","s":"1510"},{"w":"γάρ","s":"1063"},{"w":"σοι","s":"4771"},{"w":"Κύριος","s":"2962"},{"w":"φῶς","s":"5457"},{"w":"αἰώνιον","s":"166"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ἀναπληρωθήσονται"},{"w":"αἱ","s":"3588"},{"w":"ἡμέραι","s":"2250"},{"w":"τοῦ","s":"3588"},{"w":"πένθους"},{"w":"σου","s":"4771"},{"w":"."}]},{"n":21,"text":"καὶ ὁ λαός σου πᾶς δίκαιος, δι᾿ αἰῶνος κληρονομήσουσι τὴν γῆν, φυλάσσων τὸ φύτευμα, ἔργα χειρῶν αὐτοῦ εἰς δόξαν.","tokens":[{"w":"καὶ","s":"2532"},{"w":"ὁ","s":"3588"},{"w":"λαός","s":"2992"},{"w":"σου","s":"4771"},{"w":"πᾶς","s":"3956"},{"w":"δίκαιος","s":"1342"},{"w":","},{"w":"δι᾿"},{"w":"αἰῶνος","s":"165"},{"w":"κληρονομήσουσι"},{"w":"τὴν","s":"3588"},{"w":"γῆν","s":"1093"},{"w":","},{"w":"φυλάσσων","s":"5442"},{"w":"τὸ","s":"3588"},{"w":"φύτευμα"},{"w":","},{"w":"ἔργα","s":"2041"},{"w":"χειρῶν","s":"5495"},{"w":"αὐτοῦ","s":"846"},{"w":"εἰς","s":"1519"},{"w":"δόξαν","s":"1391"},{"w":"."}]},{"n":22,"text":"ὁ ὀλιγοστὸς ἔσται εἰς χιλιάδας καὶ ὁ ἐλάχιστος εἰς ἔθνος μέγα· ἐγὼ Κύριος κατὰ καιρὸν συνάξω αὐτούς.","tokens":[{"w":"ὁ","s":"3588"},{"w":"ὀλιγοστὸς"},{"w":"ἔσται","s":"1510"},{"w":"εἰς","s":"1519"},{"w":"χιλιάδας"},{"w":"καὶ","s":"2532"},{"w":"ὁ","s":"3588"},{"w":"ἐλάχιστος","s":"1646"},{"w":"εἰς","s":"1519"},{"w":"ἔθνος","s":"1484"},{"w":"μέγα·","s":"3173"},{"w":"ἐγὼ","s":"1473"},{"w":"Κύριος","s":"2962"},{"w":"κατὰ","s":"2596"},{"w":"καιρὸν","s":"2540"},{"w":"συνάξω","s":"4863"},{"w":"αὐτούς","s":"846"},{"w":"."}]}],"source":"Septuagint (Swete edition, Greek). Public domain."}