{"book":"isaiah","name":"Isaiah","chapter":52,"verses":[{"n":1,"text":"ΕΞΕΓΕΙΡΟΥ ἐξεγείρου, Σιών, ἔνδυσαι τὴν ἰσχύν σου, Σιών, καὶ ἔνδυσαι τὴν δόξαν σου, Ἱερουσαλὴμ πόλις ἡ ἁγία· οὐκέτι προστεθήσεται διελθεῖν διὰ σοῦ ἀπερίτμητος καὶ ἀκάθαρτος.","tokens":[{"w":"ΕΞΕΓΕΙΡΟΥ"},{"w":"ἐξεγείρου"},{"w":","},{"w":"Σιών","s":"4622"},{"w":","},{"w":"ἔνδυσαι"},{"w":"τὴν","s":"3588"},{"w":"ἰσχύν","s":"2479"},{"w":"σου","s":"4771"},{"w":","},{"w":"Σιών","s":"4622"},{"w":","},{"w":"καὶ","s":"2532"},{"w":"ἔνδυσαι"},{"w":"τὴν","s":"3588"},{"w":"δόξαν","s":"1391"},{"w":"σου","s":"4771"},{"w":","},{"w":"Ἱερουσαλὴμ","s":"2419"},{"w":"πόλις","s":"4172"},{"w":"ἡ","s":"3588"},{"w":"ἁγία·","s":"40"},{"w":"οὐκέτι","s":"3765"},{"w":"προστεθήσεται","s":"4369"},{"w":"διελθεῖν","s":"1330"},{"w":"διὰ","s":"1223"},{"w":"σοῦ","s":"4771"},{"w":"ἀπερίτμητος"},{"w":"καὶ","s":"2532"},{"w":"ἀκάθαρτος","s":"169"},{"w":"."}]},{"n":2,"text":"ἐκτίναξαι τὸν χοῦν καὶ ἀνάστηθι, κάθισον, Ἱερουσαλήμ· ἔκδυσαι τὸν δεσμὸν τοῦ τραχήλου σου, ἡ αἰχμάλωτος θυγάτηρ Σιών.","tokens":[{"w":"ἐκτίναξαι"},{"w":"τὸν","s":"3588"},{"w":"χοῦν","s":"5522"},{"w":"καὶ","s":"2532"},{"w":"ἀνάστηθι","s":"450"},{"w":","},{"w":"κάθισον"},{"w":","},{"w":"Ἱερουσαλήμ·","s":"2419"},{"w":"ἔκδυσαι"},{"w":"τὸν","s":"3588"},{"w":"δεσμὸν"},{"w":"τοῦ","s":"3588"},{"w":"τραχήλου"},{"w":"σου","s":"4771"},{"w":","},{"w":"ἡ","s":"3588"},{"w":"αἰχμάλωτος"},{"w":"θυγάτηρ","s":"2364"},{"w":"Σιών","s":"4622"},{"w":"."}]},{"n":3,"text":"ὅτι τάδε λέγει Κύριος· δωρεὰν ἐπράθητε καὶ οὐ μετὰ ἀργυρίου λυτρωθήσεσθε.","tokens":[{"w":"ὅτι","s":"3754"},{"w":"τάδε","s":"3592"},{"w":"λέγει","s":"3004"},{"w":"Κύριος·","s":"2962"},{"w":"δωρεὰν","s":"1432"},{"w":"ἐπράθητε"},{"w":"καὶ","s":"2532"},{"w":"οὐ","s":"3756"},{"w":"μετὰ","s":"3326"},{"w":"ἀργυρίου","s":"694"},{"w":"λυτρωθήσεσθε"},{"w":"."}]},{"n":4,"text":"οὕτως λέγει Κύριος· εἰς Αἴγυπτον κατέβη ὁ λαός μου τὸ πρότερον παροικῆσαι ἐκεῖ, καὶ εἰς Ἀσσυρίους βίᾳ ἤχθησαν·","tokens":[{"w":"οὕτως","s":"3779"},{"w":"λέγε