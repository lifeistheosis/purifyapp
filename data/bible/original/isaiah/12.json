{"book":"isaiah","name":"Isaiah","chapter":12,"verses":[{"n":1,"text":"ΚΑΙ ἐρεῖς ἐν τῇ ἡμέρᾳ ἐκείνῃ· εὐλογήσω σε, Κύριε, διότι ὠργίσθης μοι καὶ ἀπέστρεψας τὸν θυμόν σου καὶ ἠλέησάς με.","tokens":[{"w":"ΚΑΙ","s":"2532"},{"w":"ἐρεῖς","s":"2046"},{"w":"ἐν","s":"1722"},{"w":"τῇ","s":"3588"},{"w":"ἡμέρᾳ","s":"2250"},{"w":"ἐκείνῃ·","s":"1565"},{"w":"εὐλογήσω","s":"2127"},{"w":"σε","s":"4771"},{"w":","},{"w":"Κύριε","s":"2962"},{"w":","},{"w":"διότι","s":"1360"},{"w":"ὠργίσθης"},{"w":"μοι","s":"1473"},{"w":"καὶ","s":"2532"},{"w":"ἀπέστρεψας"},{"w":"τὸν","s":"3588"},{"w":"θυμόν","s":"2372"},{"w":"σου","s":"4771"},{"w":"καὶ","s":"2532"},{"w":"ἠλέησάς"},{"w":"με","s":"1473"},{"w":"."}]},{"n":2,"text":"ἰδοὺ ὁ Θεός μου σωτήρ μου Κύριος, πεποιθὼς ἔσομαι ἐπ᾿ αὐτῷ καὶ σωθήσομαι ἐν αὐτῷ καὶ οὐ φοβηθήσομαι, διότι ἡ δόξα μου καὶ ἡ αἴνεσίς μου Κύριος καὶ ἐγένετό μοι εἰς σωτηρίαν.","tokens":[{"w":"ἰδοὺ","s":"3708"},{"w":"ὁ","s":"3588"},{"w":"Θεός","s":"2316"},{"w":"μου","s":"1473"},{"w":"σωτήρ","s":"4990"},{"w":"μου","s":"1473"},{"w":"Κύριος","s":"2962"},{"w":","},{"w":"πεποιθὼς","s":"3982"},{"w":"ἔσομαι","s":"1510"},{"w":"ἐπ᾿"},{"w":"αὐτῷ","s":"846"},{"w":"καὶ","s":"2532"},{"w":"σωθήσομαι","s":"4982"},{"w":"ἐν","s":"1722"},{"w":"αὐτῷ","s":"846"},{"w":"καὶ","s":"2532"},{"w":"οὐ","s":"3756"},{"w":"φοβηθήσομαι","s":"5399"},{"w":","},{"w":"διότι","s":"1360"},{"w":"ἡ","s":"3588"},{"w":"δόξα","s":"1391"},{"w":"μου","s":"1473"},{"w":"καὶ","s":"2532"},{"w":"ἡ","s":"3588"},{"w":"αἴνεσίς"},{"w":"μου","s":"1473"},{"w":"Κύριος","s":"2962"},{"w":"καὶ","s":"2532"},{"w":"ἐγένετό","s":"1096"},{"w":"μοι","s":"1473"},{"w":"εἰς","s":"1519"},{"w":"σωτηρίαν","s":"4991"},{"w":"."}]},{"n":3,"text":"καὶ ἀντλήσατε ὕδωρ μετ᾿ εὐφροσύνης ἐκ τῶν πηγῶν τοῦ σωτηρίου.","tokens":[{"w":"καὶ","s":"2532"},{"w":"ἀντλήσατε","s":"501"},{"w":"ὕδωρ","s":"5204"},{"w":"μετ᾿"},{"w":"εὐφροσύνης","s":"2167"},{"w":"ἐκ","s":"1537"},{"w":"τῶν","s":"3588"},{"w":"πηγῶν"},{"w":"τοῦ","s":"3588"},{"w":"σωτηρίου","s":"4992"},{"w":"."}]},{