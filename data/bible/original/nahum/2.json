{"book":"nahum","name":"Nahum","chapter":2,"verses":[{"n":1,"text":"ΙΔΟΥ ἐπὶ τὰ ὄρη οἱ πόδες εὐαγγελιζομένου καὶ ἀπαγγέλλοντος εἰρήνην· ἑόρταζε, Ἰούδα, τὰς ἑορτάς σου, ἀπόδος τὰς εὐχάς σου, διότι οὐ μὴ προσθήσωσιν ἔτι τοῦ διελθεῖν διὰ σοῦ εἰς παλαίωσιν. Συντετέλεσται, ἐξῇρται.","tokens":[{"w":"ΙΔΟΥ","s":"3708"},{"w":"ἐπὶ","s":"1909"},{"w":"τὰ","s":"3588"},{"w":"ὄρη","s":"3735"},{"w":"οἱ","s":"3588"},{"w":"πόδες","s":"4228"},{"w":"εὐαγγελιζομένου","s":"2097"},{"w":"καὶ","s":"2532"},{"w":"ἀπαγγέλλοντος"},{"w":"εἰρήνην·","s":"1515"},{"w":"ἑόρταζε"},{"w":","},{"w":"Ἰούδα","s":"2455"},{"w":","},{"w":"τὰς","s":"3588"},{"w":"ἑορτάς"},{"w":"σου","s":"4771"},{"w":","},{"w":"ἀπόδος","s":"591"},{"w":"τὰς","s":"3588"},{"w":"εὐχάς"},{"w":"σου","s":"4771"},{"w":","},{"w":"διότι","s":"1360"},{"w":"οὐ","s":"3756"},{"w":"μὴ","s":"3361"},{"w":"προσθήσωσιν"},{"w":"ἔτι","s":"2089"},{"w":"τοῦ","s":"3588"},{"w":"διελθεῖν","s":"1330"},{"w":"διὰ","s":"1223"},{"w":"σοῦ","s":"4771"},{"w":"εἰς","s":"1519"},{"w":"παλαίωσιν"},{"w":"."},{"w":"Συντετέλεσται"},{"w":","},{"w":"ἐξῇρται"},{"w":"."}]},{"n":2,"text":"ἀνέβη ἐμφυσῶν εἰς πρόσωπόν σου ἐξαιρούμενος ἐκ θλίψεως· σκόπευσον ὁδόν, κράτησον ὀσφύος, ἄνδρισαι τῇ ἰσχύϊ σφόδρα,","tokens":[{"w":"ἀνέβη","s":"305"},{"w":"ἐμφυσῶν"},{"w":"εἰς","s":"1519"},{"w":"πρόσωπόν","s":"4383"},{"w":"σου","s":"4771"},{"w":"ἐξαιρούμενος","s":"1807"},{"w":"ἐκ","s":"1537"},{"w":"θλίψεως·","s":"2347"},{"w":"σκόπευσον"},{"w":"ὁδόν","s":"3598"},{"w":","},{"w":"κράτησον"},{"w":"ὀσφύος","s":"3751"},{"w":","},{"w":"ἄνδρισαι"},{"w":"τῇ","s":"3588"},{"w":"ἰσχύϊ","s":"2479"},{"w":"σφόδρα","s":"4970"},{"w":","}]},{"n":3,"text":"διότι ἀπέστρεψε Κύριος τὴν ὕβριν Ἰακώβ, καθὼς ὕβριν τοῦ Ἰσραήλ, διότι ἐκτινάσσοντες ἐξετίναξαν αὐτοὺς καὶ τὰ κλήματα αὐτῶν, διέφθειραν","tokens":[{"w":"διότι","s":"1360"},{"w":"ἀπέστρεψε"},{"w":"Κύριος","s":"2962"},{"w":"τὴν","s":"3588"},{"w":"ὕβριν","s":"5196"},{"w":"Ἰακώβ","s":"2384"},{"w":","},{"w":"καθὼς","s":"2531"},{"w":"ὕβριν","s":"5196"},{"w":"τοῦ"