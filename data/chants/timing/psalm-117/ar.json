{"v":1,"durationSec":355.4,"lines":[
{"at":0.29,"end":9.2,"text":"اِحْمَدُوا ٱلرَّبَّ لِأَنَّهُ صَالِحٌ،"},
{"at":9.2,"end":16.38,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":16.38,"end":19.88,"text":"هَلِّلُويَا."},
{"at":19.88,"end":34.2,"text":"اِحْمَدُوا ٱلرَّبَّ لِأَنَّهُ صَالِحٌ،"},
{"at":34.2,"end":41.83,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":41.83,"end":45.3,"text":"هَلِّلُويَا."},
{"at":45.3,"end":57.85,"text":"مِنَ ٱلضِّيقِ دَعَوْتُ ٱلرَّبَّ فَأَجَابَنِي مِنَ ٱلرُّحْبِ."},
{"at":57.85,"end":64.99,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":64.99,"end":68.64,"text":"هَلِّلُويَا."},
{"at":68.64,"end":74.87,"text":"ٱلِٱحْتِمَاءُ بِٱلرَّبِّ"},
{"at":74.87,"end":84.35,"text":"خَيْرٌ مِنَ ٱلتَّوَكُّلِ عَلَى إِنْسَانٍ."},
{"at":84.35,"end":91.98,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":91.98,"end":95.59,"text":"هَلِّلُويَا."},
{"at":95.59,"end":101.57,"text":"ٱلِٱحْتِمَاءُ بِٱلرَّبِّ"},
{"at":101.57,"end":111.8,"text":"خَيْرٌ مِنَ ٱلتَّوَكُّلِ عَلَى ٱلرُّؤَسَاءِ."},
{"at":111.8,"end":119.3,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":119.3,"end":122.9,"text":"هَلِّلُويَا."},
{"at":122.9,"end":130.77,"text":"قُوَّتِي وَتَرَنُّمِي ٱلرَّبُّ، وَقَدْ صَارَ لِي خَلَاصًا."},
{"at":130.77,"end":137.38,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":137.38,"end":140.7,"text":"هَلِّلُويَا."},
{"at":140.7,"end":149.69,"text":"يَمِينُ ٱلرَّبِّ مُرْتَفِعَةٌ. يَمِينُ ٱلرَّبِّ صَانِعَةٌ بِبَأْسٍ."},
{"at":149.69,"end":157.06,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":157.06,"end":160.33,"text":"هَلِّلُويَا."},
{"at":160.33,"end":169.13,"text":"تَأْدِيبًا أَدَّبَنِي ٱلرَّبُّ، وَإِلَى ٱلْمَوْتِ لَمْ يُسْلِمْنِي."},
{"at":169.13,"end":176.43,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":176.43,"end":180.03,"text":"هَلِّلُويَا."},
{"at":180.03,"end":188.35,"text":"اِفْتَحُوا لِي أَبْوَابَ ٱلْبِرِّ. أَدْخُلْ فِيهَا وَأَحْمَدِ ٱلرَّبَّ."},
{"at":188.35,"end":195.83,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":195.83,"end":199.3,"text":"هَلِّلُويَا."},
{"at":199.3,"end":207.02,"text":"هَذَا ٱلْبَابُ لِلرَّبِّ. ٱلصِّدِّيقُونَ يَدْخُلُونَ فِيهِ."},
{"at":207.02,"end":214.66,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":214.66,"end":218.28,"text":"هَلِّلُويَا."},
{"at":218.28,"end":227.21,"text":"أَحْمَدُكَ لِأَنَّكَ ٱسْتَجَبْتَ لِي وَصِرْتَ لِي خَلَاصًا."},
{"at":227.21,"end":235.7,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":235.7,"end":239.3,"text":"هَلِّلُويَا."},
{"at":239.3,"end":250.19,"text":"ٱلْحَجَرُ ٱلَّذِي رَفَضَهُ ٱلْبَنَّاؤُونَ قَدْ صَارَ رَأْسَ ٱلزَّاوِيَةِ."},
{"at":250.19,"end":258,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":258,"end":261.1,"text":"هَلِّلُويَا."},
{"at":261.1,"end":270.68,"text":"مِنْ قِبَلِ ٱلرَّبِّ كَانَ هَذَا، وَهُوَ عَجِيبٌ فِي أَعْيُنِنَا."},
{"at":270.68,"end":278.2,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":278.2,"end":281.66,"text":"هَلِّلُويَا."},
{"at":281.66,"end":294.71,"text":"هَذَا هُوَ ٱلْيَوْمُ ٱلَّذِي صَنَعُهُ ٱلرَّبُّ، نَبْتَهِجُ وَنَفْرَحُ فِيهِ."},
{"at":294.71,"end":302.05,"text":"آهِ يَارَبُّ خَلِّصْ! آهِ يَارَبُّ أَنْقِذْ!"},
{"at":302.05,"end":316.75,"text":"إِلَهِي أَنْتَ فَأَحْمَدُكَ، إِلَهِي فَأَرْفَعُكَ."},
{"at":316.75,"end":329.62,"text":"أَحْمَدُكَ لِأَنَّكَ ٱسْتَجَبْتَ لِي وَصِرْتَ لِي خَلَاصًا."},
{"at":329.62,"end":339.45,"text":"ٱحْمَدُوا ٱلرَّبَّ لِأَنَّهُ صَالِحٌ،"},
{"at":339.45,"end":347.67,"text":"لِأَنَّ إِلَى ٱلْأَبَدِ رَحْمَتَهُ."},
{"at":347.67,"end":351.9,"text":"هَلِّلُويَا."}
