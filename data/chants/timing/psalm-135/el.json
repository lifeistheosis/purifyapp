{"v":1,"durationSec":504.53,"lines":[
{"at":0.27,"end":5.2,"text":"Ἐξομολογεῖσθε τῷ Κυρίῳ, ὅτι ἀγαθὸς,"},
{"at":5.2,"end":7.69,"text":"Ἀλληλούϊα."},
{"at":7.69,"end":15.36,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":15.36,"end":18.82,"text":"Ἀλληλούϊα."},
{"at":18.82,"end":23.12,"text":"Ἐξομολογεῖσθε τῷ Θεῷ τῶν θεῶν,"},
{"at":23.12,"end":25.59,"text":"Ἀλληλούϊα."},
{"at":25.59,"end":33.2,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":33.2,"end":36.67,"text":"Ἀλληλούϊα."},
{"at":36.67,"end":40.92,"text":"Ἐξομολογεῖσθε τῷ Κυρίῳ τῶν κυρίων,"},
{"at":40.92,"end":43.37,"text":"Ἀλληλούϊα."},
{"at":43.37,"end":51,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":51,"end":54.53,"text":"Ἀλληλούϊα."},
{"at":54.53,"end":59.41,"text":"Τῷ ποιήσαντι θαυμάσια μεγάλα μόνῳ,"},
{"at":59.41,"end":62.03,"text":"Ἀλληλούϊα."},
{"at":62.03,"end":69.68,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":69.68,"end":73.32,"text":"Ἀλληλούϊα."},
{"at":73.32,"end":77.6,"text":"Τῷ ποιήσαντι τοὺς οὐρανοὺς ἐν συνέσει,"},
{"at":77.6,"end":80.06,"text":"Ἀλληλούϊα."},
{"at":80.06,"end":87.72,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":87.72,"end":91.62,"text":"Ἀλληλούϊα."},
{"at":91.62,"end":96.64,"text":"Τῷ στερεώσαντι τὴν γῆν ἐπὶ τῶν ὑδάτων,"},
{"at":96.64,"end":99.08,"text":"Ἀλληλούϊα."},
{"at":99.08,"end":106.88,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":106.88,"end":110.47,"text":"Ἀλληλούϊα."},
{"at":110.47,"end":114.76,"text":"Τῷ ποιήσαντι φῶτα μεγάλα μόνῳ,"},
{"at":114.76,"end":117.27,"text":"Ἀλληλούϊα."},
{"at":117.27,"end":125.16,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":125.16,"end":128.65,"text":"Ἀλληλούϊα."},
{"at":128.65,"end":132.68,"text":"Τὸν ἥλιον εἰς ἐξουσίαν τῆς ἡμέρας,"},
{"at":132.68,"end":135.12,"text":"Ἀλληλούϊα."},
{"at":135.12,"end":142.84,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ·"},
{"at":142.84,"end":146.5,"text":"Ἀλληλούϊα."},
{"at":146.5,"end":152.68,"text":"Τὴν σελήνην καὶ τοὺς ἀστέρας εἰς ἐξουσίαν τῆς νυκτός,"},
{"at":152.68,"end":155.84,"text":"Ἀλληλούϊα."},
{"at":155.84,"end":162.32,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":162.32,"end":165.82,"text":"Ἀλληλούϊα."},
{"at":165.82,"end":171.92,"text":"Τῷ πατάξαντι Αἴγυπτον σὺν τοῖς πρωτοτόκοις αὐτῶν,"},
{"at":171.92,"end":175.11,"text":"Ἀλληλούϊα."},
{"at":175.11,"end":181.64,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":181.64,"end":185.33,"text":"Ἀλληλούϊα."},
{"at":185.33,"end":190.96,"text":"Καὶ ἐξαγαγόντι τὸν Ἰσραὴλ ἐκ μέσου αὐτῶν,"},
{"at":190.96,"end":194.18,"text":"Ἀλληλούϊα."},
{"at":194.18,"end":201.08,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ·"},
{"at":201.08,"end":204.51,"text":"Ἀλληλούϊα."},
{"at":204.51,"end":210.36,"text":"Ἐν χειρὶ κραταιᾷ καὶ ἐν βραχίονι ὑψηλῷ,"},
{"at":210.36,"end":213.42,"text":"Ἀλληλούϊα."},
{"at":213.42,"end":220.16,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":220.16,"end":224.05,"text":"Ἀλληλούϊα."},
{"at":224.05,"end":232.4,"text":"Τῷ καταδιελόντι τὴν ἐρυθρὰν θάλασσαν εἰς διαιρέσεις,"},
{"at":232.4,"end":235.53,"text":"Ἀλληλούϊα."},
{"at":235.53,"end":243.2,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ·"},
{"at":243.2,"end":246.92,"text":"Ἀλληλούϊα."},
{"at":246.92,"end":254.48,"text":"Καὶ διαγαγόντι τὸν Ἰσραὴλ διὰ μέσου αὐτῆς,"},
{"at":254.48,"end":257.54,"text":"Ἀλληλούϊα."},
{"at":257.54,"end":265.24,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ·"},
{"at":265.24,"end":268.8,"text":"Ἀλληλούϊα."},
{"at":268.8,"end":278.2,"text":"Καὶ ἐκτινάξαντι Φαραὼ καὶ τὴν δύναμιν αὐτοῦ εἰς θάλασσαν ἐρυθράν,"},
{"at":278.2,"end":281.21,"text":"Ἀλληλούϊα."},
{"at":281.21,"end":288.8,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":288.8,"end":292.28,"text":"Ἀλληλούϊα."},
{"at":292.28,"end":299.08,"text":"Τῷ διαγαγόντι τὸν λαὸν αὐτοῦ ἐν τῇ ἐρήμῳ,"},
{"at":299.08,"end":301.62,"text":"Ἀλληλούϊα."},
{"at":301.62,"end":309.56,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":309.56,"end":313.1,"text":"Ἀλληλούϊα."},
{"at":313.1,"end":318.64,"text":"Τῷ πατάξαντι βασιλεῖς μεγάλους,"},
{"at":318.64,"end":321.61,"text":"Ἀλληλούϊα."},
{"at":321.61,"end":329.28,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":329.28,"end":332.95,"text":"Ἀλληλούϊα."},
{"at":332.95,"end":338.84,"text":"Καὶ ἀποκτείναντι βασιλεῖς κραταιούς,"},
{"at":338.84,"end":341.88,"text":"Ἀλληλούϊα."},
{"at":341.88,"end":349.56,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":349.56,"end":353.39,"text":"Ἀλληλούϊα."},
{"at":353.39,"end":357.84,"text":"Τὸν Σηὼν βασιλέα τῶν Ἀμοῤῥαίων,"},
{"at":357.84,"end":360.99,"text":"Ἀλληλούϊα."},
{"at":360.99,"end":368.8,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":368.8,"end":372.48,"text":"Ἀλληλούϊα."},
{"at":372.48,"end":376.82,"text":"Καὶ τὸν Ὢγ βασιλέα τῆς Βασάν,"},
{"at":376.82,"end":379.45,"text":"Ἀλληλούϊα."},
{"at":379.45,"end":387.16,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":387.16,"end":391.14,"text":"Ἀλληλούϊα."},
{"at":391.14,"end":395.2,"text":"Καὶ δόντι τὴν γῆν αὐτῶν κληρονομίαν,"},
{"at":395.2,"end":398.27,"text":"Ἀλληλούϊα."},
{"at":398.27,"end":404.72,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ·"},
{"at":404.72,"end":408.38,"text":"Ἀλληλούϊα."},
{"at":408.38,"end":412.11,"text":"κληρονομίαν Ἰσραὴλ δούλῳ αὐτοῦ,"},
{"at":412.11,"end":415.95,"text":"Ἀλληλούϊα."},
{"at":415.95,"end":422.44,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":422.44,"end":425.9,"text":"Ἀλληλούϊα."},
{"at":425.9,"end":433.24,"text":"Ὅτι ἐν τῇ ταπεινώσει ἡμῶν ἐμνήσθη ἡμῶν ὁ Κύριος,"},
{"at":433.24,"end":436.39,"text":"Ἀλληλούϊα."},
{"at":436.39,"end":442.84,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":442.84,"end":446.39,"text":"Ἀλληλούϊα."},
{"at":446.39,"end":450.82,"text":"Καὶ ἐλυτρώσατο ἡμᾶς ἐκ τῶν ἐχθρῶν ἡμῶν,"},
{"at":450.82,"end":454.05,"text":"Ἀλληλούϊα."},
{"at":454.05,"end":460.52,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":460.52,"end":464.07,"text":"Ἀλληλούϊα."},
{"at":464.07,"end":468.4,"text":"Ὁ διδοὺς τροφὴν πάσῃ σαρκὶ,"},
{"at":468.4,"end":470.77,"text":"Ἀλληλούϊα."},
{"at":470.77,"end":477.08,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":477.08,"end":480.47,"text":"Ἀλληλούϊα."},
{"at":480.47,"end":489.02,"text":"Ἐξομολογεῖσθε τῷ Θεῷ τοῦ οὐρανοῦ,"},
{"at":489.02,"end":492.04,"text":"Ἀλληλούϊα."},
{"at":492.04,"end":497.44,"text":"ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."},
{"at":497.44,"end":502.28,"text":"Ἀλληλούϊα."}
]}
