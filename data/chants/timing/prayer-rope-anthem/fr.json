{"at":22.77,"end":27.61,"text":"Très sainte Trinité, sauve-nous par votre grâce.","words":[[22.78,23.21],[23.21,23.81],[23.81,25.17],[25.17,26.41],[26.41,26.67],[26.67,27.51],[27.51,27.61]],"unheard":[0,1]},
{"at":27.61,"end":33.47,"text":"Plus je récite la prière, plus l'ennemi perdra la guerre.","words":[[27.61,28.47],[28.47,28.79],[28.79,29.41],[29.41,29.75],[29.75,30.73],[30.73,30.93],[30.93,31.57],[31.57,32.25],[32.25,32.69],[32.69,33.47]]},
{"at":33.47,"end":40.09,"text":"Je vais la réciter à nouveau à haute voix, la deuxième prière.","words":[[33.47,34.15],[34.15,34.45],[34.45,34.71],[34.71,35.53],[35.53,35.97],[35.97,36.55],[36.55,36.85],[36.85,37.31],[37.31,37.71],[37.71,38.19],[38.19,38.85],[38.85,40.09]],"unheard":[9]},
