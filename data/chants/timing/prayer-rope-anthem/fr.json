{"at":62.65,"end":68.71,"text":"Plus je récite cette prière, plus l'ennemi perdra la guerre.","words":[[62.65,63.03],[63.03,63.37],[63.37,64.01],[64.01,64.47],[64.47,65.63],[65.63,65.83],[65.83,66.51],[66.51,67.21],[67.21,67.75],[67.75,68.71]]},
