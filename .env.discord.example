# Discord scan helper credentials. Copy to .env.discord (gitignored) and
# fill in real values. See scripts/discord-scan.SETUP.md for setup.

# Bot token (Developer Portal → Bot tab → Reset Token).
DISCORD_BOT_TOKEN=

# Server (guild) ID. Right-click the server icon → Copy Server ID. With
# this set, the script auto-discovers every text channel and forum, and
# you can scan by the real channel name. Recommended.
DISCORD_GUILD_ID=

# Optional friendly-name shortcuts. Only needed if you want a stable alias
# (e.g. "suggestions") that won't break if the channel is ever renamed.
# DISCORD_CHANNEL_SUGGESTIONS=
# DISCORD_CHANNEL_FORUM=
