# Discord scan helper credentials. Copy to .env.discord (gitignored) and
# fill in real values. See scripts/discord-scan.mjs for usage.
#
# 1. Create a Discord application + bot at https://discord.com/developers/applications
# 2. Bot tab → Reset Token → paste here
# 3. OAuth2 → URL Generator → "bot" scope + "View Channels" + "Read Message History"
#    → open the generated URL and invite the bot to the Purify Discord
# 4. Enable Developer Mode in Discord (User Settings → Advanced → Developer Mode)
# 5. Right-click each channel you want to scan → Copy Channel ID → paste below

DISCORD_BOT_TOKEN=

# Friendly-name → channel-ID map. Add or remove rows freely; the scan helper
# reads any DISCORD_CHANNEL_* var and exposes the suffix as the friendly name.
# Example: DISCORD_CHANNEL_SUGGESTIONS=123456789012345678
DISCORD_CHANNEL_SUGGESTIONS=
DISCORD_CHANNEL_FORUM=
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_BUGS=
