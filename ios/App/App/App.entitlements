<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs. "development" talks to sandbox APNs for dev/TestFlight-internal
	     builds; Xcode's App Store distribution flow rewrites this to
	     "production" automatically at archive/export time. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple. Required by App Store review guideline 4.8 because
	     the app offers Google sign-in; see components/auth/OAuthButtons.tsx.
	     With automatic signing and -allowProvisioningUpdates, xcodebuild enables
	     the capability on the App ID and regenerates the profile from this file,
	     so adding the key here is the whole change on the build side. The
	     Services ID, key, and Supabase provider config are dashboard work. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- The App Group the home screen widgets share with the app: the
	     WidgetBridge plugin writes what only the app knows into its
	     UserDefaults, and the extension (ios/App/PurifyWidgets) reads it.
	     The App ID must have this group ticked on developer.apple.com, or
	     the profile the workflow mints cannot sign it; see
	     docs/IOS_BUILD_SETUP.md, "Home screen widgets". -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.net.purifyapp.purify</string>
	</array>
</dict>
</plist>
