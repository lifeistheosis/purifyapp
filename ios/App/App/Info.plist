<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Purify</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Google Sign-In's iOS callback. The value is the REVERSED client id
	     (com.googleusercontent.apps.NNNN-xxxx) and is injected as a build
	     setting by .github/workflows/ios-release.yml, which fails the build
	     when the secret is missing rather than shipping an empty scheme.
	     Xcode expands $(VAR) in Info.plist the same way it does for
	     $(MARKETING_VERSION) above. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>net.purifyapp.purify.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<!-- Pre-answers the export-compliance question so TestFlight builds are
	     not held on every upload. @capacitor-community/sqlite links SQLCipher,
	     but lib/content/storage/capacitorStore.ts opens every database with
	     "no-encryption", so the app uses no non-exempt encryption. Revisit
	     this if the content store is ever opened with a passphrase. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Load-bearing, not paperwork. CommunityClient and CreateCampaignClient
	     both render an image file input, and both ship in the export;
	     WKWebView's picker offers "Take Photo", and iOS terminates the app
	     the instant it reaches the camera with no purpose string. -->
	<key>NSCameraUsageDescription</key>
	<string>Purify uses the camera so you can take a photo to attach to a prayer campaign or a post.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Purify uses your photo library so you can attach an existing photo to a prayer campaign or a post.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Purify saves an image to your photo library when you choose to save one you have shared.</string>
	<!-- The app icon's shortcuts: touch and hold the icon on the Home Screen
	     and iOS offers these three, in this order. All a shortcut carries is
	     an address, and here the type IS the address: AppDelegate hands it to
	     Capacitor as an opened URL, and lib/shortcuts/shortcuts.ts turns it
	     into a screen once the app is up. The scheme is not registered under
	     CFBundleURLTypes above and must not be: nothing outside the app has
	     any business sending one. The same three addresses are in
	     android/app/src/main/res/xml/shortcuts.xml, and
	     lib/shortcuts/__tests__/shortcuts.test.ts holds both files to the
	     list. The icons are SF Symbols, which iOS draws in its own label
	     colour; there is no artwork of ours for these yet. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>net.purifyapp.purify://shortcut/morning-prayers</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Morning prayers</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>sunrise</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>net.purifyapp.purify://shortcut/todays-reading</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Today's reading</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>book</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>net.purifyapp.purify://shortcut/continue-reading</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Continue reading</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>bookmark</string>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- No UIRequiresFullScreen: iPad runs in Split View, Slide Over and Stage
	     Manager windows. It was set until the narrow widths had been walked;
	     they were on 2026-09-25 (320, 375, 507 and 678px across Today, Bible,
	     Prayers, Saints, Calendar and Discover: no sideways scroll, tab bar
	     present, labels whole) and tests/smoke/tablet-shell.spec.ts now holds
	     them. Apple deprecated the key in iPadOS 26, which is the other reason
	     not to put it back. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
