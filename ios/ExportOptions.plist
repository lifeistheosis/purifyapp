<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Options for `xcodebuild -exportArchive` in .github/workflows/ios-release.yml.

  teamID is filled in by the workflow from the APPLE_TEAM_ID secret before this
  file is used, replacing the placeholder below. Build-setting overrides passed
  on the xcodebuild command line do NOT reach -exportArchive, which reads the
  team from here, so the value has to arrive by one route or the other.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>__APPLE_TEAM_ID__</string>

	<!-- Automatic signing, paired with -allowProvisioningUpdates on both the
	     archive and the export. The app's capabilities are about to change
	     twice (push, then Sign in with Apple), and a manually managed
	     .mobileprovision would have to be regenerated by hand each time, from a
	     Mac nobody here has. Letting Xcode maintain the profile is the whole
	     reason this pipeline can run without one. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- dSYMs to App Store Connect, so a crash report from a TestFlight build
	     symbolicates instead of arriving as hex addresses. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Export to disk; the upload is a separate, explicit altool step, so a
	     failed upload can be retried without rebuilding the archive. -->
	<key>destination</key>
	<string>export</string>

	<!-- Load-bearing. Xcode 15+ will otherwise silently rewrite CFBundleVersion
	     at export time, which desyncs the build number from the one the
	     workflow set and from the iosBuildNumber later declared in
	     lib/appUpdate/release.ts. The update prompt compares those numbers, so
	     letting Xcode pick its own would make the prompt lie. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
